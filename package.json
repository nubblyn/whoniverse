{
  "name": "whoniverse-addon",
  "version": "2.2.0",
  "description": "Doctor Who in original UK broadcast order, as an addon for Stremio and Nuvio.",
  "main": "api/index.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/stamp.js",
    "check-links": "node scripts/check-links.js",
    "stamp:media": "node scripts/stamp-media.js",
    "map": "node scripts/map-imdb.js --write",
    "art": "node scripts/build-art.js",
    "art:upload": "node scripts/run.js upload-art"
  },
  "dependencies": {
    "stremio-addon-sdk": "^1.6.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "doctor-who",
    "metadata",
    "catalog",
    "nuvio",
    "torchwood"
  ],
  "author": "nubblyn",
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
