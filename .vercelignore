# A CLI deploy uploads the working directory, not the commit, so everything
# that is not read at request time stays behind. The publishing tools run on
# this machine; stamp.js is the one script the Vercel build runs.
scripts/*
!scripts/stamp.js
ledger/
docs/
art-src/
art-cdn/
server.js

# Never upload credentials or local state.
.env*
.git/
node_modules/
