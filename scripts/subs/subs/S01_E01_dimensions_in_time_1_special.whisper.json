[{"start": 8.59, "end": 11.73, "text": "Pickled in time, like gherkins in a jar.", "words": [{"w": " Pickled", "s": 8.59, "e": 9.15}, {"w": " in", "s": 9.15, "e": 9.31}, {"w": " time,", "s": 9.31, "e": 9.75}, {"w": " like", "s": 9.99, "e": 10.35}, {"w": " gherkins", "s": 10.35, "e": 10.99}, {"w": " in", "s": 10.99, "e": 11.23}, {"w": " a", "s": 11.23, "e": 11.35}, {"w": " jar.", "s": 11.35, "e": 11.73}]}, {"start": 12.07, "end": 14.83, "text": "Mistress Rani, the Time Tunnel is ready to receive its first guests.", "words": [{"w": " Mistress", "s": 12.07, "e": 12.35}, {"w": " Rani,", "s": 12.35, "e": 12.67}, {"w": " the", "s": 12.73, "e": 12.81}, {"w": " Time", "s": 12.81, "e": 13.07}, {"w": " Tunnel", "s": 13.07, "e": 13.39}, {"w": " is", "s": 13.39, "e": 13.47}, {"w": " ready", "s": 13.47, "e": 13.65}, {"w": " to", "s": 13.65, "e": 13.81}, {"w": " receive", "s": 13.81, "e": 14.07}, {"w": " its", "s": 14.07, "e": 14.25}, {"w": " first", "s": 14.25, "e": 14.45}, {"w": " guests.", "s": 14.45, "e": 14.83}]}, {"start": 15.13, "end": 15.69, "text": "Proceed.", "words": [{"w": " Proceed.", "s": 15.13, "e": 15.69}]}, {"start": 17.03, "end": 20.97, "text": "Fated to wander a dismal corner of the universe for twenty years.", "words": [{"w": " Fated", "s": 17.03, "e": 17.59}, {"w": " to", "s": 17.59, "e": 17.77}, {"w": " wander", "s": 17.77, "e": 18.05}, {"w": " a", "s": 18.05, "e": 18.37}, {"w": " dismal", "s": 18.37, "e": 18.83}, {"w": " corner", "s": 18.83, "e": 19.19}, {"w": " of", "s": 19.19, "e": 19.39}, {"w": " the", "s": 19.39, "e": 19.43}, {"w": " universe", "s": 19.43, "e": 19.87}, {"w": " for", "s": 19.87, "e": 20.15}, {"w": " twenty", "s": 20.15, "e": 20.49}, {"w": " years.", "s": 20.49, "e": 20.97}]}, {"start": 21.85, "end": 24.07, "text": "Helpless. Paralyzed.", "words": [{"w": " Helpless.", "s": 21.85, "e": 22.41}, {"w": " Paralyzed.", "s": 23.51, "e": 24.07}]}, {"start": 24.63, "end": 26.21, "text": "It'll drive them insane.", "words": [{"w": " It'll", "s": 24.63, "e": 25.19}, {"w": " drive", "s": 25.19, "e": 25.57}, {"w": " them", "s": 25.57, "e": 25.79}, {"w": " insane.", "s": 25.79, "e": 26.21}]}, {"start": 29.17, "end": 66.54, "text": "It's for all of the Doctors, it's vitally important that you listen carefully to me.", "words": [{"w": " It's", "s": 29.17, "e": 29.73}, {"w": " for", "s": 63.4, "e": 63.5}, {"w": " all", "s": 63.5, "e": 63.76}, {"w": " of", "s": 63.76, "e": 63.88}, {"w": " the", "s": 63.88, "e": 64.0}, {"w": " Doctors,", "s": 64.0, "e": 64.3}, {"w": " it's", "s": 64.4, "e": 64.58}, {"w": " vitally", "s": 64.58, "e": 64.92}, {"w": " important", "s": 64.92, "e": 65.24}, {"w": " that", "s": 65.24, "e": 65.52}, {"w": " you", "s": 65.52, "e": 65.62}, {"w": " listen", "s": 65.62, "e": 65.82}, {"w": " carefully", "s": 65.82, "e": 66.22}, {"w": " to", "s": 66.22, "e": 66.42}, {"w": " me.", "s": 66.42, "e": 66.54}]}, {"start": 66.62, "end": 70.76, "text": "For once, our whole existence is being threatened by a renegade Time Lord", "words": [{"w": " For", "s": 66.62, "e": 67.0}, {"w": " once,", "s": 67.0, "e": 67.34}, {"w": " our", "s": 67.48, "e": 68.14}, {"w": " whole", "s": 68.14, "e": 68.36}, {"w": " existence", "s": 68.36, "e": 68.74}, {"w": " is", "s": 68.74, "e": 68.98}, {"w": " being", "s": 68.98, "e": 69.16}, {"w": " threatened", "s": 69.16, "e": 69.4}, {"w": " by", "s": 69.4, "e": 69.62}, {"w": " a", "s": 69.62, "e": 69.74}, {"w": " renegade", "s": 69.74, "e": 70.22}, {"w": " Time", "s": 70.22, "e": 70.42}, {"w": " Lord", "s": 70.42, "e": 70.76}]}, {"start": 70.76, "end": 72.28, "text": "known only as the Rani.", "words": [{"w": " known", "s": 70.76, "e": 70.96}, {"w": " only", "s": 70.96, "e": 71.4}, {"w": " as", "s": 71.4, "e": 71.72}, {"w": " the", "s": 71.72, "e": 71.88}, {"w": " Rani.", "s": 71.88, "e": 72.28}]}, {"start": 73.74, "end": 76.5, "text": "She hates me. She even hates children.", "words": [{"w": " She", "s": 73.74, "e": 74.18}, {"w": " hates", "s": 74.18, "e": 74.52}, {"w": " me.", "s": 74.52, "e": 74.74}, {"w": " She", "s": 74.98, "e": 75.42}, {"w": " even", "s": 75.42, "e": 75.72}, {"w": " hates", "s": 75.72, "e": 76.08}, {"w": " children.", "s": 76.08, "e": 76.5}]}, {"start": 77.24, "end": 80.48, "text": "Two of my earlier selves have already been snared in her vicious trap.", "words": [{"w": " Two", "s": 77.24, "e": 77.68}, {"w": " of", "s": 77.68, "e": 77.86}, {"w": " my", "s": 77.86, "e": 78.0}, {"w": " earlier", "s": 78.0, "e": 78.32}, {"w": " selves", "s": 78.32, "e": 78.68}, {"w": " have", "s": 78.68, "e": 78.9}, {"w": " already", "s": 78.9, "e": 79.12}, {"w": " been", "s": 79.12, "e": 79.34}, {"w": " snared", "s": 79.34, "e": 79.68}, {"w": " in", "s": 79.68, "e": 79.82}, {"w": " her", "s": 79.82, "e": 79.92}, {"w": " vicious", "s": 79.92, "e": 80.12}, {"w": " trap.", "s": 80.12, "e": 80.48}]}, {"start": 80.96, "end": 83.26, "text": "The grumpy one and the flautist, do you remember them?", "words": [{"w": " The", "s": 80.96, "e": 81.4}, {"w": " grumpy", "s": 81.4, "e": 81.7}, {"w": " one", "s": 81.7, "e": 81.92}, {"w": " and", "s": 81.92, "e": 82.12}, {"w": " the", "s": 82.12, "e": 82.2}, {"w": " flautist,", "s": 82.2, "e": 82.6}, {"w": " do", "s": 82.68, "e": 82.8}, {"w": " you", "s": 82.8, "e": 82.84}, {"w": " remember", "s": 82.84, "e": 83.02}, {"w": " them?", "s": 83.02, "e": 83.26}]}, {"start": 84.1, "end": 85.78, "text": "She wants to put us out of action.", "words": [{"w": " She", "s": 84.1, "e": 84.54}, {"w": " wants", "s": 84.54, "e": 84.78}, {"w": " to", "s": 84.78, "e": 84.92}, {"w": " put", "s": 84.92, "e": 85.1}, {"w": " us", "s": 85.1, "e": 85.26}, {"w": " out", "s": 85.26, "e": 85.38}, {"w": " of", "s": 85.38, "e": 85.52}, {"w": " action.", "s": 85.52, "e": 85.78}]}, {"start": 85.92, "end": 90.18, "text": "Lock us away in a dreary backwater of London's East End, trapped in a time loop in perpetuity.", "words": [{"w": " Lock", "s": 85.92, "e": 86.18}, {"w": " us", "s": 86.18, "e": 86.32}, {"w": " away", "s": 86.32, "e": 86.52}, {"w": " in", "s": 86.52, "e": 86.66}, {"w": " a", "s": 86.66, "e": 86.68}, {"w": " dreary", "s": 86.68, "e": 86.92}, {"w": " backwater", "s": 86.92, "e": 87.36}, {"w": " of", "s": 87.36, "e": 87.58}, {"w": " London's", "s": 87.58, "e": 87.88}, {"w": " East", "s": 87.88, "e": 88.06}, {"w": " End,", "s": 88.06, "e": 88.38}, {"w": " trapped", "s": 88.44, "e": 88.68}, {"w": " in", "s": 88.68, "e": 88.9}, {"w": " a", "s": 88.9, "e": 88.98}, {"w": " time", "s": 88.98, "e": 89.26}, {"w": " loop", "s": 89.26, "e": 89.44}, {"w": " in", "s": 89.44, "e": 89.58}, {"w": " perpetuity.", "s": 89.58, "e": 90.18}]}, {"start": 90.26, "end": 91.76, "text": "Her evil is all around us.", "words": [{"w": " Her", "s": 90.26, "e": 90.56}, {"w": " evil", "s": 90.56, "e": 90.9}, {"w": " is", "s": 90.9, "e": 91.02}, {"w": " all", "s": 91.02, "e": 91.2}, {"w": " around", "s": 91.2, "e": 91.5}, {"w": " us.", "s": 91.5, "e": 91.76}]}, {"start": 93.02, "end": 102.44, "text": "I can hear the heart beat of her before she destroys all of my other selves.", "words": [{"w": " I", "s": 93.02, "e": 93.46}, {"w": " can", "s": 93.46, "e": 93.64}, {"w": " hear", "s": 93.64, "e": 93.96}, {"w": " the", "s": 93.96, "e": 94.2}, {"w": " heart", "s": 94.2, "e": 94.5}, {"w": " beat", "s": 94.5, "e": 94.8}, {"w": " of", "s": 94.8, "e": 95.3}, {"w": " her", "s": 95.3, "e": 95.46}, {"w": " before", "s": 100.38, "e": 100.68}, {"w": " she", "s": 100.68, "e": 100.96}, {"w": " destroys", "s": 100.96, "e": 101.36}, {"w": " all", "s": 101.36, "e": 101.62}, {"w": " of", "s": 101.62, "e": 101.74}, {"w": " my", "s": 101.74, "e": 101.88}, {"w": " other", "s": 101.88, "e": 102.06}, {"w": " selves.", "s": 102.06, "e": 102.44}]}, {"start": 114.34, "end": 114.78, "text": "Cyberman.", "words": [{"w": " Cyberman.", "s": 114.34, "e": 114.78}]}, {"start": 114.78, "end": 117.46, "text": "We have a Time Lord from Gallifrey.", "words": [{"w": " We", "s": 114.78, "e": 114.92}, {"w": " have", "s": 114.92, "e": 114.94}, {"w": " a", "s": 114.94, "e": 116.0}, {"w": " Time", "s": 116.0, "e": 116.24}, {"w": " Lord", "s": 116.24, "e": 116.56}, {"w": " from", "s": 116.56, "e": 116.84}, {"w": " Gallifrey.", "s": 116.84, "e": 117.46}]}, {"start": 117.66, "end": 120.68, "text": "Just one more specimen needed. An Earthling.", "words": [{"w": " Just", "s": 117.66, "e": 118.0}, {"w": " one", "s": 118.0, "e": 118.24}, {"w": " more", "s": 118.24, "e": 118.5}, {"w": " specimen", "s": 118.5, "e": 118.92}, {"w": " needed.", "s": 118.92, "e": 119.32}, {"w": " An", "s": 119.66, "e": 120.18}, {"w": " Earthling.", "s": 120.18, "e": 120.68}]}, {"start": 121.48, "end": 123.18, "text": "The menagerie is almost complete.", "words": [{"w": " The", "s": 121.48, "e": 122.0}, {"w": " menagerie", "s": 122.0, "e": 122.46}, {"w": " is", "s": 122.46, "e": 122.56}, {"w": " almost", "s": 122.56, "e": 122.74}, {"w": " complete.", "s": 122.74, "e": 123.18}]}, {"start": 123.94, "end": 126.02, "text": "Time is literally of the essence.", "words": [{"w": " Time", "s": 123.94, "e": 124.46}, {"w": " is", "s": 124.46, "e": 124.82}, {"w": " literally", "s": 124.82, "e": 125.18}, {"w": " of", "s": 125.18, "e": 125.54}, {"w": " the", "s": 125.54, "e": 125.72}, {"w": " essence.", "s": 125.72, "e": 126.02}]}, {"start": 127.2, "end": 130.88, "text": "The Doctors' remaining incarnations are teetering on the edge of a precipice.", "words": [{"w": " The", "s": 127.2, "e": 127.72}, {"w": " Doctors'", "s": 127.72, "e": 128.04}, {"w": " remaining", "s": 128.12, "e": 128.3}, {"w": " incarnations", "s": 128.3, "e": 129.18}, {"w": " are", "s": 129.18, "e": 129.34}, {"w": " teetering", "s": 129.34, "e": 129.8}, {"w": " on", "s": 129.8, "e": 129.94}, {"w": " the", "s": 129.94, "e": 130.04}, {"w": " edge", "s": 130.04, "e": 130.18}, {"w": " of", "s": 130.18, "e": 130.3}, {"w": " a", "s": 130.3, "e": 130.38}, {"w": " precipice.", "s": 130.38, "e": 130.88}]}, {"start": 130.96, "end": 133.64, "text": "You're obsessed. Don't forget what we've come here for.", "words": [{"w": " You're", "s": 130.96, "e": 131.06}, {"w": " obsessed.", "s": 131.06, "e": 131.42}, {"w": " Don't", "s": 132.04, "e": 132.56}, {"w": " forget", "s": 132.56, "e": 132.78}, {"w": " what", "s": 132.78, "e": 132.94}, {"w": " we've", "s": 132.94, "e": 133.08}, {"w": " come", "s": 133.08, "e": 133.26}, {"w": " here", "s": 133.26, "e": 133.42}, {"w": " for.", "s": 133.42, "e": 133.64}]}, {"start": 134.44, "end": 137.44, "text": "Earthlings pose no threat to my technology, imbecile.", "words": [{"w": " Earthlings", "s": 134.44, "e": 134.96}, {"w": " pose", "s": 134.96, "e": 135.24}, {"w": " no", "s": 135.24, "e": 135.54}, {"w": " threat", "s": 135.54, "e": 135.8}, {"w": " to", "s": 135.8, "e": 136.02}, {"w": " my", "s": 136.02, "e": 136.18}, {"w": " technology,", "s": 136.18, "e": 136.7}, {"w": " imbecile.", "s": 136.96, "e": 137.44}]}, {"start": 137.72, "end": 139.42, "text": "It's the Doctor I want out of the way.", "words": [{"w": " It's", "s": 137.72, "e": 138.2}, {"w": " the", "s": 138.2, "e": 138.26}, {"w": " Doctor", "s": 138.26, "e": 138.54}, {"w": " I", "s": 138.54, "e": 138.74}, {"w": " want", "s": 138.74, "e": 138.88}, {"w": " out", "s": 138.88, "e": 139.04}, {"w": " of", "s": 139.04, "e": 139.16}, {"w": " the", "s": 139.16, "e": 139.2}, {"w": " way.", "s": 139.2, "e": 139.42}]}, {"start": 140.46, "end": 142.54, "text": "Interception in five seconds, Rani.", "words": [{"w": " Interception", "s": 140.46, "e": 140.98}, {"w": " in", "s": 140.98, "e": 141.18}, {"w": " five", "s": 141.18, "e": 141.58}, {"w": " seconds,", "s": 141.58, "e": 142.12}, {"w": " Rani.", "s": 142.28, "e": 142.54}]}, {"start": 143.0, "end": 144.9, "text": "Although I will miss the challenge.", "words": [{"w": " Although", "s": 143.0, "e": 143.44}, {"w": " I", "s": 143.44, "e": 143.66}, {"w": " will", "s": 143.66, "e": 143.96}, {"w": " miss", "s": 143.96, "e": 144.28}, {"w": " the", "s": 144.28, "e": 144.5}, {"w": " challenge.", "s": 144.5, "e": 144.9}]}, {"start": 146.1, "end": 148.14, "text": "Three, two, one.", "words": [{"w": " Three,", "s": 146.1, "e": 146.54}, {"w": " two,", "s": 146.54, "e": 146.98}, {"w": " one.", "s": 147.2, "e": 148.14}]}, {"start": 148.92, "end": 149.36, "text": "Activate!", "words": [{"w": " Activate!", "s": 148.92, "e": 149.36}]}, {"start": 156.55, "end": 159.09, "text": "Oh, to be in China now that November's here.", "words": [{"w": " Oh,", "s": 156.55, "e": 156.99}, {"w": " to", "s": 157.05, "e": 157.21}, {"w": " be", "s": 157.21, "e": 157.31}, {"w": " in", "s": 157.31, "e": 157.45}, {"w": " China", "s": 157.45, "e": 157.87}, {"w": " now", "s": 157.87, "e": 158.19}, {"w": " that", "s": 158.19, "e": 158.41}, {"w": " November's", "s": 158.41, "e": 158.89}, {"w": " here.", "s": 158.89, "e": 159.09}]}, {"start": 159.41, "end": 162.23, "text": "When was the last time you had that junk heap in for an M.O.T. professor?", "words": [{"w": " When", "s": 159.41, "e": 159.69}, {"w": " was", "s": 159.69, "e": 159.87}, {"w": " the", "s": 159.87, "e": 159.97}, {"w": " last", "s": 159.97, "e": 160.15}, {"w": " time", "s": 160.15, "e": 160.37}, {"w": " you", "s": 160.37, "e": 160.47}, {"w": " had", "s": 160.47, "e": 160.57}, {"w": " that", "s": 160.57, "e": 160.71}, {"w": " junk", "s": 160.71, "e": 160.95}, {"w": " heap", "s": 160.95, "e": 161.15}, {"w": " in", "s": 161.15, "e": 161.33}, {"w": " for", "s": 161.33, "e": 161.49}, {"w": " an", "s": 161.49, "e": 161.57}, {"w": " M", "s": 161.57, "e": 161.69}, {"w": ".O", "s": 161.69, "e": 161.79}, {"w": ".T.", "s": 161.79, "e": 161.95}, {"w": " professor?", "s": 161.95, "e": 162.23}]}, {"start": 162.55, "end": 165.43, "text": "Don't be cynical, Ace. The instruments are just a little erratic, that's all.", "words": [{"w": " Don't", "s": 162.55, "e": 162.67}, {"w": " be", "s": 162.67, "e": 162.77}, {"w": " cynical,", "s": 162.77, "e": 163.19}, {"w": " Ace.", "s": 163.31, "e": 163.49}, {"w": " The", "s": 163.61, "e": 163.71}, {"w": " instruments", "s": 163.71, "e": 164.01}, {"w": " are", "s": 164.01, "e": 164.27}, {"w": " just", "s": 164.27, "e": 164.37}, {"w": " a", "s": 164.37, "e": 164.43}, {"w": " little", "s": 164.43, "e": 164.67}, {"w": " erratic,", "s": 164.67, "e": 165.07}, {"w": " that's", "s": 165.11, "e": 165.29}, {"w": " all.", "s": 165.29, "e": 165.43}]}, {"start": 165.59, "end": 168.47, "text": "Great Wall of China? Looks more like the Cutty Sark to me.", "words": [{"w": " Great", "s": 165.59, "e": 165.79}, {"w": " Wall", "s": 165.79, "e": 165.99}, {"w": " of", "s": 165.99, "e": 166.15}, {"w": " China?", "s": 166.15, "e": 166.47}, {"w": " Looks", "s": 166.75, "e": 167.17}, {"w": " more", "s": 167.17, "e": 167.31}, {"w": " like", "s": 167.31, "e": 167.49}, {"w": " the", "s": 167.49, "e": 167.59}, {"w": " Cutty", "s": 167.59, "e": 167.85}, {"w": " Sark", "s": 167.85, "e": 168.13}, {"w": " to", "s": 168.13, "e": 168.29}, {"w": " me.", "s": 168.29, "e": 168.47}]}, {"start": 168.83, "end": 170.43, "text": "Hmm. Another soul inside.", "words": [{"w": " Hmm.", "s": 168.83, "e": 168.91}, {"w": " Another", "s": 169.39, "e": 169.83}, {"w": " soul", "s": 169.83, "e": 170.13}, {"w": " inside.", "s": 170.13, "e": 170.43}]}, {"start": 175.29, "end": 178.73, "text": "1973? I didn't set the coordinates for 1973.", "words": [{"w": " 1973?", "s": 175.29, "e": 175.73}, {"w": " I", "s": 176.85, "e": 177.29}, {"w": " didn't", "s": 177.29, "e": 177.55}, {"w": " set", "s": 177.55, "e": 177.67}, {"w": " the", "s": 177.67, "e": 177.77}, {"w": " coordinates", "s": 177.77, "e": 178.11}, {"w": " for", "s": 178.11, "e": 178.29}, {"w": " 1973.", "s": 178.29, "e": 178.73}]}, {"start": 179.73, "end": 181.47, "text": "Oi! Is anybody there?", "words": [{"w": " Oi!", "s": 179.73, "e": 180.17}, {"w": " Is", "s": 180.39, "e": 180.75}, {"w": " anybody", "s": 180.75, "e": 180.99}, {"w": " there?", "s": 180.99, "e": 181.47}]}, {"start": 182.33, "end": 187.49, "text": "If I didn't know better, I could be convinced that someone has deliberately taken us off course.", "words": [{"w": " If", "s": 182.33, "e": 182.73}, {"w": " I", "s": 182.73, "e": 183.03}, {"w": " didn't", "s": 183.03, "e": 183.45}, {"w": " know", "s": 183.45, "e": 183.53}, {"w": " better,", "s": 183.53, "e": 183.93}, {"w": " I", "s": 183.95, "e": 184.05}, {"w": " could", "s": 184.05, "e": 184.19}, {"w": " be", "s": 184.19, "e": 184.29}, {"w": " convinced", "s": 184.29, "e": 184.73}, {"w": " that", "s": 184.73, "e": 185.27}, {"w": " someone", "s": 185.27, "e": 185.53}, {"w": " has", "s": 185.53, "e": 185.71}, {"w": " deliberately", "s": 185.71, "e": 186.09}, {"w": " taken", "s": 186.09, "e": 186.61}, {"w": " us", "s": 186.61, "e": 186.83}, {"w": " off", "s": 186.83, "e": 187.03}, {"w": " course.", "s": 187.03, "e": 187.49}]}, {"start": 188.77, "end": 189.73, "text": "Ace, what are you doing?", "words": [{"w": " Ace,", "s": 188.77, "e": 189.17}, {"w": " what", "s": 189.21, "e": 189.37}, {"w": " are", "s": 189.37, "e": 189.47}, {"w": " you", "s": 189.47, "e": 189.49}, {"w": " doing?", "s": 189.49, "e": 189.73}]}, {"start": 190.77, "end": 193.49, "text": "I'm not the Doctor.", "words": [{"w": " I'm", "s": 190.77, "e": 191.17}, {"w": " not", "s": 192.93, "e": 193.05}, {"w": " the", "s": 193.05, "e": 193.17}, {"w": " Doctor.", "s": 193.17, "e": 193.49}]}, {"start": 193.71, "end": 196.53, "text": "Yes, I am, Ace. We seem to have slipped a groove in time.", "words": [{"w": " Yes,", "s": 193.71, "e": 194.07}, {"w": " I", "s": 194.07, "e": 194.19}, {"w": " am,", "s": 194.19, "e": 194.41}, {"w": " Ace.", "s": 194.41, "e": 194.63}, {"w": " We", "s": 194.87, "e": 195.27}, {"w": " seem", "s": 195.27, "e": 195.39}, {"w": " to", "s": 195.39, "e": 195.47}, {"w": " have", "s": 195.47, "e": 195.55}, {"w": " slipped", "s": 195.55, "e": 195.69}, {"w": " a", "s": 195.69, "e": 195.85}, {"w": " groove", "s": 195.85, "e": 196.03}, {"w": " in", "s": 196.03, "e": 196.23}, {"w": " time.", "s": 196.23, "e": 196.53}]}, {"start": 196.71, "end": 197.81, "text": "Where'd all these people come from?", "words": [{"w": " Where'd", "s": 196.71, "e": 196.99}, {"w": " all", "s": 196.99, "e": 197.07}, {"w": " these", "s": 197.07, "e": 197.17}, {"w": " people", "s": 197.17, "e": 197.41}, {"w": " come", "s": 197.41, "e": 197.57}, {"w": " from?", "s": 197.57, "e": 197.81}]}, {"start": 198.49, "end": 199.87, "text": "And where are we?", "words": [{"w": " And", "s": 198.49, "e": 198.89}, {"w": " where", "s": 198.89, "e": 199.17}, {"w": " are", "s": 199.17, "e": 199.53}, {"w": " we?", "s": 199.53, "e": 199.87}]}, {"start": 203.24, "end": 205.22, "text": "Hey, Professor, look at this.", "words": [{"w": " Hey,", "s": 203.24, "e": 203.64}, {"w": " Professor,", "s": 204.48, "e": 204.64}, {"w": " look", "s": 204.86, "e": 204.96}, {"w": " at", "s": 204.96, "e": 205.08}, {"w": " this.", "s": 205.08, "e": 205.22}]}, {"start": 205.84, "end": 208.72, "text": "Right, Donna, special discount for you since it's nearly Christmas.", "words": [{"w": " Right,", "s": 205.84, "e": 206.24}, {"w": " Donna,", "s": 206.26, "e": 206.44}, {"w": " special", "s": 206.58, "e": 206.96}, {"w": " discount", "s": 206.96, "e": 207.52}, {"w": " for", "s": 207.52, "e": 207.8}, {"w": " you", "s": 207.8, "e": 207.94}, {"w": " since", "s": 207.94, "e": 208.06}, {"w": " it's", "s": 208.06, "e": 208.34}, {"w": " nearly", "s": 208.34, "e": 208.34}, {"w": " Christmas.", "s": 208.34, "e": 208.72}]}, {"start": 208.88, "end": 210.7, "text": "Oh, wicked. Here, what do you mean, discounts?", "words": [{"w": " Oh,", "s": 208.88, "e": 208.92}, {"w": " wicked.", "s": 208.96, "e": 209.2}, {"w": " Here,", "s": 209.5, "e": 209.86}, {"w": " what", "s": 209.98, "e": 210.16}, {"w": " do", "s": 210.16, "e": 210.2}, {"w": " you", "s": 210.2, "e": 210.3}, {"w": " mean,", "s": 210.3, "e": 210.38}, {"w": " discounts?", "s": 210.42, "e": 210.7}]}, {"start": 210.98, "end": 213.46, "text": "This year's been bad enough as it is without you giving things away.", "words": [{"w": " This", "s": 210.98, "e": 211.38}, {"w": " year's", "s": 211.38, "e": 211.62}, {"w": " been", "s": 211.62, "e": 211.74}, {"w": " bad", "s": 211.74, "e": 211.94}, {"w": " enough", "s": 211.94, "e": 212.08}, {"w": " as", "s": 212.08, "e": 212.24}, {"w": " it", "s": 212.24, "e": 212.36}, {"w": " is", "s": 212.36, "e": 212.52}, {"w": " without", "s": 212.52, "e": 212.64}, {"w": " you", "s": 212.64, "e": 212.82}, {"w": " giving", "s": 212.82, "e": 213.02}, {"w": " things", "s": 213.02, "e": 213.22}, {"w": " away.", "s": 213.22, "e": 213.46}]}, {"start": 213.52, "end": 214.38, "text": "Don't worry about it.", "words": [{"w": " Don't", "s": 213.52, "e": 213.76}, {"w": " worry", "s": 213.76, "e": 213.92}, {"w": " about", "s": 213.92, "e": 214.22}, {"w": " it.", "s": 214.22, "e": 214.38}]}, {"start": 214.54, "end": 215.96, "text": "Hey, do you like that look?", "words": [{"w": " Hey,", "s": 214.54, "e": 214.94}, {"w": " do", "s": 215.36, "e": 215.46}, {"w": " you", "s": 215.46, "e": 215.5}, {"w": " like", "s": 215.5, "e": 215.7}, {"w": " that", "s": 215.7, "e": 215.88}, {"w": " look?", "s": 215.88, "e": 215.96}]}, {"start": 215.98, "end": 216.32, "text": "I love it.", "words": [{"w": " I", "s": 215.98, "e": 216.14}, {"w": " love", "s": 216.14, "e": 216.14}, {"w": " it.", "s": 216.14, "e": 216.32}]}, {"start": 216.82, "end": 217.26, "text": "Clashes.", "words": [{"w": " Clashes.", "s": 216.82, "e": 217.26}]}, {"start": 217.5, "end": 219.5, "text": "I tell you, they're going to be the rage in 1994.", "words": [{"w": " I", "s": 217.5, "e": 217.94}, {"w": " tell", "s": 217.94, "e": 218.12}, {"w": " you,", "s": 218.12, "e": 218.3}, {"w": " they're", "s": 218.34, "e": 218.46}, {"w": " going", "s": 218.46, "e": 218.48}, {"w": " to", "s": 218.48, "e": 218.54}, {"w": " be", "s": 218.54, "e": 218.62}, {"w": " the", "s": 218.62, "e": 218.74}, {"w": " rage", "s": 218.74, "e": 219.02}, {"w": " in", "s": 219.02, "e": 219.18}, {"w": " 1994.", "s": 219.18, "e": 219.5}]}, {"start": 224.91, "end": 227.61, "text": "Change. You, me, everything.", "words": [{"w": " Change.", "s": 224.91, "e": 225.35}, {"w": " You,", "s": 225.91, "e": 226.35}, {"w": " me,", "s": 226.59, "e": 226.99}, {"w": " everything.", "s": 227.19, "e": 227.61}]}, {"start": 227.95, "end": 230.97, "text": "It's as though someone is rooting through my personal time stream.", "words": [{"w": " It's", "s": 227.95, "e": 228.39}, {"w": " as", "s": 228.39, "e": 228.43}, {"w": " though", "s": 228.43, "e": 228.59}, {"w": " someone", "s": 228.59, "e": 228.83}, {"w": " is", "s": 228.83, "e": 229.01}, {"w": " rooting", "s": 229.01, "e": 229.25}, {"w": " through", "s": 229.25, "e": 229.55}, {"w": " my", "s": 229.55, "e": 229.75}, {"w": " personal", "s": 229.75, "e": 230.21}, {"w": " time", "s": 230.21, "e": 230.59}, {"w": " stream.", "s": 230.59, "e": 230.97}]}, {"start": 231.29, "end": 232.27, "text": "But what on earth for?", "words": [{"w": " But", "s": 231.29, "e": 231.47}, {"w": " what", "s": 231.47, "e": 231.67}, {"w": " on", "s": 231.67, "e": 231.79}, {"w": " earth", "s": 231.79, "e": 232.01}, {"w": " for?", "s": 232.01, "e": 232.27}]}, {"start": 233.57, "end": 234.01, "text": "Earth?", "words": [{"w": " Earth?", "s": 233.57, "e": 234.01}]}, {"start": 234.97, "end": 235.41, "text": "Yes.", "words": [{"w": " Yes.", "s": 234.97, "e": 235.41}]}, {"start": 236.59, "end": 239.73, "text": "Excuse me, my good woman, but what year is this?", "words": [{"w": " Excuse", "s": 236.59, "e": 237.03}, {"w": " me,", "s": 237.03, "e": 237.31}, {"w": " my", "s": 237.33, "e": 237.43}, {"w": " good", "s": 237.43, "e": 237.55}, {"w": " woman,", "s": 237.55, "e": 237.77}, {"w": " but", "s": 237.85, "e": 238.61}, {"w": " what", "s": 238.61, "e": 238.95}, {"w": " year", "s": 238.95, "e": 239.23}, {"w": " is", "s": 239.23, "e": 239.49}, {"w": " this?", "s": 239.49, "e": 239.73}]}, {"start": 239.95, "end": 242.29, "text": "Oi, you, come back here. He's just nicked an earring.", "words": [{"w": " Oi,", "s": 239.95, "e": 240.17}, {"w": " you,", "s": 240.19, "e": 240.43}, {"w": " come", "s": 240.43, "e": 240.67}, {"w": " back", "s": 240.67, "e": 240.93}, {"w": " here.", "s": 240.93, "e": 241.13}, {"w": " He's", "s": 241.17, "e": 241.27}, {"w": " just", "s": 241.27, "e": 241.43}, {"w": " nicked", "s": 241.43, "e": 241.73}, {"w": " an", "s": 241.73, "e": 241.91}, {"w": " earring.", "s": 241.91, "e": 242.29}]}, {"start": 242.31, "end": 244.11, "text": "Shouldn't your Marty be looking after the stall?", "words": [{"w": " Shouldn't", "s": 242.31, "e": 242.67}, {"w": " your", "s": 242.67, "e": 242.75}, {"w": " Marty", "s": 242.75, "e": 243.05}, {"w": " be", "s": 243.05, "e": 243.21}, {"w": " looking", "s": 243.21, "e": 243.41}, {"w": " after", "s": 243.41, "e": 243.65}, {"w": " the", "s": 243.65, "e": 243.85}, {"w": " stall?", "s": 243.85, "e": 244.11}]}, {"start": 244.29, "end": 245.73, "text": "He's never here when you want him.", "words": [{"w": " He's", "s": 244.29, "e": 244.47}, {"w": " never", "s": 244.47, "e": 244.65}, {"w": " here", "s": 244.65, "e": 244.91}, {"w": " when", "s": 244.91, "e": 245.09}, {"w": " you", "s": 245.09, "e": 245.21}, {"w": " want", "s": 245.21, "e": 245.45}, {"w": " him.", "s": 245.45, "e": 245.73}]}, {"start": 245.89, "end": 247.41, "text": "Wish my Arthur was still alive.", "words": [{"w": " Wish", "s": 245.89, "e": 246.15}, {"w": " my", "s": 246.15, "e": 246.33}, {"w": " Arthur", "s": 246.33, "e": 246.65}, {"w": " was", "s": 246.65, "e": 246.87}, {"w": " still", "s": 246.87, "e": 247.09}, {"w": " alive.", "s": 247.09, "e": 247.41}]}, {"start": 248.21, "end": 250.59, "text": "Oi, what do you think you're doing? Stop messing the goods about.", "words": [{"w": " Oi,", "s": 248.21, "e": 248.61}, {"w": " what", "s": 248.65, "e": 248.77}, {"w": " do", "s": 248.77, "e": 248.87}, {"w": " you", "s": 248.87, "e": 248.91}, {"w": " think", "s": 248.91, "e": 249.01}, {"w": " you're", "s": 249.01, "e": 249.21}, {"w": " doing?", "s": 249.21, "e": 249.47}, {"w": " Stop", "s": 249.51, "e": 249.65}, {"w": " messing", "s": 249.65, "e": 249.89}, {"w": " the", "s": 249.89, "e": 250.13}, {"w": " goods", "s": 250.13, "e": 250.31}, {"w": " about.", "s": 250.31, "e": 250.59}]}, {"start": 250.71, "end": 251.97, "text": "Do you want to buy something or what?", "words": [{"w": " Do", "s": 250.71, "e": 250.81}, {"w": " you", "s": 250.81, "e": 250.83}, {"w": " want", "s": 250.83, "e": 250.91}, {"w": " to", "s": 250.91, "e": 250.99}, {"w": " buy", "s": 250.99, "e": 251.15}, {"w": " something", "s": 251.15, "e": 251.47}, {"w": " or", "s": 251.47, "e": 251.73}, {"w": " what?", "s": 251.73, "e": 251.97}]}, {"start": 252.37, "end": 255.35, "text": "Well, considering the quality of everything that you have, madam,", "words": [{"w": " Well,", "s": 252.37, "e": 252.71}, {"w": " considering", "s": 252.73, "e": 253.17}, {"w": " the", "s": 253.17, "e": 253.49}, {"w": " quality", "s": 253.49, "e": 253.89}, {"w": " of", "s": 253.89, "e": 254.31}, {"w": " everything", "s": 254.31, "e": 254.55}, {"w": " that", "s": 254.55, "e": 254.77}, {"w": " you", "s": 254.77, "e": 254.89}, {"w": " have,", "s": 254.89, "e": 255.09}, {"w": " madam,", "s": 255.17, "e": 255.35}]}, {"start": 255.41, "end": 257.11, "text": "I would say that your prices are rather expensive.", "words": [{"w": " I", "s": 255.41, "e": 255.53}, {"w": " would", "s": 255.53, "e": 255.63}, {"w": " say", "s": 255.63, "e": 255.77}, {"w": " that", "s": 255.77, "e": 255.87}, {"w": " your", "s": 255.87, "e": 255.97}, {"w": " prices", "s": 255.97, "e": 256.41}, {"w": " are", "s": 256.41, "e": 256.59}, {"w": " rather", "s": 256.59, "e": 256.77}, {"w": " expensive.", "s": 256.77, "e": 257.11}]}, {"start": 258.27, "end": 260.11, "text": "I see flares are back in fashion.", "words": [{"w": " I", "s": 258.27, "e": 258.67}, {"w": " see", "s": 258.67, "e": 258.91}, {"w": " flares", "s": 258.91, "e": 259.33}, {"w": " are", "s": 259.33, "e": 259.47}, {"w": " back", "s": 259.47, "e": 259.63}, {"w": " in", "s": 259.63, "e": 259.77}, {"w": " fashion.", "s": 259.77, "e": 260.11}]}, {"start": 260.33, "end": 262.83, "text": "Yeah, everything from the last century seems to be having a comeback,", "words": [{"w": " Yeah,", "s": 260.33, "e": 260.71}, {"w": " everything", "s": 260.81, "e": 261.19}, {"w": " from", "s": 261.19, "e": 261.41}, {"w": " the", "s": 261.41, "e": 261.49}, {"w": " last", "s": 261.49, "e": 261.67}, {"w": " century", "s": 261.67, "e": 261.87}, {"w": " seems", "s": 261.87, "e": 262.15}, {"w": " to", "s": 262.15, "e": 262.27}, {"w": " be", "s": 262.27, "e": 262.31}, {"w": " having", "s": 262.31, "e": 262.47}, {"w": " a", "s": 262.47, "e": 262.57}, {"w": " comeback,", "s": 262.57, "e": 262.83}]}, {"start": 262.99, "end": 263.97, "text": "especially from how looks were.", "words": [{"w": " especially", "s": 262.99, "e": 263.31}, {"w": " from", "s": 263.31, "e": 263.49}, {"w": " how", "s": 263.49, "e": 263.53}, {"w": " looks", "s": 263.53, "e": 263.83}, {"w": " were.", "s": 263.83, "e": 263.97}]}, {"start": 264.29, "end": 265.15, "text": "Last century?", "words": [{"w": " Last", "s": 264.29, "e": 264.69}, {"w": " century?", "s": 264.69, "e": 265.15}]}, {"start": 265.41, "end": 266.39, "text": "Well, what year is this?", "words": [{"w": " Well,", "s": 265.41, "e": 265.61}, {"w": " what", "s": 265.67, "e": 265.75}, {"w": " year", "s": 265.75, "e": 265.93}, {"w": " is", "s": 265.93, "e": 266.15}, {"w": " this?", "s": 266.15, "e": 266.39}]}, {"start": 266.57, "end": 269.17, "text": "Oh, don't you start. There's enough oddballs around here as it is.", "words": [{"w": " Oh,", "s": 266.57, "e": 266.65}, {"w": " don't", "s": 266.65, "e": 266.99}, {"w": " you", "s": 266.99, "e": 266.99}, {"w": " start.", "s": 266.99, "e": 267.43}, {"w": " There's", "s": 267.55, "e": 267.65}, {"w": " enough", "s": 267.65, "e": 267.77}, {"w": " oddballs", "s": 267.77, "e": 268.17}, {"w": " around", "s": 268.17, "e": 268.49}, {"w": " here", "s": 268.49, "e": 268.69}, {"w": " as", "s": 268.69, "e": 268.89}, {"w": " it", "s": 268.89, "e": 269.01}, {"w": " is.", "s": 269.01, "e": 269.17}]}, {"start": 269.61, "end": 272.31, "text": "Madam, what year is this?", "words": [{"w": " Madam,", "s": 269.61, "e": 269.87}, {"w": " what", "s": 269.97, "e": 271.37}, {"w": " year", "s": 271.37, "e": 271.71}, {"w": " is", "s": 271.71, "e": 272.01}, {"w": " this?", "s": 272.01, "e": 272.31}]}, {"start": 273.51, "end": 273.91, "text": "2013.", "words": [{"w": " 2013.", "s": 273.51, "e": 273.91}]}, {"start": 273.91, "end": 274.69, "text": "2013?", "words": [{"w": " 2013?", "s": 273.91, "e": 274.69}]}, {"start": 277.47, "end": 280.73, "text": "Yeah, I can remember exactly where I was when Kennedy was assassinated,", "words": [{"w": " Yeah,", "s": 277.47, "e": 277.91}, {"w": " I", "s": 277.93, "e": 278.01}, {"w": " can", "s": 278.01, "e": 278.11}, {"w": " remember", "s": 278.11, "e": 278.35}, {"w": " exactly", "s": 278.35, "e": 278.71}, {"w": " where", "s": 278.71, "e": 279.03}, {"w": " I", "s": 279.03, "e": 279.15}, {"w": " was", "s": 279.15, "e": 279.37}, {"w": " when", "s": 279.37, "e": 279.51}, {"w": " Kennedy", "s": 279.51, "e": 279.83}, {"w": " was", "s": 279.83, "e": 280.01}, {"w": " assassinated,", "s": 280.01, "e": 280.73}]}, {"start": 280.95, "end": 282.15, "text": "but don't tell Arthur.", "words": [{"w": " but", "s": 280.95, "e": 281.33}, {"w": " don't", "s": 281.33, "e": 281.63}, {"w": " tell", "s": 281.63, "e": 281.79}, {"w": " Arthur.", "s": 281.79, "e": 282.15}]}, {"start": 282.49, "end": 283.87, "text": "How long ago was that, then?", "words": [{"w": " How", "s": 282.49, "e": 282.93}, {"w": " long", "s": 282.93, "e": 283.09}, {"w": " ago", "s": 283.09, "e": 283.27}, {"w": " was", "s": 283.27, "e": 283.47}, {"w": " that,", "s": 283.47, "e": 283.67}, {"w": " then?", "s": 283.67, "e": 283.87}]}, {"start": 283.99, "end": 284.85, "text": "Well, it'd be ten years.", "words": [{"w": " Well,", "s": 283.99, "e": 284.13}, {"w": " it'd", "s": 284.13, "e": 284.23}, {"w": " be", "s": 284.23, "e": 284.31}, {"w": " ten", "s": 284.31, "e": 284.49}, {"w": " years.", "s": 284.49, "e": 284.85}]}, {"start": 285.19, "end": 285.41, "text": "No.", "words": [{"w": " No.", "s": 285.19, "e": 285.41}]}, {"start": 286.49, "end": 287.83, "text": "Ian, will you behave?", "words": [{"w": " Ian,", "s": 286.49, "e": 286.93}, {"w": " will", "s": 287.13, "e": 287.39}, {"w": " you", "s": 287.39, "e": 287.51}, {"w": " behave?", "s": 287.51, "e": 287.83}]}, {"start": 289.45, "end": 290.77, "text": "Well, who are you?", "words": [{"w": " Well,", "s": 289.45, "e": 289.89}, {"w": " who", "s": 289.89, "e": 290.33}, {"w": " are", "s": 290.33, "e": 290.59}, {"w": " you?", "s": 290.59, "e": 290.77}]}, {"start": 291.27, "end": 293.29, "text": "Precisely. I am the Doctor.", "words": [{"w": " Precisely.", "s": 291.27, "e": 291.71}, {"w": " I", "s": 292.01, "e": 292.45}, {"w": " am", "s": 292.45, "e": 292.81}, {"w": " the", "s": 292.81, "e": 293.01}, {"w": " Doctor.", "s": 293.01, "e": 293.29}]}, {"start": 293.51, "end": 295.95, "text": "Oh, no, you're not. You're nothing like my grandfather.", "words": [{"w": " Oh,", "s": 293.51, "e": 293.65}, {"w": " no,", "s": 293.69, "e": 293.97}, {"w": " you're", "s": 294.07, "e": 294.41}, {"w": " not.", "s": 294.41, "e": 294.77}, {"w": " You're", "s": 294.87, "e": 295.05}, {"w": " nothing", "s": 295.05, "e": 295.15}, {"w": " like", "s": 295.15, "e": 295.37}, {"w": " my", "s": 295.37, "e": 295.57}, {"w": " grandfather.", "s": 295.57, "e": 295.95}]}, {"start": 296.53, "end": 298.41, "text": "Fiddlers have been pulled backwards through time,", "words": [{"w": " Fiddlers", "s": 296.53, "e": 296.97}, {"w": " have", "s": 296.97, "e": 297.07}, {"w": " been", "s": 297.07, "e": 297.21}, {"w": " pulled", "s": 297.21, "e": 297.49}, {"w": " backwards", "s": 297.49, "e": 297.83}, {"w": " through", "s": 297.83, "e": 298.09}, {"w": " time,", "s": 298.09, "e": 298.41}]}, {"start": 298.49, "end": 300.27, "text": "and my companions have been drawn back with me.", "words": [{"w": " and", "s": 298.49, "e": 298.61}, {"w": " my", "s": 298.61, "e": 298.67}, {"w": " companions", "s": 298.67, "e": 299.15}, {"w": " have", "s": 299.15, "e": 299.33}, {"w": " been", "s": 299.33, "e": 299.45}, {"w": " drawn", "s": 299.45, "e": 299.71}, {"w": " back", "s": 299.71, "e": 299.89}, {"w": " with", "s": 299.89, "e": 300.09}, {"w": " me.", "s": 300.09, "e": 300.27}]}, {"start": 300.83, "end": 305.14, "text": "Ian? Barbara? Or the others?", "words": [{"w": " Ian?", "s": 300.83, "e": 301.27}, {"w": " Barbara?", "s": 302.47, "e": 302.91}, {"w": " Or", "s": 303.05, "e": 303.21}, {"w": " the", "s": 304.58, "e": 304.82}, {"w": " others?", "s": 304.82, "e": 305.14}]}, {"start": 305.42, "end": 305.86, "text": "Don't ask.", "words": [{"w": " Don't", "s": 305.42, "e": 305.76}, {"w": " ask.", "s": 305.76, "e": 305.86}]}, {"start": 305.86, "end": 308.38, "text": "Someone is trying to separate me from the TARDIS", "words": [{"w": " Someone", "s": 305.86, "e": 306.44}, {"w": " is", "s": 306.44, "e": 306.84}, {"w": " trying", "s": 306.84, "e": 307.02}, {"w": " to", "s": 307.02, "e": 307.18}, {"w": " separate", "s": 307.18, "e": 307.48}, {"w": " me", "s": 307.48, "e": 307.72}, {"w": " from", "s": 307.72, "e": 307.9}, {"w": " the", "s": 307.9, "e": 308.02}, {"w": " TARDIS", "s": 308.02, "e": 308.38}]}, {"start": 308.38, "end": 310.1, "text": "and knows my affinity for this planet.", "words": [{"w": " and", "s": 308.38, "e": 308.56}, {"w": " knows", "s": 308.56, "e": 308.94}, {"w": " my", "s": 308.94, "e": 309.1}, {"w": " affinity", "s": 309.1, "e": 309.4}, {"w": " for", "s": 309.4, "e": 309.66}, {"w": " this", "s": 309.66, "e": 309.78}, {"w": " planet.", "s": 309.78, "e": 310.1}]}, {"start": 310.82, "end": 311.8, "text": "Where's grandfather?", "words": [{"w": " Where's", "s": 310.82, "e": 311.34}, {"w": " grandfather?", "s": 311.34, "e": 311.8}]}, {"start": 312.52, "end": 313.56, "text": "My doctor?", "words": [{"w": " My", "s": 312.52, "e": 313.04}, {"w": " doctor?", "s": 313.04, "e": 313.56}]}, {"start": 314.12, "end": 314.98, "text": "The original?", "words": [{"w": " The", "s": 314.12, "e": 314.64}, {"w": " original?", "s": 314.64, "e": 314.98}]}, {"start": 315.4, "end": 318.9, "text": "The inrush of time zones is designed to seal us all together.", "words": [{"w": " The", "s": 315.4, "e": 315.6}, {"w": " inrush", "s": 315.6, "e": 316.0}, {"w": " of", "s": 316.0, "e": 316.14}, {"w": " time", "s": 316.14, "e": 316.38}, {"w": " zones", "s": 316.38, "e": 316.68}, {"w": " is", "s": 316.68, "e": 316.9}, {"w": " designed", "s": 316.9, "e": 317.26}, {"w": " to", "s": 317.26, "e": 317.64}, {"w": " seal", "s": 317.64, "e": 317.98}, {"w": " us", "s": 317.98, "e": 318.14}, {"w": " all", "s": 318.14, "e": 318.4}, {"w": " together.", "s": 318.4, "e": 318.9}]}, {"start": 320.36, "end": 325.72, "text": "My skin's been great since I started using all over sunblock.", "words": [{"w": " My", "s": 320.36, "e": 320.88}, {"w": " skin's", "s": 323.16, "e": 323.58}, {"w": " been", "s": 323.58, "e": 323.7}, {"w": " great", "s": 323.7, "e": 323.98}, {"w": " since", "s": 323.98, "e": 324.16}, {"w": " I", "s": 324.16, "e": 324.3}, {"w": " started", "s": 324.3, "e": 324.62}, {"w": " using", "s": 324.62, "e": 324.84}, {"w": " all", "s": 324.84, "e": 325.06}, {"w": " over", "s": 325.06, "e": 325.24}, {"w": " sunblock.", "s": 325.24, "e": 325.72}]}, {"start": 325.92, "end": 327.04, "text": "I think it's right. It's the law.", "words": [{"w": " I", "s": 325.92, "e": 326.04}, {"w": " think", "s": 326.04, "e": 326.18}, {"w": " it's", "s": 326.18, "e": 326.42}, {"w": " right.", "s": 326.42, "e": 326.56}, {"w": " It's", "s": 326.66, "e": 326.84}, {"w": " the", "s": 326.84, "e": 326.84}, {"w": " law.", "s": 326.84, "e": 327.04}]}, {"start": 327.12, "end": 327.62, "text": "The law?", "words": [{"w": " The", "s": 327.12, "e": 327.38}, {"w": " law?", "s": 327.38, "e": 327.62}]}, {"start": 328.28, "end": 329.32, "text": "Since when?", "words": [{"w": " Since", "s": 328.28, "e": 328.8}, {"w": " when?", "s": 328.8, "e": 329.32}]}, {"start": 330.1, "end": 332.02, "text": "Hey, where have you been hiding, then?", "words": [{"w": " Hey,", "s": 330.1, "e": 330.62}, {"w": " where", "s": 330.7, "e": 331.06}, {"w": " have", "s": 331.06, "e": 331.14}, {"w": " you", "s": 331.14, "e": 331.3}, {"w": " been", "s": 331.3, "e": 331.46}, {"w": " hiding,", "s": 331.46, "e": 331.74}, {"w": " then?", "s": 331.88, "e": 332.02}]}, {"start": 332.26, "end": 336.42, "text": "I thought you'd be involved somewhere along the line.", "words": [{"w": " I", "s": 332.26, "e": 332.78}, {"w": " thought", "s": 334.34, "e": 334.64}, {"w": " you'd", "s": 334.64, "e": 334.9}, {"w": " be", "s": 334.9, "e": 334.98}, {"w": " involved", "s": 334.98, "e": 335.32}, {"w": " somewhere", "s": 335.32, "e": 335.68}, {"w": " along", "s": 335.68, "e": 335.98}, {"w": " the", "s": 335.98, "e": 336.16}, {"w": " line.", "s": 336.16, "e": 336.42}]}, {"start": 336.6, "end": 338.08, "text": "What we're seeing here, Sarah,", "words": [{"w": " What", "s": 336.6, "e": 336.9}, {"w": " we're", "s": 336.9, "e": 337.18}, {"w": " seeing", "s": 337.18, "e": 337.44}, {"w": " here,", "s": 337.44, "e": 337.68}, {"w": " Sarah,", "s": 337.78, "e": 338.08}]}, {"start": 338.08, "end": 340.16, "text": "is the work of a genius.", "words": [{"w": " is", "s": 338.08, "e": 339.02}, {"w": " the", "s": 339.02, "e": 339.4}, {"w": " work", "s": 339.4, "e": 339.62}, {"w": " of", "s": 339.62, "e": 339.72}, {"w": " a", "s": 339.72, "e": 339.78}, {"w": " genius.", "s": 339.78, "e": 340.16}]}, {"start": 341.1, "end": 342.92, "text": "An expert in time distortion.", "words": [{"w": " An", "s": 341.1, "e": 341.58}, {"w": " expert", "s": 341.58, "e": 342.02}, {"w": " in", "s": 342.02, "e": 342.32}, {"w": " time", "s": 342.32, "e": 342.58}, {"w": " distortion.", "s": 342.58, "e": 342.92}]}, {"start": 343.56, "end": 345.18, "text": "A time traveller, maybe.", "words": [{"w": " A", "s": 343.56, "e": 344.04}, {"w": " time", "s": 344.04, "e": 344.52}, {"w": " traveller,", "s": 344.52, "e": 344.98}, {"w": " maybe.", "s": 345.0, "e": 345.18}]}, {"start": 345.6, "end": 347.02, "text": "And an ingenious operator.", "words": [{"w": " And", "s": 345.6, "e": 346.08}, {"w": " an", "s": 346.08, "e": 346.22}, {"w": " ingenious", "s": 346.22, "e": 346.7}, {"w": " operator.", "s": 346.7, "e": 347.02}]}, {"start": 347.46, "end": 349.2, "text": "Well, then we must get back to the TARDIS, Doctor.", "words": [{"w": " Well,", "s": 347.46, "e": 347.66}, {"w": " then", "s": 347.68, "e": 347.8}, {"w": " we", "s": 347.8, "e": 347.9}, {"w": " must", "s": 347.9, "e": 348.06}, {"w": " get", "s": 348.06, "e": 348.18}, {"w": " back", "s": 348.18, "e": 348.34}, {"w": " to", "s": 348.34, "e": 348.46}, {"w": " the", "s": 348.46, "e": 348.54}, {"w": " TARDIS,", "s": 348.54, "e": 348.96}, {"w": " Doctor.", "s": 348.96, "e": 349.2}]}, {"start": 349.42, "end": 350.78, "text": "Well, it's the other side of the river, I think.", "words": [{"w": " Well,", "s": 349.42, "e": 349.56}, {"w": " it's", "s": 349.56, "e": 349.72}, {"w": " the", "s": 349.72, "e": 349.74}, {"w": " other", "s": 349.74, "e": 349.9}, {"w": " side", "s": 349.9, "e": 350.08}, {"w": " of", "s": 350.08, "e": 350.22}, {"w": " the", "s": 350.22, "e": 350.26}, {"w": " river,", "s": 350.26, "e": 350.48}, {"w": " I", "s": 350.52, "e": 350.62}, {"w": " think.", "s": 350.62, "e": 350.78}]}, {"start": 351.46, "end": 355.16, "text": "You know, we seem to be flitting around in some sort of 20-year time loop.", "words": [{"w": " You", "s": 351.46, "e": 351.94}, {"w": " know,", "s": 351.94, "e": 352.0}, {"w": " we", "s": 352.04, "e": 352.1}, {"w": " seem", "s": 352.1, "e": 352.24}, {"w": " to", "s": 352.24, "e": 352.38}, {"w": " be", "s": 352.38, "e": 352.48}, {"w": " flitting", "s": 352.48, "e": 352.84}, {"w": " around", "s": 352.84, "e": 353.1}, {"w": " in", "s": 353.1, "e": 353.4}, {"w": " some", "s": 353.4, "e": 353.58}, {"w": " sort", "s": 353.58, "e": 353.82}, {"w": " of", "s": 353.82, "e": 353.96}, {"w": " 20", "s": 353.96, "e": 354.3}, {"w": "-year", "s": 354.3, "e": 354.54}, {"w": " time", "s": 354.54, "e": 354.8}, {"w": " loop.", "s": 354.8, "e": 355.16}]}, {"start": 356.42, "end": 356.9, "text": "1973.", "words": [{"w": " 1973.", "s": 356.42, "e": 356.9}]}, {"start": 358.06, "end": 358.98, "text": "Or 1993.", "words": [{"w": " Or", "s": 358.06, "e": 358.54}, {"w": " 1993.", "s": 358.54, "e": 358.98}]}, {"start": 361.06, "end": 361.54, "text": "2013.", "words": [{"w": " 2013.", "s": 361.06, "e": 361.54}]}, {"start": 362.48, "end": 365.8, "text": "Well, time distortion of this nature requires an exact localised focus.", "words": [{"w": " Well,", "s": 362.48, "e": 362.6}, {"w": " time", "s": 362.66, "e": 362.9}, {"w": " distortion", "s": 362.9, "e": 363.26}, {"w": " of", "s": 363.26, "e": 363.52}, {"w": " this", "s": 363.52, "e": 363.66}, {"w": " nature", "s": 363.66, "e": 363.94}, {"w": " requires", "s": 363.94, "e": 364.28}, {"w": " an", "s": 364.28, "e": 364.58}, {"w": " exact", "s": 364.58, "e": 364.86}, {"w": " localised", "s": 364.86, "e": 365.48}, {"w": " focus.", "s": 365.48, "e": 365.8}]}, {"start": 366.1, "end": 367.54, "text": "But why this street market in London?", "words": [{"w": " But", "s": 366.1, "e": 366.22}, {"w": " why", "s": 366.22, "e": 366.36}, {"w": " this", "s": 366.36, "e": 366.52}, {"w": " street", "s": 366.52, "e": 366.76}, {"w": " market", "s": 366.76, "e": 367.04}, {"w": " in", "s": 367.04, "e": 367.26}, {"w": " London?", "s": 367.26, "e": 367.54}]}, {"start": 367.54, "end": 369.12, "text": "This isn't the focus, Sarah.", "words": [{"w": " This", "s": 367.54, "e": 367.98}, {"w": " isn't", "s": 367.98, "e": 368.3}, {"w": " the", "s": 368.3, "e": 368.36}, {"w": " focus,", "s": 368.36, "e": 368.76}, {"w": " Sarah.", "s": 368.86, "e": 369.12}]}, {"start": 371.42, "end": 372.2, "text": "Blundering fools.", "words": [{"w": " Blundering", "s": 371.42, "e": 371.94}, {"w": " fools.", "s": 371.94, "e": 372.2}]}, {"start": 372.74, "end": 374.16, "text": "They're getting too near the truth.", "words": [{"w": " They're", "s": 372.74, "e": 373.26}, {"w": " getting", "s": 373.26, "e": 373.4}, {"w": " too", "s": 373.4, "e": 373.56}, {"w": " near", "s": 373.56, "e": 373.78}, {"w": " the", "s": 373.78, "e": 373.9}, {"w": " truth.", "s": 373.9, "e": 374.16}]}, {"start": 374.7, "end": 375.68, "text": "Release the specimens.", "words": [{"w": " Release", "s": 374.7, "e": 375.22}, {"w": " the", "s": 375.22, "e": 375.4}, {"w": " specimens.", "s": 375.4, "e": 375.68}]}, {"start": 378.14, "end": 379.36, "text": "Feeding time at the zoo?", "words": [{"w": " Feeding", "s": 378.14, "e": 378.66}, {"w": " time", "s": 378.66, "e": 378.88}, {"w": " at", "s": 378.88, "e": 379.04}, {"w": " the", "s": 379.04, "e": 379.12}, {"w": " zoo?", "s": 379.12, "e": 379.36}]}, {"start": 379.7, "end": 381.76, "text": "And the companions went in two by two.", "words": [{"w": " And", "s": 379.7, "e": 380.22}, {"w": " the", "s": 380.22, "e": 380.28}, {"w": " companions", "s": 380.28, "e": 380.74}, {"w": " went", "s": 380.74, "e": 381.02}, {"w": " in", "s": 381.02, "e": 381.16}, {"w": " two", "s": 381.16, "e": 381.36}, {"w": " by", "s": 381.36, "e": 381.48}, {"w": " two.", "s": 381.48, "e": 381.76}]}, {"start": 382.32, "end": 383.94, "text": "This isn't known as Ark, Doctor.", "words": [{"w": " This", "s": 382.32, "e": 382.84}, {"w": " isn't", "s": 382.84, "e": 383.0}, {"w": " known", "s": 383.0, "e": 383.18}, {"w": " as", "s": 383.18, "e": 383.34}, {"w": " Ark,", "s": 383.34, "e": 383.6}, {"w": " Doctor.", "s": 383.62, "e": 383.94}]}, {"start": 385.62, "end": 386.56, "text": "Maybe it is.", "words": [{"w": " Maybe", "s": 385.62, "e": 386.14}, {"w": " it", "s": 386.14, "e": 386.26}, {"w": " is.", "s": 386.26, "e": 386.56}]}, {"start": 387.34, "end": 389.4, "text": "But when I say run, run.", "words": [{"w": " But", "s": 387.34, "e": 387.8}, {"w": " when", "s": 387.8, "e": 388.0}, {"w": " I", "s": 388.0, "e": 388.08}, {"w": " say", "s": 388.08, "e": 388.3}, {"w": " run,", "s": 388.3, "e": 388.54}, {"w": " run.", "s": 388.8, "e": 389.4}]}, {"start": 389.72, "end": 390.02, "text": "Run!", "words": [{"w": " Run!", "s": 389.72, "e": 390.02}]}, {"start": 393.2, "end": 393.92, "text": "This way!", "words": [{"w": " This", "s": 393.2, "e": 393.72}, {"w": " way!", "s": 393.72, "e": 393.92}]}, {"start": 394.48, "end": 401.12, "text": "You're in terrible danger!", "words": [{"w": " You're", "s": 394.48, "e": 395.0}, {"w": " in", "s": 399.64, "e": 400.16}, {"w": " terrible", "s": 400.16, "e": 400.42}, {"w": " danger!", "s": 400.42, "e": 401.12}]}, {"start": 401.12, "end": 402.12, "text": "What's your game?", "words": [{"w": " What's", "s": 401.12, "e": 401.62}, {"w": " your", "s": 401.62, "e": 401.62}, {"w": " game?", "s": 401.62, "e": 402.12}]}, {"start": 402.34, "end": 403.44, "text": "You've got to get away from here.", "words": [{"w": " You've", "s": 402.34, "e": 402.52}, {"w": " got", "s": 402.52, "e": 402.58}, {"w": " to", "s": 402.58, "e": 402.7}, {"w": " get", "s": 402.7, "e": 402.74}, {"w": " away", "s": 402.74, "e": 402.94}, {"w": " from", "s": 402.94, "e": 403.18}, {"w": " here.", "s": 403.18, "e": 403.44}]}, {"start": 403.58, "end": 404.06, "text": "Here?", "words": [{"w": " Here?", "s": 403.58, "e": 404.06}]}, {"start": 404.28, "end": 404.9, "text": "Who says?", "words": [{"w": " Who", "s": 404.28, "e": 404.54}, {"w": " says?", "s": 404.54, "e": 404.9}]}, {"start": 405.44, "end": 407.4, "text": "You start shoving me around to know about it.", "words": [{"w": " You", "s": 405.44, "e": 405.66}, {"w": " start", "s": 405.66, "e": 405.84}, {"w": " shoving", "s": 405.84, "e": 406.2}, {"w": " me", "s": 406.2, "e": 406.3}, {"w": " around", "s": 406.3, "e": 406.58}, {"w": " to", "s": 406.58, "e": 406.74}, {"w": " know", "s": 406.74, "e": 406.86}, {"w": " about", "s": 406.86, "e": 407.1}, {"w": " it.", "s": 407.1, "e": 407.4}]}, {"start": 407.64, "end": 408.18, "text": "It's no good.", "words": [{"w": " It's", "s": 407.64, "e": 407.84}, {"w": " no", "s": 407.84, "e": 407.92}, {"w": " good.", "s": 407.92, "e": 408.18}]}, {"start": 408.3, "end": 409.38, "text": "They're in different time zones.", "words": [{"w": " They're", "s": 408.3, "e": 408.62}, {"w": " in", "s": 408.62, "e": 408.66}, {"w": " different", "s": 408.66, "e": 408.86}, {"w": " time", "s": 408.86, "e": 409.16}, {"w": " zones.", "s": 409.16, "e": 409.38}]}, {"start": 409.62, "end": 411.02, "text": "To them, we're the strangers.", "words": [{"w": " To", "s": 409.62, "e": 410.06}, {"w": " them,", "s": 410.06, "e": 410.34}, {"w": " we're", "s": 410.34, "e": 410.5}, {"w": " the", "s": 410.5, "e": 410.6}, {"w": " strangers.", "s": 410.6, "e": 411.02}]}, {"start": 411.74, "end": 428.78, "text": "Any idea where we're going?", "words": [{"w": " Any", "s": 411.74, "e": 412.22}, {"w": " idea", "s": 427.62, "e": 428.04}, {"w": " where", "s": 428.04, "e": 428.32}, {"w": " we're", "s": 428.32, "e": 428.54}, {"w": " going?", "s": 428.54, "e": 428.78}]}, {"start": 429.1, "end": 430.72, "text": "Doctor, where's the TARDIS?", "words": [{"w": " Doctor,", "s": 429.1, "e": 429.52}, {"w": " where's", "s": 429.54, "e": 430.06}, {"w": " the", "s": 430.06, "e": 430.06}, {"w": " TARDIS?", "s": 430.06, "e": 430.72}]}, {"start": 430.9, "end": 432.58, "text": "Twenty years back and three miles away.", "words": [{"w": " Twenty", "s": 430.9, "e": 431.12}, {"w": " years", "s": 431.12, "e": 431.38}, {"w": " back", "s": 431.38, "e": 431.64}, {"w": " and", "s": 431.64, "e": 431.84}, {"w": " three", "s": 431.84, "e": 431.98}, {"w": " miles", "s": 431.98, "e": 432.3}, {"w": " away.", "s": 432.3, "e": 432.58}]}, {"start": 432.68, "end": 433.12, "text": "Come on!", "words": [{"w": " Come", "s": 432.68, "e": 432.84}, {"w": " on!", "s": 432.84, "e": 433.12}]}, {"start": 457.14, "end": 457.62, "text": "Journey!", "words": [{"w": " Journey!", "s": 457.14, "e": 457.62}]}]