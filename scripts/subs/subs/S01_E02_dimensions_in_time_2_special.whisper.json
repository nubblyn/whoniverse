[{"start": 10.57, "end": 51.5, "text": "The Rani, EastEnders, Albert Square.", "words": [{"w": " The", "s": 10.57, "e": 11.23}, {"w": " Rani,", "s": 50.78, "e": 50.78}, {"w": " EastEnders,", "s": 50.8, "e": 51.5}, {"w": " Albert", "s": 51.5, "e": 51.5}, {"w": " Square.", "s": 51.5, "e": 51.5}]}, {"start": 51.5, "end": 52.82, "text": "A very long journey.", "words": [{"w": " A", "s": 51.5, "e": 51.5}, {"w": " very", "s": 51.5, "e": 51.9}, {"w": " long", "s": 51.9, "e": 52.34}, {"w": " journey.", "s": 52.34, "e": 52.82}]}, {"start": 53.18, "end": 58.62, "text": "The Rani. I take back what I said about an ingenious operator being behind these time jumps.", "words": [{"w": " The", "s": 53.18, "e": 53.82}, {"w": " Rani.", "s": 53.82, "e": 54.36}, {"w": " I", "s": 54.6, "e": 55.26}, {"w": " take", "s": 55.26, "e": 55.46}, {"w": " back", "s": 55.46, "e": 55.74}, {"w": " what", "s": 55.74, "e": 55.9}, {"w": " I", "s": 55.9, "e": 56.0}, {"w": " said", "s": 56.0, "e": 56.16}, {"w": " about", "s": 56.16, "e": 56.34}, {"w": " an", "s": 56.34, "e": 56.5}, {"w": " ingenious", "s": 56.5, "e": 56.94}, {"w": " operator", "s": 56.94, "e": 57.26}, {"w": " being", "s": 57.26, "e": 57.6}, {"w": " behind", "s": 57.6, "e": 57.86}, {"w": " these", "s": 57.86, "e": 58.08}, {"w": " time", "s": 58.08, "e": 58.34}, {"w": " jumps.", "s": 58.34, "e": 58.62}]}, {"start": 58.96, "end": 60.68, "text": "What's going on Doctor?", "words": [{"w": " What's", "s": 58.96, "e": 59.6}, {"w": " going", "s": 59.6, "e": 59.76}, {"w": " on", "s": 59.76, "e": 60.28}, {"w": " Doctor?", "s": 60.28, "e": 60.68}]}, {"start": 61.12, "end": 65.62, "text": "Who else could master such a difficult operation? Back to my TARDIS.", "words": [{"w": " Who", "s": 61.12, "e": 61.6}, {"w": " else", "s": 61.6, "e": 61.92}, {"w": " could", "s": 61.92, "e": 62.14}, {"w": " master", "s": 62.14, "e": 62.54}, {"w": " such", "s": 62.54, "e": 62.84}, {"w": " a", "s": 62.84, "e": 62.96}, {"w": " difficult", "s": 62.96, "e": 63.36}, {"w": " operation?", "s": 63.36, "e": 63.82}, {"w": " Back", "s": 64.28, "e": 64.94}, {"w": " to", "s": 64.94, "e": 65.06}, {"w": " my", "s": 65.06, "e": 65.2}, {"w": " TARDIS.", "s": 65.2, "e": 65.62}]}, {"start": 66.76, "end": 67.94, "text": "What are you doing?", "words": [{"w": " What", "s": 66.76, "e": 67.42}, {"w": " are", "s": 67.42, "e": 67.54}, {"w": " you", "s": 67.54, "e": 67.64}, {"w": " doing?", "s": 67.64, "e": 67.94}]}, {"start": 69.14, "end": 72.14, "text": "Why bother trying to summon up your remaining selves?", "words": [{"w": " Why", "s": 69.14, "e": 69.58}, {"w": " bother", "s": 69.58, "e": 69.9}, {"w": " trying", "s": 69.9, "e": 70.34}, {"w": " to", "s": 70.34, "e": 70.68}, {"w": " summon", "s": 70.68, "e": 70.94}, {"w": " up", "s": 70.94, "e": 71.1}, {"w": " your", "s": 71.1, "e": 71.24}, {"w": " remaining", "s": 71.24, "e": 71.58}, {"w": " selves?", "s": 71.58, "e": 72.14}]}, {"start": 73.0, "end": 74.08, "text": "I've weakened you.", "words": [{"w": " I've", "s": 73.0, "e": 73.44}, {"w": " weakened", "s": 73.44, "e": 73.78}, {"w": " you.", "s": 73.78, "e": 74.08}]}, {"start": 76.96, "end": 79.34, "text": "I've got a few more tricks up my sleeve yet madam.", "words": [{"w": " I've", "s": 76.96, "e": 77.4}, {"w": " got", "s": 77.4, "e": 77.5}, {"w": " a", "s": 77.5, "e": 77.6}, {"w": " few", "s": 77.6, "e": 77.78}, {"w": " more", "s": 77.78, "e": 77.92}, {"w": " tricks", "s": 77.92, "e": 78.16}, {"w": " up", "s": 78.16, "e": 78.36}, {"w": " my", "s": 78.36, "e": 78.5}, {"w": " sleeve", "s": 78.5, "e": 78.88}, {"w": " yet", "s": 78.88, "e": 79.08}, {"w": " madam.", "s": 79.08, "e": 79.34}]}, {"start": 79.82, "end": 81.38, "text": "It's time for you to start losing.", "words": [{"w": " It's", "s": 79.82, "e": 80.26}, {"w": " time", "s": 80.26, "e": 80.48}, {"w": " for", "s": 80.48, "e": 80.64}, {"w": " you", "s": 80.64, "e": 80.74}, {"w": " to", "s": 80.74, "e": 80.88}, {"w": " start", "s": 80.88, "e": 81.1}, {"w": " losing.", "s": 81.1, "e": 81.38}]}, {"start": 81.78, "end": 83.9, "text": "You, Earth Female, come here.", "words": [{"w": " You,", "s": 81.78, "e": 82.22}, {"w": " Earth", "s": 82.42, "e": 82.96}, {"w": " Female,", "s": 82.96, "e": 83.3}, {"w": " come", "s": 83.5, "e": 83.72}, {"w": " here.", "s": 83.72, "e": 83.9}]}, {"start": 84.56, "end": 86.58, "text": "But this, but this mustn't be.", "words": [{"w": " But", "s": 84.56, "e": 85.0}, {"w": " this,", "s": 85.0, "e": 85.26}, {"w": " but", "s": 85.3, "e": 85.66}, {"w": " this", "s": 85.66, "e": 85.96}, {"w": " mustn't", "s": 85.96, "e": 86.48}, {"w": " be.", "s": 86.48, "e": 86.58}]}, {"start": 86.62, "end": 88.2, "text": "Leave this to me, I'll take my chances.", "words": [{"w": " Leave", "s": 86.62, "e": 86.78}, {"w": " this", "s": 86.78, "e": 86.86}, {"w": " to", "s": 86.86, "e": 87.0}, {"w": " me,", "s": 87.0, "e": 87.16}, {"w": " I'll", "s": 87.22, "e": 87.5}, {"w": " take", "s": 87.5, "e": 87.6}, {"w": " my", "s": 87.6, "e": 87.78}, {"w": " chances.", "s": 87.78, "e": 88.2}]}, {"start": 111.91, "end": 114.07, "text": "Get me to the TARDIS as quick as possible.", "words": [{"w": " Get", "s": 111.91, "e": 112.35}, {"w": " me", "s": 112.35, "e": 112.79}, {"w": " to", "s": 112.79, "e": 112.91}, {"w": " the", "s": 112.91, "e": 113.01}, {"w": " TARDIS", "s": 113.01, "e": 113.35}, {"w": " as", "s": 113.35, "e": 113.49}, {"w": " quick", "s": 113.49, "e": 113.61}, {"w": " as", "s": 113.61, "e": 113.71}, {"w": " possible.", "s": 113.71, "e": 114.07}]}, {"start": 114.97, "end": 138.19, "text": "The region's going to be bossed with all of you these days Doctor.", "words": [{"w": " The", "s": 114.97, "e": 115.41}, {"w": " region's", "s": 135.35, "e": 135.75}, {"w": " going", "s": 135.75, "e": 136.07}, {"w": " to", "s": 136.07, "e": 136.27}, {"w": " be", "s": 136.27, "e": 136.33}, {"w": " bossed", "s": 136.33, "e": 136.79}, {"w": " with", "s": 136.79, "e": 136.87}, {"w": " all", "s": 136.87, "e": 137.13}, {"w": " of", "s": 137.13, "e": 137.25}, {"w": " you", "s": 137.25, "e": 137.37}, {"w": " these", "s": 137.37, "e": 137.53}, {"w": " days", "s": 137.53, "e": 137.91}, {"w": " Doctor.", "s": 137.91, "e": 138.19}]}, {"start": 139.17, "end": 140.87, "text": "Come on the time A, dig it in.", "words": [{"w": " Come", "s": 139.17, "e": 139.61}, {"w": " on", "s": 139.61, "e": 139.71}, {"w": " the", "s": 139.71, "e": 139.81}, {"w": " time", "s": 139.81, "e": 140.15}, {"w": " A,", "s": 140.15, "e": 140.45}, {"w": " dig", "s": 140.51, "e": 140.73}, {"w": " it", "s": 140.73, "e": 140.79}, {"w": " in.", "s": 140.79, "e": 140.87}]}, {"start": 140.89, "end": 143.79, "text": "My dear, alas, there's no time for pleasantries.", "words": [{"w": " My", "s": 140.89, "e": 141.01}, {"w": " dear,", "s": 141.01, "e": 141.01}, {"w": " alas,", "s": 141.13, "e": 142.01}, {"w": " there's", "s": 142.03, "e": 142.49}, {"w": " no", "s": 142.49, "e": 142.63}, {"w": " time", "s": 142.63, "e": 143.07}, {"w": " for", "s": 143.07, "e": 143.23}, {"w": " pleasantries.", "s": 143.23, "e": 143.79}]}, {"start": 143.91, "end": 145.59, "text": "I must find my young friend.", "words": [{"w": " I", "s": 143.91, "e": 144.21}, {"w": " must", "s": 144.21, "e": 144.35}, {"w": " find", "s": 144.35, "e": 144.75}, {"w": " my", "s": 144.75, "e": 144.95}, {"w": " young", "s": 144.95, "e": 145.17}, {"w": " friend.", "s": 145.17, "e": 145.59}]}, {"start": 145.87, "end": 148.41, "text": "He'll speak soon old chap. To all of you I hope.", "words": [{"w": " He'll", "s": 145.87, "e": 146.09}, {"w": " speak", "s": 146.09, "e": 146.19}, {"w": " soon", "s": 146.19, "e": 146.59}, {"w": " old", "s": 146.59, "e": 146.83}, {"w": " chap.", "s": 146.83, "e": 147.07}, {"w": " To", "s": 147.23, "e": 147.47}, {"w": " all", "s": 147.47, "e": 147.75}, {"w": " of", "s": 147.75, "e": 147.87}, {"w": " you", "s": 147.87, "e": 147.99}, {"w": " I", "s": 147.99, "e": 148.15}, {"w": " hope.", "s": 148.15, "e": 148.41}]}, {"start": 149.69, "end": 152.75, "text": "I now have everything I want apart from one Earthling.", "words": [{"w": " I", "s": 149.69, "e": 150.11}, {"w": " now", "s": 150.11, "e": 150.31}, {"w": " have", "s": 150.31, "e": 150.47}, {"w": " everything", "s": 150.47, "e": 150.85}, {"w": " I", "s": 150.85, "e": 151.13}, {"w": " want", "s": 151.13, "e": 151.39}, {"w": " apart", "s": 151.39, "e": 151.63}, {"w": " from", "s": 151.63, "e": 151.87}, {"w": " one", "s": 151.87, "e": 152.13}, {"w": " Earthling.", "s": 152.13, "e": 152.75}]}, {"start": 152.95, "end": 154.65, "text": "My menagerie is almost complete.", "words": [{"w": " My", "s": 152.95, "e": 153.37}, {"w": " menagerie", "s": 153.37, "e": 153.89}, {"w": " is", "s": 153.89, "e": 153.99}, {"w": " almost", "s": 153.99, "e": 154.19}, {"w": " complete.", "s": 154.19, "e": 154.65}]}, {"start": 155.69, "end": 158.95, "text": "Prepare to rematerialise at the centre of the Earth time meridian, Greenwich.", "words": [{"w": " Prepare", "s": 155.69, "e": 156.11}, {"w": " to", "s": 156.11, "e": 156.35}, {"w": " rematerialise", "s": 156.35, "e": 157.07}, {"w": " at", "s": 157.07, "e": 157.15}, {"w": " the", "s": 157.15, "e": 157.27}, {"w": " centre", "s": 157.27, "e": 157.47}, {"w": " of", "s": 157.47, "e": 157.59}, {"w": " the", "s": 157.59, "e": 157.67}, {"w": " Earth", "s": 157.67, "e": 157.83}, {"w": " time", "s": 157.83, "e": 158.03}, {"w": " meridian,", "s": 158.03, "e": 158.37}, {"w": " Greenwich.", "s": 158.57, "e": 158.95}]}, {"start": 167.13, "end": 168.23, "text": "You said you locked it?", "words": [{"w": " You", "s": 167.13, "e": 167.55}, {"w": " said", "s": 167.55, "e": 167.77}, {"w": " you", "s": 167.77, "e": 167.87}, {"w": " locked", "s": 167.87, "e": 168.05}, {"w": " it?", "s": 168.05, "e": 168.23}]}, {"start": 168.47, "end": 169.67, "text": "I did, someone must have broken in.", "words": [{"w": " I", "s": 168.47, "e": 168.61}, {"w": " did,", "s": 168.61, "e": 168.77}, {"w": " someone", "s": 168.89, "e": 169.03}, {"w": " must", "s": 169.03, "e": 169.21}, {"w": " have", "s": 169.21, "e": 169.33}, {"w": " broken", "s": 169.33, "e": 169.49}, {"w": " in.", "s": 169.49, "e": 169.67}]}, {"start": 172.0, "end": 172.64, "text": "Who are you?", "words": [{"w": " Who", "s": 172.0, "e": 172.42}, {"w": " are", "s": 172.42, "e": 172.5}, {"w": " you?", "s": 172.5, "e": 172.64}]}, {"start": 173.74, "end": 174.46, "text": "What's your game?", "words": [{"w": " What's", "s": 173.74, "e": 174.16}, {"w": " your", "s": 174.16, "e": 174.16}, {"w": " game?", "s": 174.16, "e": 174.46}]}, {"start": 175.56, "end": 178.56, "text": "I was looking for the Doctor. If it's really any of your business.", "words": [{"w": " I", "s": 175.56, "e": 175.98}, {"w": " was", "s": 175.98, "e": 176.08}, {"w": " looking", "s": 176.08, "e": 176.26}, {"w": " for", "s": 176.26, "e": 176.42}, {"w": " the", "s": 176.42, "e": 176.54}, {"w": " Doctor.", "s": 176.54, "e": 176.86}, {"w": " If", "s": 177.06, "e": 177.42}, {"w": " it's", "s": 177.42, "e": 177.54}, {"w": " really", "s": 177.54, "e": 177.7}, {"w": " any", "s": 177.7, "e": 177.88}, {"w": " of", "s": 177.88, "e": 178.06}, {"w": " your", "s": 178.06, "e": 178.16}, {"w": " business.", "s": 178.16, "e": 178.56}]}, {"start": 178.56, "end": 181.68, "text": "Well you won't find him in here, he lives at number one Albert Square over there.", "words": [{"w": " Well", "s": 178.56, "e": 179.08}, {"w": " you", "s": 179.08, "e": 179.2}, {"w": " won't", "s": 179.2, "e": 179.32}, {"w": " find", "s": 179.32, "e": 179.56}, {"w": " him", "s": 179.56, "e": 179.7}, {"w": " in", "s": 179.7, "e": 179.78}, {"w": " here,", "s": 179.78, "e": 179.94}, {"w": " he", "s": 179.96, "e": 180.02}, {"w": " lives", "s": 180.02, "e": 180.16}, {"w": " at", "s": 180.16, "e": 180.22}, {"w": " number", "s": 180.22, "e": 180.38}, {"w": " one", "s": 180.38, "e": 180.58}, {"w": " Albert", "s": 180.58, "e": 180.84}, {"w": " Square", "s": 180.84, "e": 181.12}, {"w": " over", "s": 181.12, "e": 181.44}, {"w": " there.", "s": 181.44, "e": 181.68}]}, {"start": 181.82, "end": 182.94, "text": "I suggest you leave.", "words": [{"w": " I", "s": 181.82, "e": 182.22}, {"w": " suggest", "s": 182.22, "e": 182.44}, {"w": " you", "s": 182.44, "e": 182.7}, {"w": " leave.", "s": 182.7, "e": 182.94}]}, {"start": 183.18, "end": 184.1, "text": "You've seen the Doctor?", "words": [{"w": " You've", "s": 183.18, "e": 183.56}, {"w": " seen", "s": 183.56, "e": 183.72}, {"w": " the", "s": 183.72, "e": 183.86}, {"w": " Doctor?", "s": 183.86, "e": 184.1}]}, {"start": 184.32, "end": 186.86, "text": "Yeah, Doctor Legg is the only Doctor around here.", "words": [{"w": " Yeah,", "s": 184.32, "e": 184.8}, {"w": " Doctor", "s": 184.92, "e": 185.66}, {"w": " Legg", "s": 185.66, "e": 185.9}, {"w": " is", "s": 185.9, "e": 185.98}, {"w": " the", "s": 185.98, "e": 186.12}, {"w": " only", "s": 186.12, "e": 186.2}, {"w": " Doctor", "s": 186.2, "e": 186.46}, {"w": " around", "s": 186.46, "e": 186.7}, {"w": " here.", "s": 186.7, "e": 186.86}]}, {"start": 187.44, "end": 188.12, "text": "Doctor who?", "words": [{"w": " Doctor", "s": 187.44, "e": 187.92}, {"w": " who?", "s": 187.92, "e": 188.12}]}, {"start": 201.24, "end": 205.54, "text": "Well I've seen him thrown out of the Vic, but uh, never dragged in.", "words": [{"w": " Well", "s": 201.24, "e": 201.72}, {"w": " I've", "s": 201.72, "e": 201.86}, {"w": " seen", "s": 201.86, "e": 202.04}, {"w": " him", "s": 202.04, "e": 202.16}, {"w": " thrown", "s": 202.16, "e": 202.32}, {"w": " out", "s": 202.32, "e": 202.6}, {"w": " of", "s": 202.6, "e": 202.7}, {"w": " the", "s": 202.7, "e": 202.74}, {"w": " Vic,", "s": 202.74, "e": 203.06}, {"w": " but", "s": 203.1, "e": 203.28}, {"w": " uh,", "s": 203.28, "e": 203.54}, {"w": " never", "s": 203.82, "e": 205.0}, {"w": " dragged", "s": 205.0, "e": 205.28}, {"w": " in.", "s": 205.28, "e": 205.54}]}, {"start": 206.28, "end": 211.58, "text": "I should be taking it easy, not bounding around like some megalothian slime skimmer.", "words": [{"w": " I", "s": 206.28, "e": 206.76}, {"w": " should", "s": 206.76, "e": 206.92}, {"w": " be", "s": 206.92, "e": 207.08}, {"w": " taking", "s": 207.08, "e": 207.32}, {"w": " it", "s": 207.32, "e": 207.56}, {"w": " easy,", "s": 207.56, "e": 207.86}, {"w": " not", "s": 208.02, "e": 208.66}, {"w": " bounding", "s": 208.66, "e": 209.24}, {"w": " around", "s": 209.24, "e": 209.4}, {"w": " like", "s": 209.4, "e": 209.7}, {"w": " some", "s": 209.7, "e": 209.94}, {"w": " megalothian", "s": 209.94, "e": 210.6}, {"w": " slime", "s": 210.6, "e": 211.0}, {"w": " skimmer.", "s": 211.0, "e": 211.58}]}, {"start": 211.78, "end": 213.44, "text": "Who's that terrible woman?", "words": [{"w": " Who's", "s": 211.78, "e": 212.26}, {"w": " that", "s": 212.26, "e": 212.4}, {"w": " terrible", "s": 212.4, "e": 212.92}, {"w": " woman?", "s": 212.92, "e": 213.44}]}, {"start": 214.06, "end": 214.78, "text": "It's the Rani.", "words": [{"w": " It's", "s": 214.06, "e": 214.36}, {"w": " the", "s": 214.36, "e": 214.4}, {"w": " Rani.", "s": 214.4, "e": 214.78}]}, {"start": 215.52, "end": 218.54, "text": "Her handiwork is behind all this confusion and time.", "words": [{"w": " Her", "s": 215.52, "e": 216.0}, {"w": " handiwork", "s": 216.0, "e": 216.48}, {"w": " is", "s": 216.48, "e": 216.72}, {"w": " behind", "s": 216.72, "e": 216.98}, {"w": " all", "s": 216.98, "e": 217.24}, {"w": " this", "s": 217.24, "e": 217.4}, {"w": " confusion", "s": 217.4, "e": 217.86}, {"w": " and", "s": 217.86, "e": 218.16}, {"w": " time.", "s": 218.16, "e": 218.54}]}, {"start": 218.54, "end": 221.48, "text": "And now her control is beginning to break down.", "words": [{"w": " And", "s": 218.54, "e": 219.42}, {"w": " now", "s": 219.42, "e": 219.6}, {"w": " her", "s": 219.6, "e": 219.76}, {"w": " control", "s": 219.76, "e": 220.18}, {"w": " is", "s": 220.18, "e": 220.5}, {"w": " beginning", "s": 220.5, "e": 220.74}, {"w": " to", "s": 220.74, "e": 220.94}, {"w": " break", "s": 220.94, "e": 221.12}, {"w": " down.", "s": 221.12, "e": 221.48}]}, {"start": 222.36, "end": 223.98, "text": "Ah good, there's the TARDIS.", "words": [{"w": " Ah", "s": 222.36, "e": 222.92}, {"w": " good,", "s": 222.92, "e": 223.16}, {"w": " there's", "s": 223.26, "e": 223.52}, {"w": " the", "s": 223.52, "e": 223.52}, {"w": " TARDIS.", "s": 223.52, "e": 223.98}]}, {"start": 224.12, "end": 224.86, "text": "Come on, Victoria.", "words": [{"w": " Come", "s": 224.12, "e": 224.52}, {"w": " on,", "s": 224.52, "e": 224.66}, {"w": " Victoria.", "s": 224.68, "e": 224.86}]}, {"start": 225.4, "end": 237.24, "text": "I see she let you go.", "words": [{"w": " I", "s": 225.4, "e": 225.96}, {"w": " see", "s": 236.3, "e": 236.52}, {"w": " she", "s": 236.52, "e": 236.68}, {"w": " let", "s": 236.68, "e": 236.84}, {"w": " you", "s": 236.84, "e": 236.96}, {"w": " go.", "s": 236.96, "e": 237.24}]}, {"start": 237.48, "end": 239.38, "text": "Not before she cloned me, though.", "words": [{"w": " Not", "s": 237.48, "e": 237.74}, {"w": " before", "s": 237.74, "e": 238.12}, {"w": " she", "s": 238.12, "e": 238.46}, {"w": " cloned", "s": 238.46, "e": 239.04}, {"w": " me,", "s": 239.04, "e": 239.26}, {"w": " though.", "s": 239.26, "e": 239.38}]}, {"start": 239.66, "end": 242.02, "text": "She's got a menagerie of clones in there.", "words": [{"w": " She's", "s": 239.66, "e": 240.22}, {"w": " got", "s": 240.22, "e": 240.34}, {"w": " a", "s": 240.34, "e": 240.46}, {"w": " menagerie", "s": 240.46, "e": 241.1}, {"w": " of", "s": 241.1, "e": 241.2}, {"w": " clones", "s": 241.2, "e": 241.52}, {"w": " in", "s": 241.52, "e": 241.86}, {"w": " there.", "s": 241.86, "e": 242.02}]}, {"start": 242.22, "end": 247.48, "text": "She's attempting to transfer a massive time tunnel to the Greenwich meridian.", "words": [{"w": " She's", "s": 242.22, "e": 242.58}, {"w": " attempting", "s": 242.58, "e": 242.86}, {"w": " to", "s": 242.86, "e": 243.22}, {"w": " transfer", "s": 243.22, "e": 243.6}, {"w": " a", "s": 243.6, "e": 243.88}, {"w": " massive", "s": 243.88, "e": 244.2}, {"w": " time", "s": 244.2, "e": 244.54}, {"w": " tunnel", "s": 244.54, "e": 245.06}, {"w": " to", "s": 245.06, "e": 246.42}, {"w": " the", "s": 246.42, "e": 246.64}, {"w": " Greenwich", "s": 246.64, "e": 246.98}, {"w": " meridian.", "s": 246.98, "e": 247.48}]}, {"start": 248.38, "end": 255.48, "text": "She has a computer in there with genetic codes and brain prints of every living creature in the entire cosmos.", "words": [{"w": " She", "s": 248.38, "e": 248.94}, {"w": " has", "s": 248.94, "e": 249.12}, {"w": " a", "s": 249.12, "e": 249.22}, {"w": " computer", "s": 249.22, "e": 249.62}, {"w": " in", "s": 249.62, "e": 249.86}, {"w": " there", "s": 249.86, "e": 250.06}, {"w": " with", "s": 250.06, "e": 250.62}, {"w": " genetic", "s": 250.62, "e": 251.24}, {"w": " codes", "s": 251.24, "e": 251.72}, {"w": " and", "s": 251.72, "e": 252.32}, {"w": " brain", "s": 252.32, "e": 252.6}, {"w": " prints", "s": 252.6, "e": 252.88}, {"w": " of", "s": 252.88, "e": 253.32}, {"w": " every", "s": 253.32, "e": 253.54}, {"w": " living", "s": 253.54, "e": 253.74}, {"w": " creature", "s": 253.74, "e": 254.12}, {"w": " in", "s": 254.12, "e": 254.34}, {"w": " the", "s": 254.34, "e": 254.44}, {"w": " entire", "s": 254.44, "e": 254.9}, {"w": " cosmos.", "s": 254.9, "e": 255.48}]}, {"start": 255.78, "end": 258.04, "text": "And with it, evolution is hers to control.", "words": [{"w": " And", "s": 255.78, "e": 255.9}, {"w": " with", "s": 255.9, "e": 256.02}, {"w": " it,", "s": 256.02, "e": 256.2}, {"w": " evolution", "s": 256.22, "e": 256.64}, {"w": " is", "s": 256.64, "e": 257.0}, {"w": " hers", "s": 257.0, "e": 257.38}, {"w": " to", "s": 257.38, "e": 257.62}, {"w": " control.", "s": 257.62, "e": 258.04}]}, {"start": 259.16, "end": 264.15, "text": "Except, what form were you in when she cloned you?", "words": [{"w": " Except,", "s": 259.16, "e": 259.68}, {"w": " what", "s": 261.37, "e": 261.89}, {"w": " form", "s": 261.89, "e": 262.27}, {"w": " were", "s": 262.27, "e": 262.49}, {"w": " you", "s": 262.49, "e": 262.57}, {"w": " in", "s": 262.57, "e": 262.85}, {"w": " when", "s": 262.85, "e": 263.59}, {"w": " she", "s": 263.59, "e": 263.71}, {"w": " cloned", "s": 263.71, "e": 263.97}, {"w": " you?", "s": 263.97, "e": 264.15}]}, {"start": 264.21, "end": 265.51, "text": "I think it's very important.", "words": [{"w": " I", "s": 264.21, "e": 264.71}, {"w": " think", "s": 264.71, "e": 264.93}, {"w": " it's", "s": 264.93, "e": 265.11}, {"w": " very", "s": 265.11, "e": 265.21}, {"w": " important.", "s": 265.21, "e": 265.51}]}, {"start": 266.17, "end": 266.69, "text": "Romana.", "words": [{"w": " Romana.", "s": 266.17, "e": 266.69}]}, {"start": 266.89, "end": 267.77, "text": "A time lady.", "words": [{"w": " A", "s": 266.89, "e": 267.41}, {"w": " time", "s": 267.41, "e": 267.53}, {"w": " lady.", "s": 267.53, "e": 267.77}]}, {"start": 267.95, "end": 271.03, "text": "That means there are two time brains in the Rani's computer.", "words": [{"w": " That", "s": 267.95, "e": 268.27}, {"w": " means", "s": 268.27, "e": 268.61}, {"w": " there", "s": 268.61, "e": 269.13}, {"w": " are", "s": 269.13, "e": 269.25}, {"w": " two", "s": 269.25, "e": 269.37}, {"w": " time", "s": 269.37, "e": 269.67}, {"w": " brains", "s": 269.67, "e": 269.91}, {"w": " in", "s": 269.91, "e": 270.39}, {"w": " the", "s": 270.39, "e": 270.45}, {"w": " Rani's", "s": 270.45, "e": 270.77}, {"w": " computer.", "s": 270.77, "e": 271.03}]}, {"start": 276.24, "end": 278.96, "text": "30 seconds to computer achieving full power status, Mistress.", "words": [{"w": " 30", "s": 276.24, "e": 276.76}, {"w": " seconds", "s": 276.76, "e": 277.16}, {"w": " to", "s": 277.16, "e": 277.34}, {"w": " computer", "s": 277.34, "e": 277.52}, {"w": " achieving", "s": 277.52, "e": 277.88}, {"w": " full", "s": 277.88, "e": 278.2}, {"w": " power", "s": 278.2, "e": 278.42}, {"w": " status,", "s": 278.42, "e": 278.74}, {"w": " Mistress.", "s": 278.8, "e": 278.96}]}, {"start": 279.36, "end": 279.88, "text": "Excellent.", "words": [{"w": " Excellent.", "s": 279.36, "e": 279.88}]}, {"start": 280.26, "end": 280.82, "text": "Hold this.", "words": [{"w": " Hold", "s": 280.26, "e": 280.56}, {"w": " this.", "s": 280.56, "e": 280.82}]}, {"start": 280.9, "end": 282.02, "text": "25 seconds, Master.", "words": [{"w": " 25", "s": 280.9, "e": 281.18}, {"w": " seconds,", "s": 281.18, "e": 281.64}, {"w": " Master.", "s": 281.76, "e": 282.02}]}, {"start": 282.16, "end": 289.82, "text": "I'm trying to override the Rani's computer and harness the power of the time tunnel to pull hard TARDIS in and knock me in.", "words": [{"w": " I'm", "s": 282.16, "e": 282.3}, {"w": " trying", "s": 282.3, "e": 282.34}, {"w": " to", "s": 282.34, "e": 282.46}, {"w": " override", "s": 282.46, "e": 282.78}, {"w": " the", "s": 282.78, "e": 283.08}, {"w": " Rani's", "s": 283.08, "e": 283.36}, {"w": " computer", "s": 283.36, "e": 283.68}, {"w": " and", "s": 283.68, "e": 284.98}, {"w": " harness", "s": 284.98, "e": 285.22}, {"w": " the", "s": 285.22, "e": 285.36}, {"w": " power", "s": 285.36, "e": 285.62}, {"w": " of", "s": 285.62, "e": 286.16}, {"w": " the", "s": 286.16, "e": 286.22}, {"w": " time", "s": 286.22, "e": 286.44}, {"w": " tunnel", "s": 286.44, "e": 286.74}, {"w": " to", "s": 286.74, "e": 287.24}, {"w": " pull", "s": 287.24, "e": 287.44}, {"w": " hard", "s": 287.44, "e": 287.8}, {"w": " TARDIS", "s": 287.8, "e": 288.46}, {"w": " in", "s": 288.46, "e": 288.62}, {"w": " and", "s": 288.62, "e": 288.88}, {"w": " knock", "s": 288.88, "e": 289.32}, {"w": " me", "s": 289.32, "e": 289.6}, {"w": " in.", "s": 289.6, "e": 289.82}]}, {"start": 289.94, "end": 291.58, "text": "I assume it's not as easy as it sounds.", "words": [{"w": " I", "s": 289.94, "e": 290.18}, {"w": " assume", "s": 290.18, "e": 290.42}, {"w": " it's", "s": 290.42, "e": 290.64}, {"w": " not", "s": 290.64, "e": 290.78}, {"w": " as", "s": 290.78, "e": 290.86}, {"w": " easy", "s": 290.86, "e": 291.1}, {"w": " as", "s": 291.1, "e": 291.22}, {"w": " it", "s": 291.22, "e": 291.3}, {"w": " sounds.", "s": 291.3, "e": 291.58}]}, {"start": 292.1, "end": 292.6, "text": "Of course not.", "words": [{"w": " Of", "s": 292.1, "e": 292.22}, {"w": " course", "s": 292.22, "e": 292.38}, {"w": " not.", "s": 292.38, "e": 292.6}]}, {"start": 292.86, "end": 293.58, "text": "20 seconds.", "words": [{"w": " 20", "s": 292.86, "e": 293.18}, {"w": " seconds.", "s": 293.18, "e": 293.58}]}, {"start": 294.08, "end": 297.22, "text": "I must try and free my other incarnations.", "words": [{"w": " I", "s": 294.08, "e": 294.08}, {"w": " must", "s": 294.08, "e": 294.12}, {"w": " try", "s": 294.12, "e": 294.36}, {"w": " and", "s": 294.36, "e": 294.82}, {"w": " free", "s": 294.82, "e": 295.26}, {"w": " my", "s": 295.26, "e": 295.74}, {"w": " other", "s": 295.74, "e": 296.02}, {"w": " incarnations.", "s": 296.02, "e": 297.22}]}, {"start": 297.38, "end": 298.0, "text": "Join me.", "words": [{"w": " Join", "s": 297.38, "e": 297.76}, {"w": " me.", "s": 297.76, "e": 298.0}]}, {"start": 298.0, "end": 298.62, "text": "You must have it.", "words": [{"w": " You", "s": 298.0, "e": 298.14}, {"w": " must", "s": 298.14, "e": 298.28}, {"w": " have", "s": 298.28, "e": 298.48}, {"w": " it.", "s": 298.48, "e": 298.62}]}, {"start": 298.82, "end": 299.76, "text": "You must have it.", "words": [{"w": " You", "s": 298.82, "e": 299.08}, {"w": " must", "s": 299.08, "e": 299.44}, {"w": " have", "s": 299.44, "e": 299.6}, {"w": " it.", "s": 299.6, "e": 299.76}]}, {"start": 299.84, "end": 300.64, "text": "Good luck.", "words": [{"w": " Good", "s": 299.84, "e": 300.26}, {"w": " luck.", "s": 300.26, "e": 300.64}]}, {"start": 302.78, "end": 303.62, "text": "Five seconds.", "words": [{"w": " Five", "s": 302.78, "e": 303.26}, {"w": " seconds.", "s": 303.26, "e": 303.62}]}, {"start": 303.94, "end": 304.56, "text": "Okay, nine.", "words": [{"w": " Okay,", "s": 303.94, "e": 304.38}, {"w": " nine.", "s": 304.38, "e": 304.56}]}, {"start": 304.98, "end": 305.88, "text": "Activate the converter.", "words": [{"w": " Activate", "s": 304.98, "e": 305.46}, {"w": " the", "s": 305.46, "e": 305.58}, {"w": " converter.", "s": 305.58, "e": 305.88}]}, {"start": 306.28, "end": 307.48, "text": "Three, two, one.", "words": [{"w": " Three,", "s": 306.28, "e": 306.36}, {"w": " two,", "s": 306.58, "e": 306.9}, {"w": " one.", "s": 307.08, "e": 307.48}]}, {"start": 307.62, "end": 308.08, "text": "Here goes.", "words": [{"w": " Here", "s": 307.62, "e": 307.94}, {"w": " goes.", "s": 307.94, "e": 308.08}]}, {"start": 323.16, "end": 329.24, "text": "Well, there were two time brains in her computer, and I used it to propel her into the trap she set for me.", "words": [{"w": " Well,", "s": 323.16, "e": 323.64}, {"w": " there", "s": 323.64, "e": 324.12}, {"w": " were", "s": 324.12, "e": 324.2}, {"w": " two", "s": 324.2, "e": 324.3}, {"w": " time", "s": 324.3, "e": 324.62}, {"w": " brains", "s": 324.62, "e": 324.86}, {"w": " in", "s": 324.86, "e": 325.14}, {"w": " her", "s": 325.14, "e": 325.18}, {"w": " computer,", "s": 325.18, "e": 325.58}, {"w": " and", "s": 325.68, "e": 326.2}, {"w": " I", "s": 326.2, "e": 326.3}, {"w": " used", "s": 326.3, "e": 326.56}, {"w": " it", "s": 326.56, "e": 326.74}, {"w": " to", "s": 326.74, "e": 327.02}, {"w": " propel", "s": 327.02, "e": 327.4}, {"w": " her", "s": 327.4, "e": 327.46}, {"w": " into", "s": 327.46, "e": 327.74}, {"w": " the", "s": 327.74, "e": 327.9}, {"w": " trap", "s": 327.9, "e": 328.1}, {"w": " she", "s": 328.1, "e": 328.5}, {"w": " set", "s": 328.5, "e": 328.78}, {"w": " for", "s": 328.78, "e": 329.06}, {"w": " me.", "s": 329.06, "e": 329.24}]}, {"start": 329.48, "end": 331.34, "text": "So now your other selves are all free.", "words": [{"w": " So", "s": 329.48, "e": 329.74}, {"w": " now", "s": 329.74, "e": 330.0}, {"w": " your", "s": 330.0, "e": 330.2}, {"w": " other", "s": 330.2, "e": 330.42}, {"w": " selves", "s": 330.42, "e": 330.7}, {"w": " are", "s": 330.7, "e": 330.88}, {"w": " all", "s": 330.88, "e": 331.02}, {"w": " free.", "s": 331.02, "e": 331.34}]}, {"start": 331.44, "end": 331.76, "text": "Certainly.", "words": [{"w": " Certainly.", "s": 331.44, "e": 331.76}]}, {"start": 331.76, "end": 334.22, "text": "I mean, we are difficult to get rid of.", "words": [{"w": " I", "s": 331.76, "e": 331.98}, {"w": " mean,", "s": 331.98, "e": 332.2}, {"w": " we", "s": 332.24, "e": 332.44}, {"w": " are", "s": 332.44, "e": 332.92}, {"w": " difficult", "s": 332.92, "e": 333.56}, {"w": " to", "s": 333.56, "e": 333.78}, {"w": " get", "s": 333.78, "e": 333.84}, {"w": " rid", "s": 333.84, "e": 334.06}, {"w": " of.", "s": 334.06, "e": 334.22}]}, {"start": 336.28, "end": 336.38, "text": "You're right.", "words": [{"w": " You're", "s": 336.28, "e": 336.38}, {"w": " right.", "s": 336.38, "e": 336.38}]}]