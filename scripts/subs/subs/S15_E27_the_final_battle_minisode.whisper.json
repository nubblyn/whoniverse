[{"start": 0.56, "end": 73.7, "text": "I'm instructed to give you this. A Wayfinder, my lady. An escape from this hell.", "words": [{"w": " I'm", "s": 0.56, "e": 0.82}, {"w": " instructed", "s": 68.44, "e": 68.68}, {"w": " to", "s": 68.68, "e": 68.94}, {"w": " give", "s": 68.94, "e": 69.08}, {"w": " you", "s": 69.08, "e": 69.2}, {"w": " this.", "s": 69.2, "e": 69.4}, {"w": " A", "s": 70.28, "e": 70.8}, {"w": " Wayfinder,", "s": 70.8, "e": 71.3}, {"w": " my", "s": 71.38, "e": 71.52}, {"w": " lady.", "s": 71.52, "e": 71.7}, {"w": " An", "s": 72.28, "e": 72.8}, {"w": " escape", "s": 72.8, "e": 73.06}, {"w": " from", "s": 73.06, "e": 73.32}, {"w": " this", "s": 73.32, "e": 73.46}, {"w": " hell.", "s": 73.46, "e": 73.7}]}, {"start": 73.94, "end": 76.94, "text": "Escape to where? Only you can decide that.", "words": [{"w": " Escape", "s": 73.94, "e": 74.46}, {"w": " to", "s": 74.46, "e": 74.78}, {"w": " where?", "s": 74.78, "e": 75.04}, {"w": " Only", "s": 75.38, "e": 75.86}, {"w": " you", "s": 75.86, "e": 76.16}, {"w": " can", "s": 76.16, "e": 76.36}, {"w": " decide", "s": 76.36, "e": 76.7}, {"w": " that.", "s": 76.7, "e": 76.94}]}, {"start": 78.75, "end": 86.03, "text": "I do not run from battle or cower from machines. It is his wish, my lady, that you survive.", "words": [{"w": " I", "s": 78.75, "e": 79.27}, {"w": " do", "s": 79.27, "e": 79.39}, {"w": " not", "s": 79.39, "e": 79.61}, {"w": " run", "s": 79.61, "e": 79.83}, {"w": " from", "s": 79.83, "e": 80.13}, {"w": " battle", "s": 80.13, "e": 80.49}, {"w": " or", "s": 80.49, "e": 81.65}, {"w": " cower", "s": 81.65, "e": 82.07}, {"w": " from", "s": 82.07, "e": 82.37}, {"w": " machines.", "s": 82.37, "e": 82.69}, {"w": " It", "s": 83.15, "e": 83.47}, {"w": " is", "s": 83.47, "e": 83.59}, {"w": " his", "s": 83.59, "e": 83.73}, {"w": " wish,", "s": 83.73, "e": 84.17}, {"w": " my", "s": 84.21, "e": 84.37}, {"w": " lady,", "s": 84.37, "e": 84.61}, {"w": " that", "s": 84.71, "e": 85.51}, {"w": " you", "s": 85.51, "e": 85.69}, {"w": " survive.", "s": 85.69, "e": 86.03}]}, {"start": 87.17, "end": 98.31, "text": "Whose wish? The Doctor. The Doctor is waging war.", "words": [{"w": " Whose", "s": 87.17, "e": 87.69}, {"w": " wish?", "s": 87.69, "e": 88.01}, {"w": " The", "s": 90.07, "e": 90.59}, {"w": " Doctor.", "s": 90.59, "e": 90.87}, {"w": " The", "s": 91.05, "e": 91.53}, {"w": " Doctor", "s": 97.39, "e": 97.59}, {"w": " is", "s": 97.59, "e": 97.77}, {"w": " waging", "s": 97.77, "e": 98.05}, {"w": " war.", "s": 98.05, "e": 98.31}]}, {"start": 98.49, "end": 102.15, "text": "The end is coming and you are his only hope for the future.", "words": [{"w": " The", "s": 98.49, "e": 99.01}, {"w": " end", "s": 99.01, "e": 99.23}, {"w": " is", "s": 99.23, "e": 99.39}, {"w": " coming", "s": 99.39, "e": 99.67}, {"w": " and", "s": 99.67, "e": 99.89}, {"w": " you", "s": 99.89, "e": 100.15}, {"w": " are", "s": 100.15, "e": 100.61}, {"w": " his", "s": 100.61, "e": 100.85}, {"w": " only", "s": 100.85, "e": 101.15}, {"w": " hope", "s": 101.15, "e": 101.57}, {"w": " for", "s": 101.57, "e": 101.75}, {"w": " the", "s": 101.75, "e": 101.83}, {"w": " future.", "s": 101.83, "e": 102.15}]}, {"start": 102.15, "end": 106.83, "text": "My lady, I beg of you. Activate the Wayfinder. Escape.", "words": [{"w": " My", "s": 102.15, "e": 103.47}, {"w": " lady,", "s": 103.47, "e": 103.69}, {"w": " I", "s": 103.75, "e": 103.83}, {"w": " beg", "s": 103.83, "e": 104.01}, {"w": " of", "s": 104.01, "e": 104.13}, {"w": " you.", "s": 104.13, "e": 104.21}, {"w": " Activate", "s": 104.65, "e": 105.49}, {"w": " the", "s": 105.49, "e": 105.57}, {"w": " Wayfinder.", "s": 105.57, "e": 105.97}, {"w": " Escape.", "s": 106.21, "e": 106.83}]}, {"start": 107.83, "end": 133.88, "text": "Alex R. Victorious. You are wrong.", "words": [{"w": " Alex", "s": 107.83, "e": 108.67}, {"w": " R.", "s": 130.56, "e": 131.02}, {"w": " Victorious.", "s": 131.26, "e": 132.1}, {"w": " You", "s": 132.52, "e": 133.1}, {"w": " are", "s": 133.1, "e": 133.36}, {"w": " wrong.", "s": 133.36, "e": 133.88}]}, {"start": 135.46, "end": 138.58, "text": "Identify. Identify. I am Leela.", "words": [{"w": " Identify.", "s": 135.46, "e": 136.3}, {"w": " Identify.", "s": 136.3, "e": 137.14}, {"w": " I", "s": 137.22, "e": 137.82}, {"w": " am", "s": 137.82, "e": 138.08}, {"w": " Leela.", "s": 138.08, "e": 138.58}]}, {"start": 139.54, "end": 145.52, "text": "Warrior of the Seveteen and of Gallifrey. Friend of the Doctor.", "words": [{"w": " Warrior", "s": 139.54, "e": 140.38}, {"w": " of", "s": 140.38, "e": 140.88}, {"w": " the", "s": 140.88, "e": 141.02}, {"w": " Seveteen", "s": 141.02, "e": 141.7}, {"w": " and", "s": 141.7, "e": 141.92}, {"w": " of", "s": 141.92, "e": 142.2}, {"w": " Gallifrey.", "s": 142.2, "e": 142.76}, {"w": " Friend", "s": 143.6, "e": 144.44}, {"w": " of", "s": 144.44, "e": 144.8}, {"w": " the", "s": 144.8, "e": 145.08}, {"w": " Doctor.", "s": 145.08, "e": 145.52}]}, {"start": 147.16, "end": 152.24, "text": "While we live, your victory is short-lived.", "words": [{"w": " While", "s": 147.16, "e": 147.58}, {"w": " we", "s": 147.58, "e": 147.88}, {"w": " live,", "s": 147.88, "e": 148.32}, {"w": " your", "s": 148.58, "e": 149.84}, {"w": " victory", "s": 149.84, "e": 150.56}, {"w": " is", "s": 150.56, "e": 151.08}, {"w": " short", "s": 151.08, "e": 151.64}, {"w": "-lived.", "s": 151.64, "e": 152.24}]}, {"start": 152.98, "end": 153.82, "text": "Yorkshire.", "words": [{"w": " Yorkshire.", "s": 152.98, "e": 153.82}]}, {"start": 154.04, "end": 158.5, "text": "Statements are meaningless. The Doctor will be destroyed.", "words": [{"w": " Statements", "s": 154.04, "e": 154.58}, {"w": " are", "s": 154.58, "e": 154.78}, {"w": " meaningless.", "s": 154.78, "e": 155.56}, {"w": " The", "s": 156.08, "e": 156.46}, {"w": " Doctor", "s": 156.46, "e": 156.86}, {"w": " will", "s": 156.86, "e": 157.34}, {"w": " be", "s": 157.34, "e": 157.74}, {"w": " destroyed.", "s": 157.74, "e": 158.5}]}, {"start": 159.31, "end": 163.3, "text": "His Acolytes will be exterminated.", "words": [{"w": " His", "s": 159.31, "e": 159.78}, {"w": " Acolytes", "s": 159.78, "e": 160.9}, {"w": " will", "s": 160.9, "e": 161.16}, {"w": " be", "s": 161.16, "e": 161.48}, {"w": " exterminated.", "s": 161.48, "e": 163.3}]}, {"start": 163.78, "end": 166.46, "text": "That is not how this ends.", "words": [{"w": " That", "s": 163.78, "e": 164.4}, {"w": " is", "s": 164.4, "e": 164.66}, {"w": " not", "s": 164.66, "e": 165.08}, {"w": " how", "s": 165.08, "e": 165.5}, {"w": " this", "s": 165.5, "e": 165.9}, {"w": " ends.", "s": 165.9, "e": 166.46}]}, {"start": 171.66, "end": 174.69, "text": "Device detected. Exterminate.", "words": [{"w": " Device", "s": 171.66, "e": 172.13}, {"w": " detected.", "s": 172.13, "e": 172.85}, {"w": " Exterminate.", "s": 173.75, "e": 174.69}]}]