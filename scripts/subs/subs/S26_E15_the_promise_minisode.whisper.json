[{"start": 17.42, "end": 18.76, "text": "It's been 30 years.", "words": [{"w": " It's", "s": 17.42, "e": 17.82}, {"w": " been", "s": 17.82, "e": 17.98}, {"w": " 30", "s": 17.98, "e": 18.32}, {"w": " years.", "s": 18.32, "e": 18.76}]}, {"start": 20.28, "end": 22.18, "text": "I was just a kid when I met him.", "words": [{"w": " I", "s": 20.28, "e": 20.92}, {"w": " was", "s": 20.92, "e": 21.06}, {"w": " just", "s": 21.06, "e": 21.26}, {"w": " a", "s": 21.26, "e": 21.38}, {"w": " kid", "s": 21.38, "e": 21.56}, {"w": " when", "s": 21.56, "e": 21.7}, {"w": " I", "s": 21.7, "e": 21.8}, {"w": " met", "s": 21.8, "e": 21.96}, {"w": " him.", "s": 21.96, "e": 22.18}]}, {"start": 22.6, "end": 24.38, "text": "Thought I knew it all, but...", "words": [{"w": " Thought", "s": 22.6, "e": 23.24}, {"w": " I", "s": 23.24, "e": 23.46}, {"w": " knew", "s": 23.46, "e": 23.6}, {"w": " it", "s": 23.6, "e": 23.72}, {"w": " all,", "s": 23.72, "e": 23.94}, {"w": " but...", "s": 24.06, "e": 24.38}]}, {"start": 25.3, "end": 27.04, "text": "Then he showed me the universe.", "words": [{"w": " Then", "s": 25.3, "e": 25.94}, {"w": " he", "s": 25.94, "e": 26.14}, {"w": " showed", "s": 26.14, "e": 26.4}, {"w": " me", "s": 26.4, "e": 26.6}, {"w": " the", "s": 26.6, "e": 26.72}, {"w": " universe.", "s": 26.72, "e": 27.04}]}, {"start": 28.18, "end": 29.68, "text": "He showed me adventure.", "words": [{"w": " He", "s": 28.18, "e": 28.82}, {"w": " showed", "s": 28.82, "e": 29.08}, {"w": " me", "s": 29.08, "e": 29.26}, {"w": " adventure.", "s": 29.26, "e": 29.68}]}, {"start": 31.82, "end": 33.22, "text": "We fought injustice.", "words": [{"w": " We", "s": 31.82, "e": 32.46}, {"w": " fought", "s": 32.46, "e": 32.82}, {"w": " injustice.", "s": 32.82, "e": 33.22}]}, {"start": 35.04, "end": 36.02, "text": "Confronted danger.", "words": [{"w": " Confronted", "s": 35.04, "e": 35.68}, {"w": " danger.", "s": 35.68, "e": 36.02}]}, {"start": 37.14, "end": 38.24, "text": "Met heroes.", "words": [{"w": " Met", "s": 37.14, "e": 37.78}, {"w": " heroes.", "s": 37.78, "e": 38.24}]}, {"start": 39.82, "end": 40.86, "text": "And villains.", "words": [{"w": " And", "s": 39.82, "e": 40.46}, {"w": " villains.", "s": 40.46, "e": 40.86}]}, {"start": 43.45, "end": 47.66, "text": "Friends and foes.", "words": [{"w": " Friends", "s": 43.45, "e": 43.77}, {"w": " and", "s": 43.77, "e": 44.29}, {"w": " foes.", "s": 46.5, "e": 47.66}]}, {"start": 48.8, "end": 49.44, "text": "Comrades.", "words": [{"w": " Comrades.", "s": 48.8, "e": 49.44}]}, {"start": 51.18, "end": 51.82, "text": "Enemies.", "words": [{"w": " Enemies.", "s": 51.18, "e": 51.82}]}, {"start": 54.88, "end": 56.46, "text": "Knights from another dimension.", "words": [{"w": " Knights", "s": 54.88, "e": 55.34}, {"w": " from", "s": 55.34, "e": 55.66}, {"w": " another", "s": 55.66, "e": 55.94}, {"w": " dimension.", "s": 55.94, "e": 56.46}]}, {"start": 58.36, "end": 59.62, "text": "Ghosts from the past.", "words": [{"w": " Ghosts", "s": 58.36, "e": 59.02}, {"w": " from", "s": 59.02, "e": 59.1}, {"w": " the", "s": 59.1, "e": 59.26}, {"w": " past.", "s": 59.26, "e": 59.62}]}, {"start": 59.98, "end": 61.86, "text": "And horrors from the future.", "words": [{"w": " And", "s": 59.98, "e": 60.64}, {"w": " horrors", "s": 60.64, "e": 61.16}, {"w": " from", "s": 61.16, "e": 61.34}, {"w": " the", "s": 61.34, "e": 61.48}, {"w": " future.", "s": 61.48, "e": 61.86}]}, {"start": 63.52, "end": 64.18, "text": "Hunters.", "words": [{"w": " Hunters.", "s": 63.52, "e": 64.18}]}, {"start": 66.1, "end": 66.76, "text": "Survivors.", "words": [{"w": " Survivors.", "s": 66.1, "e": 66.76}]}, {"start": 69.38, "end": 70.04, "text": "Monsters.", "words": [{"w": " Monsters.", "s": 69.38, "e": 70.04}]}, {"start": 72.85, "end": 74.15, "text": "Destroyers of worlds.", "words": [{"w": " Destroyers", "s": 72.85, "e": 73.51}, {"w": " of", "s": 73.51, "e": 73.69}, {"w": " worlds.", "s": 73.69, "e": 74.15}]}, {"start": 75.35, "end": 77.73, "text": "And evil from the dawn of time.", "words": [{"w": " And", "s": 75.35, "e": 76.01}, {"w": " evil", "s": 76.01, "e": 76.35}, {"w": " from", "s": 76.35, "e": 76.75}, {"w": " the", "s": 76.75, "e": 76.89}, {"w": " dawn", "s": 76.89, "e": 77.17}, {"w": " of", "s": 77.17, "e": 77.35}, {"w": " time.", "s": 77.35, "e": 77.73}]}, {"start": 79.27, "end": 81.33, "text": "He challenged and empowered me.", "words": [{"w": " He", "s": 79.27, "e": 79.93}, {"w": " challenged", "s": 79.93, "e": 80.39}, {"w": " and", "s": 80.39, "e": 80.67}, {"w": " empowered", "s": 80.67, "e": 81.07}, {"w": " me.", "s": 81.07, "e": 81.33}]}, {"start": 82.21, "end": 84.01, "text": "Helped me realize my potential.", "words": [{"w": " Helped", "s": 82.21, "e": 82.87}, {"w": " me", "s": 82.87, "e": 83.03}, {"w": " realize", "s": 83.03, "e": 83.41}, {"w": " my", "s": 83.41, "e": 83.67}, {"w": " potential.", "s": 83.67, "e": 84.01}]}, {"start": 86.12, "end": 86.93, "text": "We were a team.", "words": [{"w": " We", "s": 86.12, "e": 86.45}, {"w": " were", "s": 86.45, "e": 86.57}, {"w": " a", "s": 86.57, "e": 86.69}, {"w": " team.", "s": 86.69, "e": 86.93}]}, {"start": 87.29, "end": 92.89, "text": "Doctor and TARDIS.", "words": [{"w": " Doctor", "s": 87.29, "e": 87.95}, {"w": " and", "s": 92.49, "e": 92.79}, {"w": " TARDIS.", "s": 92.79, "e": 92.89}]}, {"start": 92.91, "end": 94.77, "text": "Out saving the universe.", "words": [{"w": " Out", "s": 92.91, "e": 93.67}, {"w": " saving", "s": 93.67, "e": 94.15}, {"w": " the", "s": 94.15, "e": 94.43}, {"w": " universe.", "s": 94.43, "e": 94.77}]}, {"start": 96.47, "end": 96.95, "text": "Then...", "words": [{"w": " Then...", "s": 96.47, "e": 96.95}]}, {"start": 96.95, "end": 98.35, "text": "He let me go.", "words": [{"w": " He", "s": 96.95, "e": 97.73}, {"w": " let", "s": 97.73, "e": 97.97}, {"w": " me", "s": 97.97, "e": 98.13}, {"w": " go.", "s": 98.13, "e": 98.35}]}, {"start": 99.43, "end": 101.61, "text": "So I could make this world a better place.", "words": [{"w": " So", "s": 99.43, "e": 99.91}, {"w": " I", "s": 99.91, "e": 100.09}, {"w": " could", "s": 100.09, "e": 100.23}, {"w": " make", "s": 100.23, "e": 100.39}, {"w": " this", "s": 100.39, "e": 100.61}, {"w": " world", "s": 100.61, "e": 100.89}, {"w": " a", "s": 100.89, "e": 101.03}, {"w": " better", "s": 101.03, "e": 101.19}, {"w": " place.", "s": 101.19, "e": 101.61}]}, {"start": 101.87, "end": 104.83, "text": "I love what I do now.", "words": [{"w": " I", "s": 101.87, "e": 102.35}, {"w": " love", "s": 103.73, "e": 104.05}, {"w": " what", "s": 104.05, "e": 104.25}, {"w": " I", "s": 104.25, "e": 104.43}, {"w": " do", "s": 104.43, "e": 104.61}, {"w": " now.", "s": 104.61, "e": 104.83}]}, {"start": 105.23, "end": 108.02, "text": "But sometimes...", "words": [{"w": " But", "s": 105.23, "e": 105.71}, {"w": " sometimes...", "s": 107.08, "e": 108.02}]}, {"start": 108.54, "end": 110.14, "text": "I stand at this window.", "words": [{"w": " I", "s": 108.54, "e": 109.02}, {"w": " stand", "s": 109.02, "e": 109.42}, {"w": " at", "s": 109.42, "e": 109.64}, {"w": " this", "s": 109.64, "e": 109.78}, {"w": " window.", "s": 109.78, "e": 110.14}]}, {"start": 111.02, "end": 112.08, "text": "And look for him.", "words": [{"w": " And", "s": 111.02, "e": 111.5}, {"w": " look", "s": 111.5, "e": 111.68}, {"w": " for", "s": 111.68, "e": 111.88}, {"w": " him.", "s": 111.88, "e": 112.08}]}, {"start": 112.5, "end": 121.76, "text": "Because he left with a promise.", "words": [{"w": " Because", "s": 112.5, "e": 112.98}, {"w": " he", "s": 120.7, "e": 120.86}, {"w": " left", "s": 120.86, "e": 121.1}, {"w": " with", "s": 121.1, "e": 121.34}, {"w": " a", "s": 121.34, "e": 121.42}, {"w": " promise.", "s": 121.42, "e": 121.76}]}, {"start": 122.24, "end": 126.09, "text": "That one day...", "words": [{"w": " That", "s": 122.24, "e": 122.72}, {"w": " one", "s": 125.21, "e": 125.39}, {"w": " day...", "s": 125.39, "e": 126.09}]}, {"start": 126.97, "end": 127.93, "text": "He'd be back.", "words": [{"w": " He'd", "s": 126.97, "e": 127.45}, {"w": " be", "s": 127.45, "e": 127.59}, {"w": " back.", "s": 127.59, "e": 127.93}]}, {"start": 128.43, "end": 128.91, "text": "Wicked.", "words": [{"w": " Wicked.", "s": 128.43, "e": 128.91}]}]