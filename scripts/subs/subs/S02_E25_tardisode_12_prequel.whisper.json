[{"start": 4.75, "end": 8.63, "text": "This is a story of the century. The story of Torchwood.", "words": [{"w": " This", "s": 4.75, "e": 5.09}, {"w": " is", "s": 5.09, "e": 5.21}, {"w": " a", "s": 5.21, "e": 5.33}, {"w": " story", "s": 5.33, "e": 5.79}, {"w": " of", "s": 5.79, "e": 6.03}, {"w": " the", "s": 6.03, "e": 6.11}, {"w": " century.", "s": 6.11, "e": 6.51}, {"w": " The", "s": 7.21, "e": 7.69}, {"w": " story", "s": 7.69, "e": 8.03}, {"w": " of", "s": 8.03, "e": 8.15}, {"w": " Torchwood.", "s": 8.15, "e": 8.63}]}, {"start": 9.63, "end": 10.67, "text": "So get it for me.", "words": [{"w": " So", "s": 9.63, "e": 10.11}, {"w": " get", "s": 10.11, "e": 10.29}, {"w": " it", "s": 10.29, "e": 10.41}, {"w": " for", "s": 10.41, "e": 10.53}, {"w": " me.", "s": 10.53, "e": 10.67}]}, {"start": 11.69, "end": 15.73, "text": "I've got contacts. People out there who knew someone who knew someone else.", "words": [{"w": " I've", "s": 11.69, "e": 12.17}, {"w": " got", "s": 12.17, "e": 12.31}, {"w": " contacts.", "s": 12.31, "e": 12.73}, {"w": " People", "s": 13.23, "e": 13.71}, {"w": " out", "s": 13.71, "e": 13.97}, {"w": " there", "s": 13.97, "e": 14.19}, {"w": " who", "s": 14.19, "e": 14.33}, {"w": " knew", "s": 14.33, "e": 14.53}, {"w": " someone", "s": 14.53, "e": 14.85}, {"w": " who", "s": 14.85, "e": 15.03}, {"w": " knew", "s": 15.03, "e": 15.17}, {"w": " someone", "s": 15.17, "e": 15.45}, {"w": " else.", "s": 15.45, "e": 15.73}]}, {"start": 16.03, "end": 23.49, "text": "And when you put it all together, it goes way back to Queen Victoria's time, right up to the explosion on Christmas Day.", "words": [{"w": " And", "s": 16.03, "e": 16.51}, {"w": " when", "s": 16.51, "e": 16.65}, {"w": " you", "s": 16.65, "e": 16.77}, {"w": " put", "s": 16.77, "e": 16.93}, {"w": " it", "s": 16.93, "e": 17.03}, {"w": " all", "s": 17.03, "e": 17.15}, {"w": " together,", "s": 17.15, "e": 17.45}, {"w": " it", "s": 17.75, "e": 18.55}, {"w": " goes", "s": 18.55, "e": 19.03}, {"w": " way", "s": 19.03, "e": 19.25}, {"w": " back", "s": 19.25, "e": 19.51}, {"w": " to", "s": 19.51, "e": 20.15}, {"w": " Queen", "s": 20.15, "e": 20.39}, {"w": " Victoria's", "s": 20.39, "e": 21.03}, {"w": " time,", "s": 21.03, "e": 21.27}, {"w": " right", "s": 21.33, "e": 21.53}, {"w": " up", "s": 21.53, "e": 21.77}, {"w": " to", "s": 21.77, "e": 21.95}, {"w": " the", "s": 21.95, "e": 22.01}, {"w": " explosion", "s": 22.01, "e": 22.49}, {"w": " on", "s": 22.49, "e": 22.81}, {"w": " Christmas", "s": 22.81, "e": 23.09}, {"w": " Day.", "s": 23.09, "e": 23.49}]}, {"start": 24.01, "end": 26.25, "text": "And I think they're connected to the ghosts.", "words": [{"w": " And", "s": 24.01, "e": 24.49}, {"w": " I", "s": 24.49, "e": 24.67}, {"w": " think", "s": 24.67, "e": 24.87}, {"w": " they're", "s": 24.87, "e": 25.15}, {"w": " connected", "s": 25.15, "e": 25.41}, {"w": " to", "s": 25.41, "e": 25.81}, {"w": " the", "s": 25.81, "e": 25.93}, {"w": " ghosts.", "s": 25.93, "e": 26.25}]}, {"start": 27.73, "end": 28.87, "text": "This is remarkable.", "words": [{"w": " This", "s": 27.73, "e": 28.21}, {"w": " is", "s": 28.21, "e": 28.41}, {"w": " remarkable.", "s": 28.41, "e": 28.87}]}, {"start": 29.49, "end": 32.91, "text": "We need to get it out tomorrow, front page, before they get on to me.", "words": [{"w": " We", "s": 29.49, "e": 29.73}, {"w": " need", "s": 29.73, "e": 29.87}, {"w": " to", "s": 29.87, "e": 29.97}, {"w": " get", "s": 29.97, "e": 30.05}, {"w": " it", "s": 30.05, "e": 30.13}, {"w": " out", "s": 30.13, "e": 30.31}, {"w": " tomorrow,", "s": 30.31, "e": 30.69}, {"w": " front", "s": 30.97, "e": 31.25}, {"w": " page,", "s": 31.25, "e": 31.53}, {"w": " before", "s": 31.73, "e": 32.31}, {"w": " they", "s": 32.31, "e": 32.45}, {"w": " get", "s": 32.45, "e": 32.55}, {"w": " on", "s": 32.55, "e": 32.67}, {"w": " to", "s": 32.67, "e": 32.79}, {"w": " me.", "s": 32.79, "e": 32.91}]}, {"start": 32.91, "end": 34.73, "text": "There's been a complication.", "words": [{"w": " There's", "s": 32.91, "e": 33.35}, {"w": " been", "s": 33.35, "e": 33.71}, {"w": " a", "s": 33.71, "e": 33.97}, {"w": " complication.", "s": 33.97, "e": 34.73}]}, {"start": 34.91, "end": 37.19, "text": "Come on, sir, don't make this difficult.", "words": [{"w": " Come", "s": 34.91, "e": 35.45}, {"w": " on,", "s": 35.45, "e": 35.73}, {"w": " sir,", "s": 35.83, "e": 36.15}, {"w": " don't", "s": 36.27, "e": 36.63}, {"w": " make", "s": 36.63, "e": 36.69}, {"w": " this", "s": 36.69, "e": 36.93}, {"w": " difficult.", "s": 36.93, "e": 37.19}]}, {"start": 38.15, "end": 40.29, "text": "Torture appreciates your loyalty, madam.", "words": [{"w": " Torture", "s": 38.15, "e": 38.83}, {"w": " appreciates", "s": 38.83, "e": 39.35}, {"w": " your", "s": 39.35, "e": 39.43}, {"w": " loyalty,", "s": 39.43, "e": 39.87}, {"w": " madam.", "s": 40.07, "e": 40.29}]}, {"start": 40.93, "end": 42.13, "text": "Your new front page.", "words": [{"w": " Your", "s": 40.93, "e": 41.27}, {"w": " new", "s": 41.27, "e": 41.43}, {"w": " front", "s": 41.43, "e": 41.67}, {"w": " page.", "s": 41.67, "e": 42.13}]}, {"start": 42.85, "end": 44.89, "text": "Pretty girls get exam results.", "words": [{"w": " Pretty", "s": 42.85, "e": 43.19}, {"w": " girls", "s": 43.19, "e": 43.61}, {"w": " get", "s": 43.61, "e": 44.19}, {"w": " exam", "s": 44.19, "e": 44.53}, {"w": " results.", "s": 44.53, "e": 44.89}]}, {"start": 45.39, "end": 47.41, "text": "I'm not mad. It's all what exists.", "words": [{"w": " I'm", "s": 45.39, "e": 45.73}, {"w": " not", "s": 45.73, "e": 45.85}, {"w": " mad.", "s": 45.85, "e": 46.21}, {"w": " It's", "s": 46.53, "e": 46.87}, {"w": " all", "s": 46.87, "e": 46.87}, {"w": " what", "s": 46.87, "e": 47.07}, {"w": " exists.", "s": 47.07, "e": 47.41}]}, {"start": 48.13, "end": 50.01, "text": "Another joke about the ghosts!", "words": [{"w": " Another", "s": 48.13, "e": 48.81}, {"w": " joke", "s": 48.81, "e": 49.21}, {"w": " about", "s": 49.21, "e": 49.47}, {"w": " the", "s": 49.47, "e": 49.71}, {"w": " ghosts!", "s": 49.71, "e": 50.01}]}]