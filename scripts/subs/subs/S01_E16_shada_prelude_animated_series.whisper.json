[{"start": 32.05, "end": 34.25, "text": "What is it now? Yes?", "words": [{"w": " What", "s": 32.05, "e": 32.15}, {"w": " is", "s": 32.15, "e": 32.33}, {"w": " it", "s": 32.33, "e": 32.45}, {"w": " now?", "s": 32.45, "e": 32.73}, {"w": " Yes?", "s": 33.83, "e": 34.25}]}, {"start": 35.75, "end": 38.81, "text": "Romana, how are you? And is that K-9?", "words": [{"w": " Romana,", "s": 35.75, "e": 36.17}, {"w": " how", "s": 36.17, "e": 36.59}, {"w": " are", "s": 36.59, "e": 36.85}, {"w": " you?", "s": 36.85, "e": 37.11}, {"w": " And", "s": 37.65, "e": 38.07}, {"w": " is", "s": 38.07, "e": 38.19}, {"w": " that", "s": 38.19, "e": 38.31}, {"w": " K", "s": 38.31, "e": 38.45}, {"w": "-9?", "s": 38.45, "e": 38.81}]}, {"start": 39.27, "end": 39.69, "text": "Master.", "words": [{"w": " Master.", "s": 39.27, "e": 39.69}]}, {"start": 39.89, "end": 42.31, "text": "You haven't aged a bit, not a speck of rust.", "words": [{"w": " You", "s": 39.89, "e": 40.31}, {"w": " haven't", "s": 40.31, "e": 40.59}, {"w": " aged", "s": 40.59, "e": 40.73}, {"w": " a", "s": 40.73, "e": 40.93}, {"w": " bit,", "s": 40.93, "e": 41.21}, {"w": " not", "s": 41.35, "e": 41.53}, {"w": " a", "s": 41.53, "e": 41.69}, {"w": " speck", "s": 41.69, "e": 41.97}, {"w": " of", "s": 41.97, "e": 42.09}, {"w": " rust.", "s": 42.09, "e": 42.31}]}, {"start": 42.51, "end": 43.49, "text": "Thank you, Doctor.", "words": [{"w": " Thank", "s": 42.51, "e": 42.85}, {"w": " you,", "s": 42.85, "e": 43.15}, {"w": " Doctor.", "s": 43.17, "e": 43.49}]}, {"start": 44.65, "end": 48.69, "text": "Nice rooms you have here, Romana. Sorry, Madam President Romana.", "words": [{"w": " Nice", "s": 44.65, "e": 45.07}, {"w": " rooms", "s": 45.07, "e": 45.49}, {"w": " you", "s": 45.49, "e": 45.91}, {"w": " have", "s": 45.91, "e": 46.11}, {"w": " here,", "s": 46.11, "e": 46.27}, {"w": " Romana.", "s": 46.35, "e": 46.67}, {"w": " Sorry,", "s": 46.83, "e": 47.25}, {"w": " Madam", "s": 47.35, "e": 47.57}, {"w": " President", "s": 47.57, "e": 48.09}, {"w": " Romana.", "s": 48.09, "e": 48.69}]}, {"start": 49.61, "end": 52.61, "text": "Dark and mysterious, Gallifrey at its most typical.", "words": [{"w": " Dark", "s": 49.61, "e": 50.03}, {"w": " and", "s": 50.03, "e": 50.25}, {"w": " mysterious,", "s": 50.25, "e": 50.77}, {"w": " Gallifrey", "s": 51.25, "e": 51.77}, {"w": " at", "s": 51.77, "e": 51.91}, {"w": " its", "s": 51.91, "e": 52.03}, {"w": " most", "s": 52.03, "e": 52.15}, {"w": " typical.", "s": 52.15, "e": 52.61}]}, {"start": 53.27, "end": 55.35, "text": "What do the Time Lords have against pastels?", "words": [{"w": " What", "s": 53.27, "e": 53.69}, {"w": " do", "s": 53.69, "e": 53.81}, {"w": " the", "s": 53.81, "e": 53.97}, {"w": " Time", "s": 53.97, "e": 54.19}, {"w": " Lords", "s": 54.19, "e": 54.35}, {"w": " have", "s": 54.35, "e": 54.53}, {"w": " against", "s": 54.53, "e": 54.75}, {"w": " pastels?", "s": 54.75, "e": 55.35}]}, {"start": 55.61, "end": 60.01, "text": "Doctor, delighted as I am to see you. And I like the new body, by the way.", "words": [{"w": " Doctor,", "s": 55.61, "e": 56.03}, {"w": " delighted", "s": 56.21, "e": 56.81}, {"w": " as", "s": 56.81, "e": 57.05}, {"w": " I", "s": 57.05, "e": 57.17}, {"w": " am", "s": 57.17, "e": 57.33}, {"w": " to", "s": 57.33, "e": 57.47}, {"w": " see", "s": 57.47, "e": 57.65}, {"w": " you.", "s": 57.65, "e": 57.83}, {"w": " And", "s": 58.13, "e": 58.55}, {"w": " I", "s": 58.55, "e": 58.63}, {"w": " like", "s": 58.63, "e": 58.89}, {"w": " the", "s": 58.89, "e": 59.01}, {"w": " new", "s": 59.01, "e": 59.13}, {"w": " body,", "s": 59.13, "e": 59.45}, {"w": " by", "s": 59.55, "e": 59.69}, {"w": " the", "s": 59.69, "e": 59.81}, {"w": " way.", "s": 59.81, "e": 60.01}]}, {"start": 60.61, "end": 65.17, "text": "Perhaps you wouldn't mind telling me, before the entire Chancellery Guard come crashing in here", "words": [{"w": " Perhaps", "s": 60.61, "e": 61.05}, {"w": " you", "s": 61.05, "e": 61.33}, {"w": " wouldn't", "s": 61.33, "e": 61.61}, {"w": " mind", "s": 61.61, "e": 61.79}, {"w": " telling", "s": 61.79, "e": 62.07}, {"w": " me,", "s": 62.07, "e": 62.27}, {"w": " before", "s": 62.29, "e": 62.75}, {"w": " the", "s": 62.75, "e": 62.97}, {"w": " entire", "s": 62.97, "e": 63.29}, {"w": " Chancellery", "s": 63.29, "e": 63.85}, {"w": " Guard", "s": 63.85, "e": 64.13}, {"w": " come", "s": 64.13, "e": 64.37}, {"w": " crashing", "s": 64.37, "e": 64.83}, {"w": " in", "s": 64.83, "e": 65.03}, {"w": " here", "s": 65.03, "e": 65.17}]}, {"start": 65.17, "end": 70.23, "text": "demanding to know who has breached the transduction barriers and materialised a TARDIS right outside the Presidential Palace,", "words": [{"w": " demanding", "s": 65.17, "e": 65.41}, {"w": " to", "s": 65.41, "e": 65.73}, {"w": " know", "s": 65.73, "e": 65.85}, {"w": " who", "s": 65.85, "e": 66.05}, {"w": " has", "s": 66.05, "e": 66.19}, {"w": " breached", "s": 66.19, "e": 66.49}, {"w": " the", "s": 66.49, "e": 66.67}, {"w": " transduction", "s": 66.67, "e": 67.11}, {"w": " barriers", "s": 67.11, "e": 67.47}, {"w": " and", "s": 67.47, "e": 67.73}, {"w": " materialised", "s": 67.73, "e": 68.33}, {"w": " a", "s": 68.33, "e": 68.45}, {"w": " TARDIS", "s": 68.45, "e": 68.79}, {"w": " right", "s": 68.79, "e": 68.97}, {"w": " outside", "s": 68.97, "e": 69.31}, {"w": " the", "s": 69.31, "e": 69.51}, {"w": " Presidential", "s": 69.51, "e": 69.75}, {"w": " Palace,", "s": 69.75, "e": 70.23}]}, {"start": 70.33, "end": 73.67, "text": "what exactly you are doing here.", "words": [{"w": " what", "s": 70.33, "e": 70.93}, {"w": " exactly", "s": 70.93, "e": 71.55}, {"w": " you", "s": 71.55, "e": 72.65}, {"w": " are", "s": 72.65, "e": 72.93}, {"w": " doing", "s": 72.93, "e": 73.25}, {"w": " here.", "s": 73.25, "e": 73.67}]}, {"start": 74.11, "end": 78.31, "text": "Practical as ever. All right. Romana, I need to take you away from all this.", "words": [{"w": " Practical", "s": 74.11, "e": 74.55}, {"w": " as", "s": 74.55, "e": 74.69}, {"w": " ever.", "s": 74.69, "e": 74.93}, {"w": " All", "s": 75.09, "e": 75.25}, {"w": " right.", "s": 75.25, "e": 75.41}, {"w": " Romana,", "s": 76.27, "e": 76.71}, {"w": " I", "s": 76.73, "e": 76.87}, {"w": " need", "s": 76.87, "e": 77.03}, {"w": " to", "s": 77.03, "e": 77.15}, {"w": " take", "s": 77.15, "e": 77.31}, {"w": " you", "s": 77.31, "e": 77.41}, {"w": " away", "s": 77.41, "e": 77.61}, {"w": " from", "s": 77.61, "e": 77.83}, {"w": " all", "s": 77.83, "e": 77.99}, {"w": " this.", "s": 77.99, "e": 78.31}]}, {"start": 78.51, "end": 80.65, "text": "Master, the Mistress has duties...", "words": [{"w": " Master,", "s": 78.51, "e": 78.75}, {"w": " the", "s": 78.87, "e": 79.39}, {"w": " Mistress", "s": 79.39, "e": 79.59}, {"w": " has", "s": 79.59, "e": 79.93}, {"w": " duties...", "s": 79.93, "e": 80.65}]}, {"start": 80.65, "end": 83.83, "text": "To the State, yes. To the Time Lords, yes, yes. Blah, blah, blah.", "words": [{"w": " To", "s": 80.65, "e": 80.77}, {"w": " the", "s": 80.77, "e": 80.81}, {"w": " State,", "s": 80.81, "e": 81.11}, {"w": " yes.", "s": 81.21, "e": 81.43}, {"w": " To", "s": 81.45, "e": 81.73}, {"w": " the", "s": 81.73, "e": 81.85}, {"w": " Time", "s": 81.85, "e": 82.07}, {"w": " Lords,", "s": 82.07, "e": 82.31}, {"w": " yes,", "s": 82.41, "e": 82.71}, {"w": " yes.", "s": 82.83, "e": 83.01}, {"w": " Blah,", "s": 83.09, "e": 83.47}, {"w": " blah,", "s": 83.47, "e": 83.65}, {"w": " blah.", "s": 83.67, "e": 83.83}]}, {"start": 83.93, "end": 88.29, "text": "Come on, Romana, this is me. I need you. You and K-9, in fact.", "words": [{"w": " Come", "s": 83.93, "e": 84.11}, {"w": " on,", "s": 84.11, "e": 84.29}, {"w": " Romana,", "s": 84.29, "e": 84.67}, {"w": " this", "s": 84.69, "e": 84.81}, {"w": " is", "s": 84.81, "e": 84.95}, {"w": " me.", "s": 84.95, "e": 85.19}, {"w": " I", "s": 85.69, "e": 86.13}, {"w": " need", "s": 86.13, "e": 86.43}, {"w": " you.", "s": 86.43, "e": 86.77}, {"w": " You", "s": 86.87, "e": 87.15}, {"w": " and", "s": 87.15, "e": 87.29}, {"w": " K", "s": 87.29, "e": 87.49}, {"w": "-9,", "s": 87.49, "e": 87.77}, {"w": " in", "s": 87.89, "e": 88.05}, {"w": " fact.", "s": 88.05, "e": 88.29}]}, {"start": 88.55, "end": 88.99, "text": "Why?", "words": [{"w": " Why?", "s": 88.55, "e": 88.99}]}, {"start": 89.31, "end": 89.59, "text": "Earth.", "words": [{"w": " Earth.", "s": 89.31, "e": 89.59}]}, {"start": 90.35, "end": 92.39, "text": "Earth. Cambridge, 1979.", "words": [{"w": " Earth.", "s": 90.35, "e": 90.83}, {"w": " Cambridge,", "s": 90.83, "e": 90.83}, {"w": " 1979.", "s": 91.13, "e": 92.39}]}, {"start": 93.05, "end": 93.73, "text": "What about it?", "words": [{"w": " What", "s": 93.05, "e": 93.31}, {"w": " about", "s": 93.31, "e": 93.47}, {"w": " it?", "s": 93.47, "e": 93.73}]}, {"start": 94.05, "end": 99.69, "text": "We were there, in the old days, when you and I and K-9 here travelled around,", "words": [{"w": " We", "s": 94.05, "e": 94.53}, {"w": " were", "s": 94.53, "e": 94.61}, {"w": " there,", "s": 94.61, "e": 94.91}, {"w": " in", "s": 94.95, "e": 95.99}, {"w": " the", "s": 95.99, "e": 96.19}, {"w": " old", "s": 96.19, "e": 96.41}, {"w": " days,", "s": 96.41, "e": 96.75}, {"w": " when", "s": 97.07, "e": 97.91}, {"w": " you", "s": 97.91, "e": 98.09}, {"w": " and", "s": 98.09, "e": 98.21}, {"w": " I", "s": 98.21, "e": 98.37}, {"w": " and", "s": 98.37, "e": 98.55}, {"w": " K", "s": 98.55, "e": 98.67}, {"w": "-9", "s": 98.67, "e": 98.91}, {"w": " here", "s": 98.91, "e": 99.11}, {"w": " travelled", "s": 99.11, "e": 99.35}, {"w": " around,", "s": 99.35, "e": 99.69}]}, {"start": 100.21, "end": 104.87, "text": "righting wrongs, collecting keys to time, defacing Leonardo's works of art.", "words": [{"w": " righting", "s": 100.21, "e": 100.69}, {"w": " wrongs,", "s": 100.69, "e": 101.17}, {"w": " collecting", "s": 101.17, "e": 101.45}, {"w": " keys", "s": 101.45, "e": 101.91}, {"w": " to", "s": 101.91, "e": 102.19}, {"w": " time,", "s": 102.19, "e": 102.55}, {"w": " defacing", "s": 102.91, "e": 103.73}, {"w": " Leonardo's", "s": 103.73, "e": 104.31}, {"w": " works", "s": 104.31, "e": 104.45}, {"w": " of", "s": 104.45, "e": 104.67}, {"w": " art.", "s": 104.67, "e": 104.87}]}, {"start": 104.95, "end": 106.43, "text": "All right, Doctor, I remember that.", "words": [{"w": " All", "s": 104.95, "e": 105.09}, {"w": " right,", "s": 105.09, "e": 105.43}, {"w": " Doctor,", "s": 105.45, "e": 105.63}, {"w": " I", "s": 105.75, "e": 105.85}, {"w": " remember", "s": 105.85, "e": 106.11}, {"w": " that.", "s": 106.11, "e": 106.43}]}, {"start": 106.57, "end": 112.61, "text": "There we were, you and me, on a punt, up the cab, talking about Wordsworth, Newton, Owen Chadwick.", "words": [{"w": " There", "s": 106.57, "e": 106.89}, {"w": " we", "s": 106.89, "e": 107.05}, {"w": " were,", "s": 107.05, "e": 107.27}, {"w": " you", "s": 107.33, "e": 107.43}, {"w": " and", "s": 107.43, "e": 107.57}, {"w": " me,", "s": 107.57, "e": 107.75}, {"w": " on", "s": 107.79, "e": 107.89}, {"w": " a", "s": 107.89, "e": 107.99}, {"w": " punt,", "s": 107.99, "e": 108.25}, {"w": " up", "s": 108.53, "e": 108.83}, {"w": " the", "s": 108.83, "e": 108.99}, {"w": " cab,", "s": 108.99, "e": 109.19}, {"w": " talking", "s": 109.45, "e": 110.01}, {"w": " about", "s": 110.01, "e": 110.29}, {"w": " Wordsworth,", "s": 110.29, "e": 110.99}, {"w": " Newton,", "s": 111.25, "e": 111.49}, {"w": " Owen", "s": 111.85, "e": 112.15}, {"w": " Chadwick.", "s": 112.15, "e": 112.61}]}, {"start": 112.73, "end": 117.97, "text": "What about it? As I recall, you and I were abruptly taken out of time and kept in stasis for a while.", "words": [{"w": " What", "s": 112.73, "e": 113.21}, {"w": " about", "s": 113.21, "e": 113.49}, {"w": " it?", "s": 113.49, "e": 113.77}, {"w": " As", "s": 113.77, "e": 113.87}, {"w": " I", "s": 113.87, "e": 113.99}, {"w": " recall,", "s": 113.99, "e": 114.23}, {"w": " you", "s": 114.33, "e": 114.45}, {"w": " and", "s": 114.45, "e": 114.55}, {"w": " I", "s": 114.55, "e": 114.63}, {"w": " were", "s": 114.63, "e": 114.85}, {"w": " abruptly", "s": 114.85, "e": 115.17}, {"w": " taken", "s": 115.17, "e": 115.47}, {"w": " out", "s": 115.47, "e": 115.75}, {"w": " of", "s": 115.75, "e": 115.93}, {"w": " time", "s": 115.93, "e": 116.19}, {"w": " and", "s": 116.19, "e": 116.71}, {"w": " kept", "s": 116.71, "e": 116.95}, {"w": " in", "s": 116.95, "e": 117.11}, {"w": " stasis", "s": 117.11, "e": 117.47}, {"w": " for", "s": 117.47, "e": 117.67}, {"w": " a", "s": 117.67, "e": 117.77}, {"w": " while.", "s": 117.77, "e": 117.97}]}, {"start": 118.09, "end": 119.45, "text": "Then we were put back again.", "words": [{"w": " Then", "s": 118.09, "e": 118.57}, {"w": " we", "s": 118.57, "e": 118.75}, {"w": " were", "s": 118.75, "e": 118.87}, {"w": " put", "s": 118.87, "e": 118.97}, {"w": " back", "s": 118.97, "e": 119.15}, {"w": " again.", "s": 119.15, "e": 119.45}]}, {"start": 120.01, "end": 121.25, "text": "And we soon went on somewhere else.", "words": [{"w": " And", "s": 120.01, "e": 120.19}, {"w": " we", "s": 120.19, "e": 120.33}, {"w": " soon", "s": 120.33, "e": 120.47}, {"w": " went", "s": 120.47, "e": 120.65}, {"w": " on", "s": 120.65, "e": 120.77}, {"w": " somewhere", "s": 120.77, "e": 120.97}, {"w": " else.", "s": 120.97, "e": 121.25}]}, {"start": 121.41, "end": 121.55, "text": "Aha.", "words": [{"w": " Aha.", "s": 121.41, "e": 121.55}]}, {"start": 122.53, "end": 123.85, "text": "Aha? What?", "words": [{"w": " Aha?", "s": 122.53, "e": 122.95}, {"w": " What?", "s": 123.43, "e": 123.85}]}, {"start": 124.31, "end": 126.45, "text": "Why did we go to Cambridge in the first place, hmm?", "words": [{"w": " Why", "s": 124.31, "e": 124.73}, {"w": " did", "s": 124.73, "e": 124.87}, {"w": " we", "s": 124.87, "e": 125.01}, {"w": " go", "s": 125.01, "e": 125.17}, {"w": " to", "s": 125.17, "e": 125.25}, {"w": " Cambridge", "s": 125.25, "e": 125.51}, {"w": " in", "s": 125.51, "e": 125.73}, {"w": " the", "s": 125.73, "e": 125.79}, {"w": " first", "s": 125.79, "e": 126.03}, {"w": " place,", "s": 126.03, "e": 126.35}, {"w": " hmm?", "s": 126.37, "e": 126.45}]}, {"start": 126.79, "end": 129.79, "text": "You intended to visit Professor Cronotis, Master.", "words": [{"w": " You", "s": 126.79, "e": 127.21}, {"w": " intended", "s": 127.21, "e": 127.47}, {"w": " to", "s": 127.47, "e": 127.75}, {"w": " visit", "s": 127.75, "e": 128.03}, {"w": " Professor", "s": 128.03, "e": 128.47}, {"w": " Cronotis,", "s": 128.47, "e": 129.41}, {"w": " Master.", "s": 129.45, "e": 129.79}]}, {"start": 130.13, "end": 137.29, "text": "An associate of yours resides at St. Seds College, Cambridge, Earth, Sol 3, Muttersparrow, the Milky Way.", "words": [{"w": " An", "s": 130.13, "e": 130.55}, {"w": " associate", "s": 130.55, "e": 130.89}, {"w": " of", "s": 130.89, "e": 131.25}, {"w": " yours", "s": 131.25, "e": 131.53}, {"w": " resides", "s": 131.53, "e": 132.23}, {"w": " at", "s": 132.23, "e": 132.69}, {"w": " St.", "s": 132.69, "e": 132.91}, {"w": " Seds", "s": 132.93, "e": 133.27}, {"w": " College,", "s": 133.27, "e": 133.59}, {"w": " Cambridge,", "s": 133.73, "e": 134.11}, {"w": " Earth,", "s": 134.43, "e": 134.71}, {"w": " Sol", "s": 134.89, "e": 135.17}, {"w": " 3,", "s": 135.17, "e": 135.41}, {"w": " Muttersparrow,", "s": 135.65, "e": 136.49}, {"w": " the", "s": 136.57, "e": 136.73}, {"w": " Milky", "s": 136.73, "e": 136.97}, {"w": " Way.", "s": 136.97, "e": 137.29}]}, {"start": 137.45, "end": 139.29, "text": "Yes, thank you, K-9. We don't need his postcard.", "words": [{"w": " Yes,", "s": 137.45, "e": 137.61}, {"w": " thank", "s": 137.61, "e": 137.83}, {"w": " you,", "s": 137.83, "e": 138.01}, {"w": " K", "s": 138.03, "e": 138.09}, {"w": "-9.", "s": 138.09, "e": 138.29}, {"w": " We", "s": 138.33, "e": 138.43}, {"w": " don't", "s": 138.43, "e": 138.57}, {"w": " need", "s": 138.57, "e": 138.67}, {"w": " his", "s": 138.67, "e": 138.79}, {"w": " postcard.", "s": 138.79, "e": 139.29}]}, {"start": 139.55, "end": 140.23, "text": "C-B-1.", "words": [{"w": " C", "s": 139.55, "e": 139.73}, {"w": "-B", "s": 139.73, "e": 140.01}, {"w": "-1.", "s": 140.01, "e": 140.23}]}, {"start": 140.29, "end": 141.49, "text": "Thank you, K-9.", "words": [{"w": " Thank", "s": 140.29, "e": 140.49}, {"w": " you,", "s": 140.49, "e": 141.01}, {"w": " K", "s": 141.01, "e": 141.29}, {"w": "-9.", "s": 141.29, "e": 141.49}]}, {"start": 142.37, "end": 145.25, "text": "K-9, do you recall why we were planning to visit the Professor?", "words": [{"w": " K", "s": 142.37, "e": 142.79}, {"w": "-9,", "s": 142.79, "e": 143.03}, {"w": " do", "s": 143.03, "e": 143.17}, {"w": " you", "s": 143.17, "e": 143.25}, {"w": " recall", "s": 143.25, "e": 143.53}, {"w": " why", "s": 143.53, "e": 143.91}, {"w": " we", "s": 143.91, "e": 144.19}, {"w": " were", "s": 144.19, "e": 144.33}, {"w": " planning", "s": 144.33, "e": 144.53}, {"w": " to", "s": 144.53, "e": 144.71}, {"w": " visit", "s": 144.71, "e": 144.91}, {"w": " the", "s": 144.91, "e": 145.03}, {"w": " Professor?", "s": 145.03, "e": 145.25}]}, {"start": 145.61, "end": 146.33, "text": "Negative, Mistress.", "words": [{"w": " Negative,", "s": 145.61, "e": 146.03}, {"w": " Mistress.", "s": 146.11, "e": 146.33}]}, {"start": 146.81, "end": 147.51, "text": "I see.", "words": [{"w": " I", "s": 146.81, "e": 147.23}, {"w": " see.", "s": 147.23, "e": 147.51}]}, {"start": 147.83, "end": 149.85, "text": "Oh, that's odd. Don't you think that's over, Mona?", "words": [{"w": " Oh,", "s": 147.83, "e": 148.23}, {"w": " that's", "s": 148.25, "e": 148.45}, {"w": " odd.", "s": 148.45, "e": 148.63}, {"w": " Don't", "s": 148.75, "e": 149.05}, {"w": " you", "s": 149.05, "e": 149.15}, {"w": " think", "s": 149.15, "e": 149.31}, {"w": " that's", "s": 149.31, "e": 149.55}, {"w": " over,", "s": 149.55, "e": 149.65}, {"w": " Mona?", "s": 149.73, "e": 149.85}]}, {"start": 150.01, "end": 153.77, "text": "You see, I assumed K-9's memory wouldn't be affected as his brain isn't organic.", "words": [{"w": " You", "s": 150.01, "e": 150.45}, {"w": " see,", "s": 150.45, "e": 150.61}, {"w": " I", "s": 150.63, "e": 150.71}, {"w": " assumed", "s": 150.71, "e": 151.13}, {"w": " K", "s": 151.13, "e": 151.37}, {"w": "-9's", "s": 151.37, "e": 151.77}, {"w": " memory", "s": 151.77, "e": 152.03}, {"w": " wouldn't", "s": 152.03, "e": 152.31}, {"w": " be", "s": 152.31, "e": 152.39}, {"w": " affected", "s": 152.39, "e": 152.67}, {"w": " as", "s": 152.67, "e": 152.95}, {"w": " his", "s": 152.95, "e": 153.07}, {"w": " brain", "s": 153.07, "e": 153.27}, {"w": " isn't", "s": 153.27, "e": 153.51}, {"w": " organic.", "s": 153.51, "e": 153.77}]}, {"start": 154.01, "end": 158.11, "text": "Correction, Master. I do not recall these events. I did not witness them.", "words": [{"w": " Correction,", "s": 154.01, "e": 154.39}, {"w": " Master.", "s": 154.47, "e": 154.71}, {"w": " I", "s": 154.85, "e": 155.09}, {"w": " do", "s": 155.09, "e": 155.27}, {"w": " not", "s": 155.27, "e": 155.49}, {"w": " recall", "s": 155.49, "e": 155.85}, {"w": " these", "s": 155.85, "e": 156.15}, {"w": " events.", "s": 156.15, "e": 156.41}, {"w": " I", "s": 156.67, "e": 157.11}, {"w": " did", "s": 157.11, "e": 157.29}, {"w": " not", "s": 157.29, "e": 157.45}, {"w": " witness", "s": 157.45, "e": 157.79}, {"w": " them.", "s": 157.79, "e": 158.11}]}, {"start": 158.69, "end": 162.85, "text": "I recall your last words to me as you left the TARDIS on that occasion.", "words": [{"w": " I", "s": 158.69, "e": 159.17}, {"w": " recall", "s": 159.17, "e": 159.47}, {"w": " your", "s": 159.47, "e": 159.85}, {"w": " last", "s": 159.85, "e": 160.21}, {"w": " words", "s": 160.21, "e": 160.57}, {"w": " to", "s": 160.57, "e": 160.81}, {"w": " me", "s": 160.81, "e": 160.93}, {"w": " as", "s": 160.93, "e": 161.17}, {"w": " you", "s": 161.17, "e": 161.29}, {"w": " left", "s": 161.29, "e": 161.55}, {"w": " the", "s": 161.55, "e": 161.69}, {"w": " TARDIS", "s": 161.69, "e": 162.05}, {"w": " on", "s": 162.05, "e": 162.29}, {"w": " that", "s": 162.29, "e": 162.51}, {"w": " occasion.", "s": 162.51, "e": 162.85}]}, {"start": 163.07, "end": 165.93, "text": "Of course I couldn't take you punting. What did I say?", "words": [{"w": " Of", "s": 163.07, "e": 163.25}, {"w": " course", "s": 163.25, "e": 163.43}, {"w": " I", "s": 163.43, "e": 163.55}, {"w": " couldn't", "s": 163.55, "e": 163.81}, {"w": " take", "s": 163.81, "e": 163.95}, {"w": " you", "s": 163.95, "e": 164.07}, {"w": " punting.", "s": 164.07, "e": 164.59}, {"w": " What", "s": 164.99, "e": 165.47}, {"w": " did", "s": 165.47, "e": 165.59}, {"w": " I", "s": 165.59, "e": 165.69}, {"w": " say?", "s": 165.69, "e": 165.93}]}, {"start": 166.27, "end": 172.79, "text": "K-9, I'm going to see an old friend with Romana. We'll be back before light's out.", "words": [{"w": " K", "s": 166.27, "e": 166.49}, {"w": "-9,", "s": 166.49, "e": 167.39}, {"w": " I'm", "s": 167.65, "e": 168.37}, {"w": " going", "s": 168.37, "e": 168.57}, {"w": " to", "s": 168.57, "e": 168.79}, {"w": " see", "s": 168.79, "e": 168.97}, {"w": " an", "s": 168.97, "e": 169.19}, {"w": " old", "s": 169.19, "e": 169.43}, {"w": " friend", "s": 169.43, "e": 169.73}, {"w": " with", "s": 169.73, "e": 170.15}, {"w": " Romana.", "s": 170.15, "e": 170.67}, {"w": " We'll", "s": 170.69, "e": 171.13}, {"w": " be", "s": 171.13, "e": 171.29}, {"w": " back", "s": 171.29, "e": 171.71}, {"w": " before", "s": 171.71, "e": 172.03}, {"w": " light's", "s": 172.03, "e": 172.55}, {"w": " out.", "s": 172.55, "e": 172.79}]}, {"start": 173.01, "end": 174.03, "text": "This is bizarre.", "words": [{"w": " This", "s": 173.01, "e": 173.47}, {"w": " is", "s": 173.47, "e": 173.67}, {"w": " bizarre.", "s": 173.67, "e": 174.03}]}, {"start": 174.33, "end": 175.43, "text": "How long will we go on, K-9?", "words": [{"w": " How", "s": 174.33, "e": 174.47}, {"w": " long", "s": 174.47, "e": 174.69}, {"w": " will", "s": 174.69, "e": 174.79}, {"w": " we", "s": 174.79, "e": 174.91}, {"w": " go", "s": 174.91, "e": 175.07}, {"w": " on,", "s": 175.07, "e": 175.19}, {"w": " K", "s": 175.21, "e": 175.29}, {"w": "-9?", "s": 175.29, "e": 175.43}]}, {"start": 175.59, "end": 178.79, "text": "Two hours, twenty-one minutes, thirteen point two-six seconds.", "words": [{"w": " Two", "s": 175.59, "e": 175.77}, {"w": " hours,", "s": 175.77, "e": 176.09}, {"w": " twenty", "s": 176.19, "e": 176.39}, {"w": "-one", "s": 176.39, "e": 176.67}, {"w": " minutes,", "s": 176.67, "e": 176.99}, {"w": " thirteen", "s": 177.13, "e": 177.39}, {"w": " point", "s": 177.39, "e": 177.79}, {"w": " two", "s": 177.79, "e": 178.07}, {"w": "-six", "s": 178.07, "e": 178.29}, {"w": " seconds.", "s": 178.29, "e": 178.79}]}, {"start": 178.79, "end": 182.59, "text": "You returned with the Mistress and said you planned to make some changes.", "words": [{"w": " You", "s": 178.79, "e": 179.51}, {"w": " returned", "s": 179.51, "e": 179.81}, {"w": " with", "s": 179.81, "e": 180.13}, {"w": " the", "s": 180.13, "e": 180.27}, {"w": " Mistress", "s": 180.27, "e": 180.51}, {"w": " and", "s": 180.51, "e": 180.79}, {"w": " said", "s": 180.79, "e": 180.99}, {"w": " you", "s": 180.99, "e": 181.17}, {"w": " planned", "s": 181.17, "e": 181.47}, {"w": " to", "s": 181.47, "e": 181.73}, {"w": " make", "s": 181.73, "e": 181.93}, {"w": " some", "s": 181.93, "e": 182.11}, {"w": " changes.", "s": 182.11, "e": 182.59}]}, {"start": 182.79, "end": 183.23, "text": "Changes?", "words": [{"w": " Changes?", "s": 182.79, "e": 183.23}]}, {"start": 183.51, "end": 190.25, "text": "You stated you had got nowhere in the last few hours, and we should get our bathing suits on as we were going to Brighton.", "words": [{"w": " You", "s": 183.51, "e": 183.69}, {"w": " stated", "s": 183.69, "e": 183.93}, {"w": " you", "s": 183.93, "e": 184.27}, {"w": " had", "s": 184.27, "e": 184.41}, {"w": " got", "s": 184.41, "e": 184.57}, {"w": " nowhere", "s": 184.57, "e": 184.95}, {"w": " in", "s": 184.95, "e": 185.25}, {"w": " the", "s": 185.25, "e": 185.33}, {"w": " last", "s": 185.33, "e": 185.55}, {"w": " few", "s": 185.55, "e": 185.77}, {"w": " hours,", "s": 185.77, "e": 186.13}, {"w": " and", "s": 186.27, "e": 186.61}, {"w": " we", "s": 186.61, "e": 186.77}, {"w": " should", "s": 186.77, "e": 186.95}, {"w": " get", "s": 186.95, "e": 187.15}, {"w": " our", "s": 187.15, "e": 187.43}, {"w": " bathing", "s": 187.43, "e": 187.81}, {"w": " suits", "s": 187.81, "e": 188.15}, {"w": " on", "s": 188.15, "e": 188.61}, {"w": " as", "s": 188.61, "e": 188.95}, {"w": " we", "s": 188.95, "e": 189.11}, {"w": " were", "s": 189.11, "e": 189.27}, {"w": " going", "s": 189.27, "e": 189.49}, {"w": " to", "s": 189.49, "e": 189.71}, {"w": " Brighton.", "s": 189.71, "e": 190.25}]}, {"start": 190.39, "end": 192.99, "text": "So we didn't see Professor Kronotis then?", "words": [{"w": " So", "s": 190.39, "e": 190.63}, {"w": " we", "s": 190.63, "e": 191.09}, {"w": " didn't", "s": 191.09, "e": 191.41}, {"w": " see", "s": 191.41, "e": 191.63}, {"w": " Professor", "s": 191.63, "e": 192.07}, {"w": " Kronotis", "s": 192.07, "e": 192.73}, {"w": " then?", "s": 192.73, "e": 192.99}]}, {"start": 193.31, "end": 203.77, "text": "Oh, I think we did. I think we did, because last night I had a dream about him, and I could clearly see you, all Edwardian glamour, and myself, all teeth and curls, punting on the cab.", "words": [{"w": " Oh,", "s": 193.31, "e": 193.47}, {"w": " I", "s": 193.49, "e": 193.53}, {"w": " think", "s": 193.53, "e": 193.69}, {"w": " we", "s": 193.69, "e": 193.79}, {"w": " did.", "s": 193.79, "e": 193.93}, {"w": " I", "s": 194.17, "e": 194.61}, {"w": " think", "s": 194.61, "e": 194.85}, {"w": " we", "s": 194.85, "e": 194.99}, {"w": " did,", "s": 194.99, "e": 195.09}, {"w": " because", "s": 195.11, "e": 195.31}, {"w": " last", "s": 195.31, "e": 195.51}, {"w": " night", "s": 195.51, "e": 195.89}, {"w": " I", "s": 195.89, "e": 196.45}, {"w": " had", "s": 196.45, "e": 196.63}, {"w": " a", "s": 196.63, "e": 196.75}, {"w": " dream", "s": 196.75, "e": 197.01}, {"w": " about", "s": 197.01, "e": 197.29}, {"w": " him,", "s": 197.29, "e": 197.63}, {"w": " and", "s": 197.67, "e": 198.07}, {"w": " I", "s": 198.07, "e": 198.15}, {"w": " could", "s": 198.15, "e": 198.29}, {"w": " clearly", "s": 198.29, "e": 198.65}, {"w": " see", "s": 198.65, "e": 198.95}, {"w": " you,", "s": 198.95, "e": 199.33}, {"w": " all", "s": 199.53, "e": 200.03}, {"w": " Edwardian", "s": 200.03, "e": 200.69}, {"w": " glamour,", "s": 200.69, "e": 201.25}, {"w": " and", "s": 201.25, "e": 201.37}, {"w": " myself,", "s": 201.37, "e": 201.63}, {"w": " all", "s": 201.77, "e": 201.95}, {"w": " teeth", "s": 201.95, "e": 202.21}, {"w": " and", "s": 202.21, "e": 202.53}, {"w": " curls,", "s": 202.53, "e": 202.81}, {"w": " punting", "s": 202.91, "e": 203.31}, {"w": " on", "s": 203.31, "e": 203.47}, {"w": " the", "s": 203.47, "e": 203.55}, {"w": " cab.", "s": 203.55, "e": 203.77}]}, {"start": 204.17, "end": 206.57, "text": "Then I saw old Kronotis. He was calling to me.", "words": [{"w": " Then", "s": 204.17, "e": 204.61}, {"w": " I", "s": 204.61, "e": 204.73}, {"w": " saw", "s": 204.73, "e": 204.97}, {"w": " old", "s": 204.97, "e": 205.19}, {"w": " Kronotis.", "s": 205.19, "e": 205.61}, {"w": " He", "s": 205.65, "e": 205.73}, {"w": " was", "s": 205.73, "e": 205.85}, {"w": " calling", "s": 205.85, "e": 206.17}, {"w": " to", "s": 206.17, "e": 206.39}, {"w": " me.", "s": 206.39, "e": 206.57}]}, {"start": 206.73, "end": 207.21, "text": "Why now?", "words": [{"w": " Why", "s": 206.73, "e": 206.91}, {"w": " now?", "s": 206.91, "e": 207.21}]}, {"start": 207.57, "end": 208.09, "text": "Why now?", "words": [{"w": " Why", "s": 207.57, "e": 207.77}, {"w": " now?", "s": 207.77, "e": 208.09}]}, {"start": 208.09, "end": 210.27, "text": "He wanted me to do whatever it was he originally wanted us to do.", "words": [{"w": " He", "s": 208.09, "e": 208.15}, {"w": " wanted", "s": 208.15, "e": 208.23}, {"w": " me", "s": 208.23, "e": 208.23}, {"w": " to", "s": 208.23, "e": 208.23}, {"w": " do", "s": 208.23, "e": 208.39}, {"w": " whatever", "s": 208.39, "e": 208.61}, {"w": " it", "s": 208.61, "e": 208.79}, {"w": " was", "s": 208.79, "e": 208.91}, {"w": " he", "s": 208.91, "e": 209.05}, {"w": " originally", "s": 209.05, "e": 209.33}, {"w": " wanted", "s": 209.33, "e": 209.61}, {"w": " us", "s": 209.61, "e": 209.81}, {"w": " to", "s": 209.81, "e": 209.97}, {"w": " do.", "s": 209.97, "e": 210.27}]}, {"start": 210.61, "end": 212.59, "text": "You could go without me, Doctor.", "words": [{"w": " You", "s": 210.61, "e": 211.01}, {"w": " could", "s": 211.01, "e": 211.23}, {"w": " go", "s": 211.23, "e": 211.51}, {"w": " without", "s": 211.51, "e": 211.87}, {"w": " me,", "s": 211.87, "e": 212.23}, {"w": " Doctor.", "s": 212.33, "e": 212.59}]}, {"start": 212.87, "end": 215.73, "text": "What, and miss the chance of solving the mystery that's plaguing you right now?", "words": [{"w": " What,", "s": 212.87, "e": 213.07}, {"w": " and", "s": 213.09, "e": 213.17}, {"w": " miss", "s": 213.17, "e": 213.27}, {"w": " the", "s": 213.27, "e": 213.39}, {"w": " chance", "s": 213.39, "e": 213.63}, {"w": " of", "s": 213.63, "e": 213.79}, {"w": " solving", "s": 213.79, "e": 214.09}, {"w": " the", "s": 214.09, "e": 214.29}, {"w": " mystery", "s": 214.29, "e": 214.55}, {"w": " that's", "s": 214.55, "e": 214.77}, {"w": " plaguing", "s": 214.77, "e": 215.23}, {"w": " you", "s": 215.23, "e": 215.33}, {"w": " right", "s": 215.33, "e": 215.49}, {"w": " now?", "s": 215.49, "e": 215.73}]}, {"start": 216.01, "end": 220.49, "text": "It's only plaguing me because you've just told me about it. If you hadn't arrived just now...", "words": [{"w": " It's", "s": 216.01, "e": 216.27}, {"w": " only", "s": 216.27, "e": 216.33}, {"w": " plaguing", "s": 216.33, "e": 216.79}, {"w": " me", "s": 216.79, "e": 216.87}, {"w": " because", "s": 216.87, "e": 217.07}, {"w": " you've", "s": 217.07, "e": 217.27}, {"w": " just", "s": 217.27, "e": 217.41}, {"w": " told", "s": 217.41, "e": 217.67}, {"w": " me", "s": 217.67, "e": 217.81}, {"w": " about", "s": 217.81, "e": 218.01}, {"w": " it.", "s": 218.01, "e": 218.27}, {"w": " If", "s": 218.37, "e": 218.71}, {"w": " you", "s": 218.71, "e": 218.81}, {"w": " hadn't", "s": 218.81, "e": 219.11}, {"w": " arrived", "s": 219.11, "e": 219.45}, {"w": " just", "s": 219.45, "e": 219.91}, {"w": " now...", "s": 219.91, "e": 220.49}]}, {"start": 220.49, "end": 226.77, "text": "Oh, please, Romana, please, please, please, please. You want to trip back to Earth, don't you, K-9? You liked Earth.", "words": [{"w": " Oh,", "s": 220.49, "e": 220.57}, {"w": " please,", "s": 220.57, "e": 220.79}, {"w": " Romana,", "s": 220.89, "e": 221.17}, {"w": " please,", "s": 221.17, "e": 221.49}, {"w": " please,", "s": 222.01, "e": 222.23}, {"w": " please,", "s": 222.33, "e": 222.51}, {"w": " please.", "s": 222.55, "e": 222.87}, {"w": " You", "s": 223.83, "e": 224.23}, {"w": " want", "s": 224.23, "e": 224.37}, {"w": " to", "s": 224.37, "e": 224.47}, {"w": " trip", "s": 224.47, "e": 224.73}, {"w": " back", "s": 224.73, "e": 224.93}, {"w": " to", "s": 224.93, "e": 225.13}, {"w": " Earth,", "s": 225.13, "e": 225.37}, {"w": " don't", "s": 225.43, "e": 225.59}, {"w": " you,", "s": 225.59, "e": 225.69}, {"w": " K", "s": 225.73, "e": 225.81}, {"w": "-9?", "s": 225.81, "e": 226.05}, {"w": " You", "s": 226.09, "e": 226.25}, {"w": " liked", "s": 226.25, "e": 226.53}, {"w": " Earth.", "s": 226.53, "e": 226.77}]}, {"start": 227.01, "end": 230.31, "text": "Negative, Master. The composition of the soil's interfered with my traction.", "words": [{"w": " Negative,", "s": 227.01, "e": 227.25}, {"w": " Master.", "s": 227.35, "e": 227.59}, {"w": " The", "s": 227.75, "e": 227.95}, {"w": " composition", "s": 227.95, "e": 228.23}, {"w": " of", "s": 228.23, "e": 228.59}, {"w": " the", "s": 228.59, "e": 228.69}, {"w": " soil's", "s": 228.69, "e": 229.07}, {"w": " interfered", "s": 229.07, "e": 229.55}, {"w": " with", "s": 229.55, "e": 229.71}, {"w": " my", "s": 229.71, "e": 229.89}, {"w": " traction.", "s": 229.89, "e": 230.31}]}, {"start": 230.51, "end": 236.03, "text": "There, you see, Romana, K-9 wan