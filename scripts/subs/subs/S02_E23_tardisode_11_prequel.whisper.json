[{"start": 8.02, "end": 9.5, "text": "An ordinary London street.", "words": [{"w": " An", "s": 8.02, "e": 8.42}, {"w": " ordinary", "s": 8.42, "e": 8.72}, {"w": " London", "s": 8.72, "e": 9.12}, {"w": " street.", "s": 9.12, "e": 9.5}]}, {"start": 10.58, "end": 14.26, "text": "Or is it? Crime Crackers, can you help us?", "words": [{"w": " Or", "s": 10.58, "e": 11.22}, {"w": " is", "s": 11.22, "e": 11.38}, {"w": " it?", "s": 11.38, "e": 11.52}, {"w": " Crime", "s": 11.86, "e": 12.5}, {"w": " Crackers,", "s": 12.5, "e": 12.94}, {"w": " can", "s": 13.02, "e": 13.52}, {"w": " you", "s": 13.52, "e": 13.72}, {"w": " help", "s": 13.72, "e": 14.04}, {"w": " us?", "s": 14.04, "e": 14.26}]}, {"start": 14.8, "end": 18.3, "text": "Dale Higgs, Jane McKillen, where are they?", "words": [{"w": " Dale", "s": 14.8, "e": 15.44}, {"w": " Higgs,", "s": 15.44, "e": 15.82}, {"w": " Jane", "s": 15.96, "e": 16.74}, {"w": " McKillen,", "s": 16.74, "e": 17.22}, {"w": " where", "s": 17.34, "e": 17.86}, {"w": " are", "s": 17.86, "e": 18.1}, {"w": " they?", "s": 18.1, "e": 18.3}]}, {"start": 18.7, "end": 23.42, "text": "Ran away from the big city, joined a gang the police don't seem to know,", "words": [{"w": " Ran", "s": 18.7, "e": 19.3}, {"w": " away", "s": 19.3, "e": 19.54}, {"w": " from", "s": 19.54, "e": 19.84}, {"w": " the", "s": 19.84, "e": 19.98}, {"w": " big", "s": 19.98, "e": 20.2}, {"w": " city,", "s": 20.2, "e": 20.54}, {"w": " joined", "s": 20.7, "e": 21.12}, {"w": " a", "s": 21.12, "e": 21.28}, {"w": " gang", "s": 21.28, "e": 21.66}, {"w": " the", "s": 21.66, "e": 22.08}, {"w": " police", "s": 22.08, "e": 22.42}, {"w": " don't", "s": 22.42, "e": 22.84}, {"w": " seem", "s": 22.84, "e": 22.98}, {"w": " to", "s": 22.98, "e": 23.16}, {"w": " know,", "s": 23.16, "e": 23.42}]}, {"start": 23.56, "end": 26.68, "text": "but you are Crime Crackers' eyes and ears.", "words": [{"w": " but", "s": 23.56, "e": 24.02}, {"w": " you", "s": 24.02, "e": 24.3}, {"w": " are", "s": 24.3, "e": 24.64}, {"w": " Crime", "s": 24.64, "e": 25.0}, {"w": " Crackers'", "s": 25.0, "e": 25.54}, {"w": " eyes", "s": 25.58, "e": 25.88}, {"w": " and", "s": 25.88, "e": 26.34}, {"w": " ears.", "s": 26.34, "e": 26.68}]}, {"start": 27.26, "end": 29.32, "text": "Can you help Crime Crackers?", "words": [{"w": " Can", "s": 27.26, "e": 27.9}, {"w": " you", "s": 27.9, "e": 28.18}, {"w": " help", "s": 28.18, "e": 28.52}, {"w": " Crime", "s": 28.52, "e": 28.8}, {"w": " Crackers?", "s": 28.8, "e": 29.32}]}, {"start": 29.56, "end": 31.4, "text": "Don't want to talk to the cops?", "words": [{"w": " Don't", "s": 29.56, "e": 30.2}, {"w": " want", "s": 30.2, "e": 30.28}, {"w": " to", "s": 30.28, "e": 30.46}, {"w": " talk", "s": 30.46, "e": 30.74}, {"w": " to", "s": 30.74, "e": 30.9}, {"w": " the", "s": 30.9, "e": 31.04}, {"w": " cops?", "s": 31.04, "e": 31.4}]}, {"start": 31.62, "end": 33.78, "text": "Then call now on this number.", "words": [{"w": " Then", "s": 31.62, "e": 32.06}, {"w": " call", "s": 32.06, "e": 32.38}, {"w": " now", "s": 32.38, "e": 32.72}, {"w": " on", "s": 32.72, "e": 33.16}, {"w": " this", "s": 33.16, "e": 33.4}, {"w": " number.", "s": 33.4, "e": 33.78}]}, {"start": 34.18, "end": 35.9, "text": "We're waiting for your call.", "words": [{"w": " We're", "s": 34.18, "e": 34.82}, {"w": " waiting", "s": 34.82, "e": 35.12}, {"w": " for", "s": 35.12, "e": 35.36}, {"w": " your", "s": 35.36, "e": 35.54}, {"w": " call.", "s": 35.54, "e": 35.9}]}, {"start": 35.9, "end": 37.86, "text": "Call. You can make a difference.", "words": [{"w": " Call.", "s": 35.9, "e": 36.06}, {"w": " You", "s": 36.08, "e": 36.52}, {"w": " can", "s": 36.52, "e": 36.9}, {"w": " make", "s": 36.9, "e": 37.44}, {"w": " a", "s": 37.44, "e": 37.54}, {"w": " difference.", "s": 37.54, "e": 37.86}]}, {"start": 38.38, "end": 39.56, "text": "Crime Crackers.", "words": [{"w": " Crime", "s": 38.38, "e": 39.04}, {"w": " Crackers.", "s": 39.04, "e": 39.56}]}, {"start": 40.62, "end": 42.3, "text": "Cracking down on crime.", "words": [{"w": " Cracking", "s": 40.62, "e": 41.28}, {"w": " down", "s": 41.28, "e": 41.58}, {"w": " on", "s": 41.58, "e": 41.92}, {"w": " crime.", "s": 41.92, "e": 42.3}]}]