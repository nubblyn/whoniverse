[{"start": 7.09, "end": 19.89, "text": "Long have I waited, imprisoned in this endless void, confined to oblivion.", "words": [{"w": " Long", "s": 7.09, "e": 7.87}, {"w": " have", "s": 7.87, "e": 8.55}, {"w": " I", "s": 8.55, "e": 9.23}, {"w": " waited,", "s": 9.23, "e": 10.23}, {"w": " imprisoned", "s": 10.67, "e": 11.95}, {"w": " in", "s": 11.95, "e": 13.09}, {"w": " this", "s": 13.09, "e": 13.43}, {"w": " endless", "s": 13.43, "e": 14.33}, {"w": " void,", "s": 14.33, "e": 14.99}, {"w": " confined", "s": 15.27, "e": 16.75}, {"w": " to", "s": 16.75, "e": 17.83}, {"w": " oblivion.", "s": 17.83, "e": 19.89}]}, {"start": 20.41, "end": 33.44, "text": "I am not defeated. The resurrection is near, as I have foreseen.", "words": [{"w": " I", "s": 20.41, "e": 20.59}, {"w": " am", "s": 23.34, "e": 23.72}, {"w": " not", "s": 23.72, "e": 24.1}, {"w": " defeated.", "s": 24.1, "e": 25.18}, {"w": " The", "s": 25.84, "e": 27.06}, {"w": " resurrection", "s": 27.06, "e": 27.86}, {"w": " is", "s": 27.86, "e": 29.12}, {"w": " near,", "s": 29.12, "e": 29.84}, {"w": " as", "s": 29.98, "e": 30.82}, {"w": " I", "s": 30.82, "e": 31.28}, {"w": " have", "s": 31.28, "e": 32.26}, {"w": " foreseen.", "s": 32.26, "e": 33.44}]}, {"start": 33.76, "end": 47.74, "text": "My children are returning to their ancestral home.", "words": [{"w": " My", "s": 33.76, "e": 34.12}, {"w": " children", "s": 43.56, "e": 44.12}, {"w": " are", "s": 44.12, "e": 44.56}, {"w": " returning", "s": 44.56, "e": 45.14}, {"w": " to", "s": 45.14, "e": 45.82}, {"w": " their", "s": 45.82, "e": 46.22}, {"w": " ancestral", "s": 46.22, "e": 46.86}, {"w": " home.", "s": 46.86, "e": 47.74}]}, {"start": 49.28, "end": 52.2, "text": "Returning to me.", "words": [{"w": " Returning", "s": 49.28, "e": 50.12}, {"w": " to", "s": 50.12, "e": 51.3}, {"w": " me.", "s": 51.3, "e": 52.2}]}, {"start": 52.72, "end": 57.95, "text": "For destinies are entwined.", "words": [{"w": " For", "s": 52.72, "e": 53.32}, {"w": " destinies", "s": 55.21, "e": 56.43}, {"w": " are", "s": 56.43, "e": 56.71}, {"w": " entwined.", "s": 56.71, "e": 57.95}]}, {"start": 58.79, "end": 64.09, "text": "Only through their creator can they achieve their full potential.", "words": [{"w": " Only", "s": 58.79, "e": 59.39}, {"w": " through", "s": 59.39, "e": 59.95}, {"w": " their", "s": 59.95, "e": 60.31}, {"w": " creator", "s": 60.31, "e": 60.99}, {"w": " can", "s": 60.99, "e": 61.83}, {"w": " they", "s": 61.83, "e": 62.07}, {"w": " achieve", "s": 62.07, "e": 62.63}, {"w": " their", "s": 62.63, "e": 62.97}, {"w": " full", "s": 62.97, "e": 63.31}, {"w": " potential.", "s": 63.31, "e": 64.09}]}, {"start": 64.87, "end": 71.37, "text": "Only with my help will they exterminate all opposition.", "words": [{"w": " Only", "s": 64.87, "e": 66.07}, {"w": " with", "s": 66.07, "e": 66.43}, {"w": " my", "s": 66.43, "e": 66.67}, {"w": " help", "s": 66.67, "e": 67.41}, {"w": " will", "s": 67.41, "e": 68.03}, {"w": " they", "s": 68.03, "e": 68.31}, {"w": " exterminate", "s": 68.31, "e": 69.87}, {"w": " all", "s": 69.87, "e": 70.47}, {"w": " opposition.", "s": 70.47, "e": 71.37}]}, {"start": 73.17, "end": 79.65, "text": "Only with Davros as their emperor will the Daleks take their rightful place", "words": [{"w": " Only", "s": 73.17, "e": 73.83}, {"w": " with", "s": 73.83, "e": 74.31}, {"w": " Davros", "s": 74.31, "e": 74.97}, {"w": " as", "s": 74.97, "e": 75.59}, {"w": " their", "s": 75.59, "e": 75.87}, {"w": " emperor", "s": 75.87, "e": 76.35}, {"w": " will", "s": 76.35, "e": 77.23}, {"w": " the", "s": 77.23, "e": 77.39}, {"w": " Daleks", "s": 77.39, "e": 77.99}, {"w": " take", "s": 77.99, "e": 78.31}, {"w": " their", "s": 78.31, "e": 78.65}, {"w": " rightful", "s": 78.65, "e": 79.33}, {"w": " place", "s": 79.33, "e": 79.65}]}, {"start": 79.65, "end": 83.85, "text": "as the supreme power of the universe!", "words": [{"w": " as", "s": 79.65, "e": 80.53}, {"w": " the", "s": 80.53, "e": 80.73}, {"w": " supreme", "s": 80.73, "e": 81.25}, {"w": " power", "s": 81.25, "e": 81.99}, {"w": " of", "s": 81.99, "e": 83.01}, {"w": " the", "s": 83.01, "e": 83.27}, {"w": " universe!", "s": 83.27, "e": 83.85}]}]