[{"start": 8.22, "end": 9.52, "text": "Jo, are you sure about this?", "words": [{"w": " Jo,", "s": 8.22, "e": 8.72}, {"w": " are", "s": 8.74, "e": 8.82}, {"w": " you", "s": 8.82, "e": 8.86}, {"w": " sure", "s": 8.86, "e": 9.06}, {"w": " about", "s": 9.06, "e": 9.24}, {"w": " this?", "s": 9.24, "e": 9.52}]}, {"start": 9.8, "end": 11.2, "text": "Oh, stop worrying, Cliff.", "words": [{"w": " Oh,", "s": 9.8, "e": 10.14}, {"w": " stop", "s": 10.14, "e": 10.38}, {"w": " worrying,", "s": 10.38, "e": 10.84}, {"w": " Cliff.", "s": 10.92, "e": 11.2}]}, {"start": 12.4, "end": 13.6, "text": "It's going to be fine.", "words": [{"w": " It's", "s": 12.4, "e": 12.9}, {"w": " going", "s": 12.9, "e": 12.96}, {"w": " to", "s": 12.96, "e": 13.06}, {"w": " be", "s": 13.06, "e": 13.14}, {"w": " fine.", "s": 13.14, "e": 13.6}]}, {"start": 13.92, "end": 17.82, "text": "But if anything goes wrong, we haven't got the Doctor here to fix it for us.", "words": [{"w": " But", "s": 13.92, "e": 14.1}, {"w": " if", "s": 14.1, "e": 14.6}, {"w": " anything", "s": 14.6, "e": 14.86}, {"w": " goes", "s": 14.86, "e": 15.18}, {"w": " wrong,", "s": 15.18, "e": 15.56}, {"w": " we", "s": 15.64, "e": 15.82}, {"w": " haven't", "s": 15.82, "e": 16.12}, {"w": " got", "s": 16.12, "e": 16.24}, {"w": " the", "s": 16.24, "e": 16.36}, {"w": " Doctor", "s": 16.36, "e": 16.62}, {"w": " here", "s": 16.62, "e": 16.86}, {"w": " to", "s": 16.86, "e": 16.96}, {"w": " fix", "s": 16.96, "e": 17.22}, {"w": " it", "s": 17.22, "e": 17.38}, {"w": " for", "s": 17.38, "e": 17.66}, {"w": " us.", "s": 17.66, "e": 17.82}]}, {"start": 18.1, "end": 22.56, "text": "Well, technically, the Doctor didn't fix it last time.", "words": [{"w": " Well,", "s": 18.1, "e": 18.46}, {"w": " technically,", "s": 18.64, "e": 19.74}, {"w": " the", "s": 20.12, "e": 20.92}, {"w": " Doctor", "s": 20.92, "e": 21.22}, {"w": " didn't", "s": 21.22, "e": 21.58}, {"w": " fix", "s": 21.58, "e": 21.86}, {"w": " it", "s": 21.86, "e": 21.96}, {"w": " last", "s": 21.96, "e": 22.2}, {"w": " time.", "s": 22.2, "e": 22.56}]}, {"start": 23.3, "end": 24.04, "text": "I did.", "words": [{"w": " I", "s": 23.3, "e": 23.8}, {"w": " did.", "s": 23.8, "e": 24.04}]}, {"start": 26.94, "end": 28.48, "text": "Bring the gear, will you, darling?", "words": [{"w": " Bring", "s": 26.94, "e": 27.44}, {"w": " the", "s": 27.44, "e": 27.72}, {"w": " gear,", "s": 27.72, "e": 27.92}, {"w": " will", "s": 27.98, "e": 28.1}, {"w": " you,", "s": 28.1, "e": 28.22}, {"w": " darling?", "s": 28.24, "e": 28.48}]}, {"start": 42.879999999999995, "end": 43.78, "text": "Right then.", "words": [{"w": " Right", "s": 42.879999999999995, "e": 43.48}, {"w": " then.", "s": 43.48, "e": 43.78}]}, {"start": 45.02, "end": 46.5, "text": "This one's for the Doctor.", "words": [{"w": " This", "s": 45.02, "e": 45.62}, {"w": " one's", "s": 45.62, "e": 45.92}, {"w": " for", "s": 45.92, "e": 46.02}, {"w": " the", "s": 46.02, "e": 46.2}, {"w": " Doctor.", "s": 46.2, "e": 46.5}]}, {"start": 57.22, "end": 58.42, "text": "Hello, boys.", "words": [{"w": " Hello,", "s": 57.22, "e": 57.82}, {"w": " boys.", "s": 57.82, "e": 58.42}]}]