[{"start": 16.91, "end": 25.83, "text": "Once upon a time, I was lost, stranded on a distant, dangerous world.", "words": [{"w": " Once", "s": 16.91, "e": 17.01}, {"w": " upon", "s": 17.01, "e": 17.27}, {"w": " a", "s": 17.27, "e": 17.47}, {"w": " time,", "s": 17.47, "e": 17.77}, {"w": " I", "s": 17.97, "e": 19.45}, {"w": " was", "s": 19.45, "e": 19.69}, {"w": " lost,", "s": 19.69, "e": 20.19}, {"w": " stranded", "s": 22.61, "e": 23.41}, {"w": " on", "s": 23.41, "e": 23.83}, {"w": " a", "s": 23.83, "e": 23.93}, {"w": " distant,", "s": 23.93, "e": 24.47}, {"w": " dangerous", "s": 24.59, "e": 25.21}, {"w": " world.", "s": 25.21, "e": 25.83}]}, {"start": 27.54, "end": 31.48, "text": "An orphan with no hope of rescue.", "words": [{"w": " An", "s": 27.54, "e": 28.26}, {"w": " orphan", "s": 28.26, "e": 28.62}, {"w": " with", "s": 28.62, "e": 29.98}, {"w": " no", "s": 29.98, "e": 30.3}, {"w": " hope", "s": 30.3, "e": 30.9}, {"w": " of", "s": 30.9, "e": 31.12}, {"w": " rescue.", "s": 31.12, "e": 31.48}]}, {"start": 31.66, "end": 48.46, "text": "In the most unlikely of places, inside a battered old police box, I found a home and a family.", "words": [{"w": " In", "s": 31.66, "e": 32.34}, {"w": " the", "s": 38.9, "e": 39.02}, {"w": " most", "s": 39.02, "e": 39.3}, {"w": " unlikely", "s": 39.3, "e": 39.92}, {"w": " of", "s": 39.92, "e": 40.4}, {"w": " places,", "s": 40.4, "e": 40.78}, {"w": " inside", "s": 41.02, "e": 42.34}, {"w": " a", "s": 42.34, "e": 42.76}, {"w": " battered", "s": 42.76, "e": 43.46}, {"w": " old", "s": 43.46, "e": 43.68}, {"w": " police", "s": 43.68, "e": 44.24}, {"w": " box,", "s": 44.24, "e": 44.62}, {"w": " I", "s": 44.96, "e": 45.76}, {"w": " found", "s": 45.76, "e": 46.06}, {"w": " a", "s": 46.06, "e": 46.22}, {"w": " home", "s": 46.22, "e": 46.52}, {"w": " and", "s": 46.52, "e": 48.0}, {"w": " a", "s": 48.0, "e": 48.08}, {"w": " family.", "s": 48.08, "e": 48.46}]}, {"start": 48.94, "end": 55.9, "text": "There was Ian, dashing and smart and heroic.", "words": [{"w": " There", "s": 48.94, "e": 49.66}, {"w": " was", "s": 52.86, "e": 53.12}, {"w": " Ian,", "s": 53.12, "e": 53.46}, {"w": " dashing", "s": 53.64, "e": 54.54}, {"w": " and", "s": 54.54, "e": 54.72}, {"w": " smart", "s": 54.72, "e": 55.1}, {"w": " and", "s": 55.1, "e": 55.52}, {"w": " heroic.", "s": 55.52, "e": 55.9}]}, {"start": 55.9, "end": 59.74, "text": "Barbara, brave and determined.", "words": [{"w": " Barbara,", "s": 55.9, "e": 57.3}, {"w": " brave", "s": 57.86, "e": 58.68}, {"w": " and", "s": 58.68, "e": 59.08}, {"w": " determined.", "s": 59.08, "e": 59.74}]}, {"start": 62.14, "end": 64.3, "text": "Steven, intrepid and curious.", "words": [{"w": " Steven,", "s": 62.14, "e": 62.92}, {"w": " intrepid", "s": 62.92, "e": 63.7}, {"w": " and", "s": 63.7, "e": 63.88}, {"w": " curious.", "s": 63.88, "e": 64.3}]}, {"start": 65.96, "end": 71.66, "text": "And then there was the Doctor, the wisest man I ever met.", "words": [{"w": " And", "s": 65.96, "e": 66.74}, {"w": " then", "s": 66.74, "e": 67.18}, {"w": " there", "s": 67.18, "e": 67.32}, {"w": " was", "s": 67.32, "e": 67.54}, {"w": " the", "s": 67.54, "e": 67.66}, {"w": " Doctor,", "s": 67.66, "e": 68.0}, {"w": " the", "s": 68.14, "e": 68.68}, {"w": " wisest", "s": 69.96, "e": 70.62}, {"w": " man", "s": 70.62, "e": 70.94}, {"w": " I", "s": 70.94, "e": 71.24}, {"w": " ever", "s": 71.24, "e": 71.42}, {"w": " met.", "s": 71.42, "e": 71.66}]}, {"start": 71.9, "end": 74.92, "text": "Whose eyes sparkled like the night sky.", "words": [{"w": " Whose", "s": 71.9, "e": 72.58}, {"w": " eyes", "s": 72.58, "e": 72.96}, {"w": " sparkled", "s": 72.96, "e": 73.98}, {"w": " like", "s": 73.98, "e": 74.2}, {"w": " the", "s": 74.2, "e": 74.4}, {"w": " night", "s": 74.4, "e": 74.58}, {"w": " sky.", "s": 74.58, "e": 74.92}]}, {"start": 75.62, "end": 78.5, "text": "Whose temper burned like the sun.", "words": [{"w": " Whose", "s": 75.62, "e": 76.4}, {"w": " temper", "s": 76.4, "e": 76.94}, {"w": " burned", "s": 76.94, "e": 77.66}, {"w": " like", "s": 77.66, "e": 78.0}, {"w": " the", "s": 78.0, "e": 78.24}, {"w": " sun.", "s": 78.24, "e": 78.5}]}, {"start": 79.38, "end": 85.26, "text": "Our travels took us across the universe to fantastic worlds.", "words": [{"w": " Our", "s": 79.38, "e": 80.16}, {"w": " travels", "s": 80.16, "e": 80.76}, {"w": " took", "s": 80.76, "e": 81.12}, {"w": " us", "s": 81.12, "e": 81.36}, {"w": " across", "s": 81.36, "e": 81.66}, {"w": " the", "s": 81.66, "e": 82.02}, {"w": " universe", "s": 82.02, "e": 82.56}, {"w": " to", "s": 82.56, "e": 83.72}, {"w": " fantastic", "s": 83.72, "e": 84.22}, {"w": " worlds.", "s": 84.22, "e": 85.26}]}, {"start": 85.64, "end": 86.72, "text": "Doctor, look!", "words": [{"w": " Doctor,", "s": 85.64, "e": 86.24}, {"w": " look!", "s": 86.3, "e": 86.72}]}, {"start": 87.18, "end": 88.96, "text": "And miraculous civilizations.", "words": [{"w": " And", "s": 87.18, "e": 87.44}, {"w": " miraculous", "s": 87.44, "e": 87.88}, {"w": " civilizations.", "s": 87.88, "e": 88.96}]}, {"start": 91.14, "end": 93.76, "text": "We can travel anywhere and everywhere.", "words": [{"w": " We", "s": 91.14, "e": 91.56}, {"w": " can", "s": 91.56, "e": 91.76}, {"w": " travel", "s": 91.76, "e": 92.16}, {"w": " anywhere", "s": 92.16, "e": 92.6}, {"w": " and", "s": 92.6, "e": 93.18}, {"w": " everywhere.", "s": 93.18, "e": 93.76}]}, {"start": 94.28, "end": 96.02, "text": "The distant past.", "words": [{"w": " The", "s": 94.28, "e": 95.08}, {"w": " distant", "s": 95.08, "e": 95.54}, {"w": " past.", "s": 95.54, "e": 96.02}]}, {"start": 100.67, "end": 102.23, "text": "And the far future.", "words": [{"w": " And", "s": 100.67, "e": 101.09}, {"w": " the", "s": 101.09, "e": 101.25}, {"w": " far", "s": 101.25, "e": 101.59}, {"w": " future.", "s": 101.59, "e": 102.23}]}, {"start": 105.42, "end": 108.1, "text": "Joining those who fought for freedom.", "words": [{"w": " Joining", "s": 105.42, "e": 106.26}, {"w": " those", "s": 106.26, "e": 106.66}, {"w": " who", "s": 106.66, "e": 107.0}, {"w": " fought", "s": 107.0, "e": 107.3}, {"w": " for", "s": 107.3, "e": 107.6}, {"w": " freedom.", "s": 107.6, "e": 108.1}]}, {"start": 112.81, "end": 115.17, "text": "Battling those who spread terror.", "words": [{"w": " Battling", "s": 112.81, "e": 113.65}, {"w": " those", "s": 113.65, "e": 113.93}, {"w": " who", "s": 113.93, "e": 114.19}, {"w": " spread", "s": 114.19, "e": 114.61}, {"w": " terror.", "s": 114.61, "e": 115.17}]}, {"start": 118.79, "end": 122.23, "text": "Each adventure made me who I am.", "words": [{"w": " Each", "s": 118.79, "e": 119.63}, {"w": " adventure", "s": 119.63, "e": 120.23}, {"w": " made", "s": 120.23, "e": 121.23}, {"w": " me", "s": 121.23, "e": 121.55}, {"w": " who", "s": 121.55, "e": 121.81}, {"w": " I", "s": 121.81, "e": 121.99}, {"w": " am.", "s": 121.99, "e": 122.23}]}, {"start": 124.74, "end": 129.8, "text": "And eventually, brought me here.", "words": [{"w": " And", "s": 124.74, "e": 125.46}, {"w": " eventually,", "s": 125.46, "e": 125.9}, {"w": " brought", "s": 126.02, "e": 126.8}, {"w": " me", "s": 129.14, "e": 129.48}, {"w": " here.", "s": 129.48, "e": 129.8}]}, {"start": 135.2, "end": 136.74, "text": "To my new family.", "words": [{"w": " To", "s": 135.2, "e": 135.62}, {"w": " my", "s": 135.62, "e": 135.78}, {"w": " new", "s": 135.78, "e": 136.22}, {"w": " family.", "s": 136.22, "e": 136.74}]}, {"start": 138.12, "end": 141.06, "text": "In the end, our lives become stories.", "words": [{"w": " In", "s": 138.12, "e": 138.78}, {"w": " the", "s": 138.78, "e": 138.94}, {"w": " end,", "s": 138.94, "e": 139.2}, {"w": " our", "s": 139.28, "e": 139.44}, {"w": " lives", "s": 139.44, "e": 139.96}, {"w": " become", "s": 139.96, "e": 140.34}, {"w": " stories.", "s": 140.34, "e": 141.06}]}, {"start": 142.56, "end": 149.08, "text": "And in the telling of those stories in verse or song or sculpture, we keep them alive.", "words": [{"w": " And", "s": 142.56, "e": 143.22}, {"w": " in", "s": 143.22, "e": 143.36}, {"w": " the", "s": 143.36, "e": 143.44}, {"w": " telling", "s": 143.44, "e": 143.78}, {"w": " of", "s": 143.78, "e": 143.92}, {"w": " those", "s": 143.92, "e": 144.12}, {"w": " stories", "s": 144.12, "e": 144.62}, {"w": " in", "s": 144.62, "e": 144.88}, {"w": " verse", "s": 144.88, "e": 145.22}, {"w": " or", "s": 145.22, "e": 145.68}, {"w": " song", "s": 145.68, "e": 146.34}, {"w": " or", "s": 146.34, "e": 146.56}, {"w": " sculpture,", "s": 146.56, "e": 147.28}, {"w": " we", "s": 147.62, "e": 148.32}, {"w": " keep", "s": 148.32, "e": 148.56}, {"w": " them", "s": 148.56, "e": 148.78}, {"w": " alive.", "s": 148.78, "e": 149.08}]}, {"start": 149.94, "end": 152.56, "text": "And good stories should live forever.", "words": [{"w": " And", "s": 149.94, "e": 150.6}, {"w": " good", "s": 150.6, "e": 150.92}, {"w": " stories", "s": 150.92, "e": 151.6}, {"w": " should", "s": 151.6, "e": 151.86}, {"w": " live", "s": 151.86, "e": 152.14}, {"w": " forever.", "s": 152.14, "e": 152.56}]}, {"start": 153.98, "end": 155.46, "text": "Tell me another one.", "words": [{"w": " Tell", "s": 153.98, "e": 154.64}, {"w": " me", "s": 154.64, "e": 154.84}, {"w": " another", "s": 154.84, "e": 155.1}, {"w": " one.", "s": 155.1, "e": 155.46}]}, {"start": 156.44, "end": 160.08, "text": "Your mother used to get tired of my stories when she was your age.", "words": [{"w": " Your", "s": 156.44, "e": 157.1}, {"w": " mother", "s": 157.1, "e": 157.44}, {"w": " used", "s": 157.44, "e": 157.62}, {"w": " to", "s": 157.62, "e": 157.82}, {"w": " get", "s": 157.82, "e": 157.92}, {"w": " tired", "s": 157.92, "e": 158.36}, {"w": " of", "s": 158.36, "e": 158.5}, {"w": " my", "s": 158.5, "e": 158.62}, {"w": " stories", "s": 158.62, "e": 159.04}, {"w": " when", "s": 159.04, "e": 159.26}, {"w": " she", "s": 159.26, "e": 159.42}, {"w": " was", "s": 159.42, "e": 159.56}, {"w": " your", "s": 159.56, "e": 159.74}, {"w": " age.", "s": 159.74, "e": 160.08}]}, {"start": 160.36, "end": 161.32, "text": "I don't.", "words": [{"w": " I", "s": 160.36, "e": 160.9}, {"w": " don't.", "s": 160.9, "e": 161.32}]}, {"start": 161.72, "end": 164.84, "text": "No, you don't.", "words": [{"w": " No,", "s": 161.72, "e": 162.38}, {"w": " you", "s": 162.62, "e": 164.02}, {"w": " don't.", "s": 164.02, "e": 164.84}]}, {"start": 164.84, "end": 171.45, "text": "Which one would you like?", "words": [{"w": " Which", "s": 164.84, "e": 165.54}, {"w": " one", "s": 170.59, "e": 170.87}, {"w": " would", "s": 170.87, "e": 171.05}, {"w": " you", "s": 171.05, "e": 171.17}, {"w": " like?", "s": 171.17, "e": 171.45}]}, {"start": 172.11, "end": 173.21, "text": "The Daleks.", "words": [{"w": " The", "s": 172.11, "e": 172.75}, {"w": " Daleks.", "s": 172.75, "e": 173.21}]}, {"start": 173.63, "end": 174.27, "text": "Again?", "words": [{"w": " Again?", "s": 173.63, "e": 174.27}]}, {"start": 174.77, "end": 177.21, "text": "Tell me about Dracula and the Daleks.", "words": [{"w": " Tell", "s": 174.77, "e": 175.13}, {"w": " me", "s": 175.13, "e": 175.31}, {"w": " about", "s": 175.31, "e": 175.59}, {"w": " Dracula", "s": 175.59, "e": 175.91}, {"w": " and", "s": 175.91, "e": 176.45}, {"w": " the", "s": 176.45, "e": 176.59}, {"w": " Daleks.", "s": 176.59, "e": 177.21}]}, {"start": 177.57, "end": 178.21, "text": "All right, then.", "words": [{"w": " All", "s": 177.57, "e": 177.79}, {"w": " right,", "s": 177.79, "e": 178.03}, {"w": " then.", "s": 178.03, "e": 178.21}]}, {"start": 178.71, "end": 179.81, "text": "Do the voice.", "words": [{"w": " Do", "s": 178.71, "e": 179.35}, {"w": " the", "s": 179.35, "e": 179.49}, {"w": " voice.", "s": 179.49, "e": 179.81}]}, {"start": 180.03, "end": 180.75, "text": "Do the voice.", "words": [{"w": " Do", "s": 180.03, "e": 180.27}, {"w": " the", "s": 180.27, "e": 180.35}, {"w": " voice.", "s": 180.35, "e": 180.75}]}, {"start": 183.93, "end": 184.57, "text": "Exterminate.", "words": [{"w": " Exterminate.", "s": 183.93, "e": 184.57}]}, {"start": 186.97, "end": 187.61, "text": "Exterminate.", "words": [{"w": " Exterminate.", "s": 186.97, "e": 187.61}]}]