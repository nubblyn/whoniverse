[{"start": 4.94, "end": 8.52, "text": "Welcome to New Earth. Let us cure you.", "words": [{"w": " Welcome", "s": 4.94, "e": 5.52}, {"w": " to", "s": 5.52, "e": 5.8}, {"w": " New", "s": 5.8, "e": 6.04}, {"w": " Earth.", "s": 6.04, "e": 6.42}, {"w": " Let", "s": 6.84, "e": 7.6}, {"w": " us", "s": 7.6, "e": 7.8}, {"w": " cure", "s": 7.8, "e": 8.14}, {"w": " you.", "s": 8.14, "e": 8.52}]}, {"start": 8.7, "end": 10.66, "text": "We can cure anything.", "words": [{"w": " We", "s": 8.7, "e": 9.28}, {"w": " can", "s": 9.28, "e": 9.5}, {"w": " cure", "s": 9.5, "e": 9.88}, {"w": " anything.", "s": 9.88, "e": 10.66}]}, {"start": 15.6, "end": 18.58, "text": "Portrait syndrome. Terminal.", "words": [{"w": " Portrait", "s": 15.6, "e": 16.36}, {"w": " syndrome.", "s": 16.36, "e": 16.78}, {"w": " Terminal.", "s": 17.82, "e": 18.58}]}, {"start": 21.82, "end": 25.66, "text": "Wrong. We never lose a patient.", "words": [{"w": " Wrong.", "s": 21.82, "e": 22.58}, {"w": " We", "s": 23.22, "e": 23.98}, {"w": " never", "s": 23.98, "e": 24.54}, {"w": " lose", "s": 24.54, "e": 25.02}, {"w": " a", "s": 25.02, "e": 25.22}, {"w": " patient.", "s": 25.22, "e": 25.66}]}, {"start": 26.58, "end": 29.64, "text": "We're here to help you. Donations welcome.", "words": [{"w": " We're", "s": 26.58, "e": 26.96}, {"w": " here", "s": 26.96, "e": 27.08}, {"w": " to", "s": 27.08, "e": 27.26}, {"w": " help", "s": 27.26, "e": 27.56}, {"w": " you.", "s": 27.56, "e": 27.88}, {"w": " Donations", "s": 28.52, "e": 29.28}, {"w": " welcome.", "s": 29.28, "e": 29.64}]}, {"start": 30.72, "end": 33.94, "text": "Come to New Earth and be cured.", "words": [{"w": " Come", "s": 30.72, "e": 31.1}, {"w": " to", "s": 31.1, "e": 31.38}, {"w": " New", "s": 31.38, "e": 31.64}, {"w": " Earth", "s": 31.64, "e": 32.12}, {"w": " and", "s": 32.12, "e": 32.84}, {"w": " be", "s": 32.84, "e": 33.28}, {"w": " cured.", "s": 33.28, "e": 33.94}]}]