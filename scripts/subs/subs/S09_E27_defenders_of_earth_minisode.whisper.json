[{"start": 18.19, "end": 23.23, "text": "It's normal for you then. First date went well, next time I'll take them to a freezing Baton Fester cave.", "words": [{"w": " It's", "s": 18.19, "e": 18.41}, {"w": " normal", "s": 18.41, "e": 18.59}, {"w": " for", "s": 18.59, "e": 18.81}, {"w": " you", "s": 18.81, "e": 18.91}, {"w": " then.", "s": 18.91, "e": 19.11}, {"w": " First", "s": 20.17, "e": 20.57}, {"w": " date", "s": 20.57, "e": 20.77}, {"w": " went", "s": 20.77, "e": 20.87}, {"w": " well,", "s": 20.87, "e": 21.09}, {"w": " next", "s": 21.19, "e": 21.35}, {"w": " time", "s": 21.35, "e": 21.55}, {"w": " I'll", "s": 21.55, "e": 21.69}, {"w": " take", "s": 21.69, "e": 21.85}, {"w": " them", "s": 21.85, "e": 21.95}, {"w": " to", "s": 21.95, "e": 22.07}, {"w": " a", "s": 22.07, "e": 22.15}, {"w": " freezing", "s": 22.15, "e": 22.35}, {"w": " Baton", "s": 22.35, "e": 22.77}, {"w": " Fester", "s": 22.77, "e": 22.93}, {"w": " cave.", "s": 22.93, "e": 23.23}]}, {"start": 23.41, "end": 24.41, "text": "Oh no, there's no Baton Fester.", "words": [{"w": " Oh", "s": 23.41, "e": 23.49}, {"w": " no,", "s": 23.49, "e": 23.65}, {"w": " there's", "s": 23.71, "e": 23.87}, {"w": " no", "s": 23.87, "e": 23.99}, {"w": " Baton", "s": 23.99, "e": 24.39}, {"w": " Fester.", "s": 24.39, "e": 24.41}]}, {"start": 24.67, "end": 51.0, "text": "I wrote it in my profile. There's a difference. Profiles are fictional.", "words": [{"w": " I", "s": 24.67, "e": 25.07}, {"w": " wrote", "s": 47.66, "e": 47.92}, {"w": " it", "s": 47.92, "e": 48.06}, {"w": " in", "s": 48.06, "e": 48.16}, {"w": " my", "s": 48.16, "e": 48.2}, {"w": " profile.", "s": 48.2, "e": 48.58}, {"w": " There's", "s": 49.4, "e": 49.8}, {"w": " a", "s": 49.8, "e": 49.88}, {"w": " difference.", "s": 49.88, "e": 50.12}, {"w": " Profiles", "s": 50.28, "e": 50.62}, {"w": " are", "s": 50.62, "e": 50.72}, {"w": " fictional.", "s": 50.72, "e": 51.0}]}, {"start": 52.66, "end": 61.68, "text": "What was that? Oh my God, there's something alive in here.", "words": [{"w": " What", "s": 52.66, "e": 53.06}, {"w": " was", "s": 53.06, "e": 53.22}, {"w": " that?", "s": 53.22, "e": 53.32}, {"w": " Oh", "s": 53.52, "e": 53.92}, {"w": " my", "s": 60.58, "e": 60.66}, {"w": " God,", "s": 60.66, "e": 60.84}, {"w": " there's", "s": 60.88, "e": 61.0}, {"w": " something", "s": 61.0, "e": 61.12}, {"w": " alive", "s": 61.12, "e": 61.32}, {"w": " in", "s": 61.32, "e": 61.52}, {"w": " here.", "s": 61.52, "e": 61.68}]}, {"start": 81.01, "end": 83.93, "text": "Sonic lipstick. Just my colour.", "words": [{"w": " Sonic", "s": 81.01, "e": 81.41}, {"w": " lipstick.", "s": 81.41, "e": 81.67}, {"w": " Just", "s": 82.91, "e": 83.31}, {"w": " my", "s": 83.31, "e": 83.51}, {"w": " colour.", "s": 83.51, "e": 83.93}]}, {"start": 85.03, "end": 86.81, "text": "Oh, thank you Sarah Jane.", "words": [{"w": " Oh,", "s": 85.03, "e": 85.43}, {"w": " thank", "s": 85.43, "e": 85.83}, {"w": " you", "s": 85.83, "e": 86.09}, {"w": " Sarah", "s": 86.09, "e": 86.43}, {"w": " Jane.", "s": 86.43, "e": 86.81}]}, {"start": 88.77, "end": 91.51, "text": "Well, hello. I'm Jo.", "words": [{"w": " Well,", "s": 88.77, "e": 89.17}, {"w": " hello.", "s": 89.17, "e": 89.57}, {"w": " I'm", "s": 90.95, "e": 91.35}, {"w": " Jo.", "s": 91.35, "e": 91.51}]}, {"start": 92.47, "end": 93.37, "text": "What the hell was that?", "words": [{"w": " What", "s": 92.47, "e": 92.87}, {"w": " the", "s": 92.87, "e": 92.99}, {"w": " hell", "s": 92.99, "e": 93.07}, {"w": " was", "s": 93.07, "e": 93.19}, {"w": " that?", "s": 93.19, "e": 93.37}]}, {"start": 93.37, "end": 100.18, "text": "These species. I've been tracking a colony just off the coast.", "words": [{"w": " These", "s": 93.37, "e": 94.17}, {"w": " species.", "s": 96.76, "e": 97.26}, {"w": " I've", "s": 97.64, "e": 98.08}, {"w": " been", "s": 98.08, "e": 98.2}, {"w": " tracking", "s": 98.2, "e": 98.48}, {"w": " a", "s": 98.48, "e": 98.7}, {"w": " colony", "s": 98.7, "e": 99.06}, {"w": " just", "s": 99.06, "e": 99.4}, {"w": " off", "s": 99.4, "e": 99.68}, {"w": " the", "s": 99.68, "e": 99.86}, {"w": " coast.", "s": 99.86, "e": 100.18}]}, {"start": 100.32, "end": 103.96, "text": "Now, he was defending his cave, which means...", "words": [{"w": " Now,", "s": 100.32, "e": 100.82}, {"w": " he", "s": 100.9, "e": 101.32}, {"w": " was", "s": 101.32, "e": 101.56}, {"w": " defending", "s": 101.56, "e": 101.94}, {"w": " his", "s": 101.94, "e": 102.32}, {"w": " cave,", "s": 102.32, "e": 102.7}, {"w": " which", "s": 102.94, "e": 103.6}, {"w": " means...", "s": 103.6, "e": 103.96}]}, {"start": 105.32, "end": 106.44, "text": "Come on you two.", "words": [{"w": " Come", "s": 105.32, "e": 105.96}, {"w": " on", "s": 105.96, "e": 106.1}, {"w": " you", "s": 106.1, "e": 106.24}, {"w": " two.", "s": 106.24, "e": 106.44}]}, {"start": 106.64, "end": 124.79, "text": "It changed sadly. It's affecting their hatching cycle.", "words": [{"w": " It", "s": 106.64, "e": 107.1}, {"w": " changed", "s": 121.57, "e": 121.85}, {"w": " sadly.", "s": 121.85, "e": 122.37}, {"w": " It's", "s": 122.59, "e": 123.21}, {"w": " affecting", "s": 123.21, "e": 123.53}, {"w": " their", "s": 123.53, "e": 123.85}, {"w": " hatching", "s": 123.85, "e": 124.33}, {"w": " cycle.", "s": 124.33, "e": 124.79}]}, {"start": 125.29, "end": 128.65, "text": "We're finding more and more of these nests on land.", "words": [{"w": " We're", "s": 125.29, "e": 125.61}, {"w": " finding", "s": 125.61, "e": 125.93}, {"w": " more", "s": 125.93, "e": 126.37}, {"w": " and", "s": 126.37, "e": 126.63}, {"w": " more", "s": 126.63, "e": 126.97}, {"w": " of", "s": 126.97, "e": 127.21}, {"w": " these", "s": 127.21, "e": 127.45}, {"w": " nests", "s": 127.45, "e": 128.01}, {"w": " on", "s": 128.01, "e": 128.25}, {"w": " land.", "s": 128.25, "e": 128.65}]}, {"start": 129.01, "end": 154.48, "text": "You two are beautiful.", "words": [{"w": " You", "s": 129.01, "e": 129.41}, {"w": " two", "s": 134.5, "e": 134.86}, {"w": " are", "s": 134.86, "e": 135.34}, {"w": " beautiful.", "s": 153.8, "e": 154.48}]}, {"start": 157.37, "end": 160.37, "text": "No, no, no, no, no. Stay in the moment.", "words": [{"w": " No,", "s": 157.37, "e": 158.01}, {"w": " no,", "s": 158.05, "e": 158.15}, {"w": " no,", "s": 158.17, "e": 158.29}, {"w": " no,", "s": 158.33, "e": 158.45}, {"w": " no.", "s": 158.47, "e": 158.63}, {"w": " Stay", "s": 159.01, "e": 159.65}, {"w": " in", "s": 159.65, "e": 159.89}, {"w": " the", "s": 159.89, "e": 159.99}, {"w": " moment.", "s": 159.99, "e": 160.37}]}, {"start": 161.09, "end": 164.59, "text": "Watching a Sea Devil hatch is privilege.", "words": [{"w": " Watching", "s": 161.09, "e": 161.73}, {"w": " a", "s": 161.73, "e": 161.99}, {"w": " Sea", "s": 161.99, "e": 162.29}, {"w": " Devil", "s": 162.29, "e": 162.67}, {"w": " hatch", "s": 162.67, "e": 163.13}, {"w": " is", "s": 163.13, "e": 163.45}, {"w": " privilege.", "s": 163.45, "e": 164.59}]}, {"start": 167.82, "end": 168.94, "text": "A Sea Devil?", "words": [{"w": " A", "s": 167.82, "e": 168.28}, {"w": " Sea", "s": 168.28, "e": 168.54}, {"w": " Devil?", "s": 168.54, "e": 168.94}]}, {"start": 169.56, "end": 171.2, "text": "How do you know all this stuff?", "words": [{"w": " How", "s": 169.56, "e": 170.2}, {"w": " do", "s": 170.2, "e": 170.38}, {"w": " you", "s": 170.38, "e": 170.5}, {"w": " know", "s": 170.5, "e": 170.62}, {"w": " all", "s": 170.62, "e": 170.78}, {"w": " this", "s": 170.78, "e": 170.92}, {"w": " stuff?", "s": 170.92, "e": 171.2}]}, {"start": 171.58, "end": 173.32, "text": "Oh, my darlings.", "words": [{"w": " Oh,", "s": 171.58, "e": 172.1}, {"w": " my", "s": 172.1, "e": 172.42}, {"w": " darlings.", "s": 172.42, "e": 173.32}]}, {"start": 175.14, "end": 176.92, "text": "The stories I...", "words": [{"w": " The", "s": 175.14, "e": 175.78}, {"w": " stories", "s": 175.78, "e": 176.42}, {"w": " I...", "s": 176.42, "e": 176.92}]}]