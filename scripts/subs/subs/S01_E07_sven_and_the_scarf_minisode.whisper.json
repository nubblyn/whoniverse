[{"start": 1.34, "end": 15.22, "text": "Sven here. Analysis time. A new arrival for the museum. The radiation signature indicates exposure to the space-time continuum for about seven years.", "words": [{"w": " Sven", "s": 1.34, "e": 2.22}, {"w": " here.", "s": 2.22, "e": 2.44}, {"w": " Analysis", "s": 2.68, "e": 3.56}, {"w": " time.", "s": 3.56, "e": 3.88}, {"w": " A", "s": 4.08, "e": 4.96}, {"w": " new", "s": 4.96, "e": 5.1}, {"w": " arrival", "s": 5.1, "e": 5.5}, {"w": " for", "s": 5.5, "e": 5.72}, {"w": " the", "s": 5.72, "e": 5.88}, {"w": " museum.", "s": 5.88, "e": 6.14}, {"w": " The", "s": 6.4, "e": 7.2}, {"w": " radiation", "s": 7.2, "e": 8.2}, {"w": " signature", "s": 8.2, "e": 8.78}, {"w": " indicates", "s": 8.78, "e": 9.62}, {"w": " exposure", "s": 9.62, "e": 10.58}, {"w": " to", "s": 10.58, "e": 11.08}, {"w": " the", "s": 11.08, "e": 11.26}, {"w": " space-time", "s": 11.26, "e": 11.98}, {"w": " continuum", "s": 11.98, "e": 12.8}, {"w": " for", "s": 12.8, "e": 13.24}, {"w": " about", "s": 13.24, "e": 14.34}, {"w": " seven", "s": 14.34, "e": 14.78}, {"w": " years.", "s": 14.78, "e": 15.22}]}, {"start": 16.02, "end": 19.02, "text": "Now, let us reveal its secrets.", "words": [{"w": " Now,", "s": 16.02, "e": 16.9}, {"w": " let", "s": 16.94, "e": 17.42}, {"w": " us", "s": 17.42, "e": 17.64}, {"w": " reveal", "s": 17.64, "e": 17.98}, {"w": " its", "s": 17.98, "e": 18.42}, {"w": " secrets.", "s": 18.42, "e": 19.02}]}, {"start": 50.08, "end": 57.22, "text": "Seven years in space. Could potentially be a haven for alien artefacts.", "words": [{"w": " Seven", "s": 50.08, "e": 50.74}, {"w": " years", "s": 50.74, "e": 51.36}, {"w": " in", "s": 51.36, "e": 51.92}, {"w": " space.", "s": 51.92, "e": 52.6}, {"w": " Could", "s": 53.04, "e": 53.58}, {"w": " potentially", "s": 53.58, "e": 54.1}, {"w": " be", "s": 54.1, "e": 54.46}, {"w": " a", "s": 54.46, "e": 54.78}, {"w": " haven", "s": 54.78, "e": 55.14}, {"w": " for", "s": 55.14, "e": 55.5}, {"w": " alien", "s": 55.5, "e": 56.38}, {"w": " artefacts.", "s": 56.38, "e": 57.22}]}, {"start": 57.22, "end": 70.86, "text": "First up, postulates a remnant of an alien grub-like organism or perhaps could even be bubble wrap.", "words": [{"w": " First", "s": 57.22, "e": 58.54}, {"w": " up,", "s": 58.54, "e": 59.04}, {"w": " postulates", "s": 59.26, "e": 60.26}, {"w": " a", "s": 60.26, "e": 60.64}, {"w": " remnant", "s": 60.64, "e": 61.8}, {"w": " of", "s": 61.8, "e": 62.16}, {"w": " an", "s": 62.16, "e": 62.54}, {"w": " alien", "s": 62.54, "e": 63.78}, {"w": " grub-like", "s": 63.78, "e": 65.06}, {"w": " organism", "s": 65.06, "e": 65.82}, {"w": " or", "s": 65.82, "e": 66.74}, {"w": " perhaps", "s": 66.74, "e": 67.62}, {"w": " could", "s": 67.62, "e": 68.06}, {"w": " even", "s": 68.06, "e": 68.5}, {"w": " be", "s": 68.5, "e": 68.76}, {"w": " bubble", "s": 68.76, "e": 70.6}, {"w": " wrap.", "s": 70.6, "e": 70.86}]}, {"start": 72.02, "end": 73.84, "text": "But I am an optimist.", "words": [{"w": " But", "s": 72.02, "e": 72.8}, {"w": " I", "s": 72.8, "e": 73.16}, {"w": " am", "s": 73.16, "e": 73.36}, {"w": " an", "s": 73.36, "e": 73.46}, {"w": " optimist.", "s": 73.46, "e": 73.84}]}, {"start": 74.08, "end": 83.39, "text": "Now we have one wire. No, two wires.", "words": [{"w": " Now", "s": 74.08, "e": 74.54}, {"w": " we", "s": 78.99, "e": 79.17}, {"w": " have", "s": 79.17, "e": 79.35}, {"w": " one", "s": 79.35, "e": 79.87}, {"w": " wire.", "s": 79.87, "e": 80.55}, {"w": " No,", "s": 81.05, "e": 81.83}, {"w": " two", "s": 81.93, "e": 82.85}, {"w": " wires.", "s": 82.85, "e": 83.39}]}, {"start": 83.91, "end": 89.45, "text": "I've got a funny feeling like I'm meddling. Do I have the right?", "words": [{"w": " I've", "s": 83.91, "e": 84.69}, {"w": " got", "s": 84.69, "e": 84.77}, {"w": " a", "s": 84.77, "e": 84.95}, {"w": " funny", "s": 84.95, "e": 85.29}, {"w": " feeling", "s": 85.29, "e": 85.73}, {"w": " like", "s": 85.73, "e": 86.13}, {"w": " I'm", "s": 86.13, "e": 86.91}, {"w": " meddling.", "s": 86.91, "e": 87.57}, {"w": " Do", "s": 87.71, "e": 88.47}, {"w": " I", "s": 88.47, "e": 88.71}, {"w": " have", "s": 88.71, "e": 89.09}, {"w": " the", "s": 89.09, "e": 89.25}, {"w": " right?", "s": 89.25, "e": 89.45}]}, {"start": 89.45, "end": 100.36, "text": "Now this looks like a pizza but not for eating. Definitely alien tech.", "words": [{"w": " Now", "s": 89.45, "e": 90.41}, {"w": " this", "s": 94.64, "e": 95.04}, {"w": " looks", "s": 95.04, "e": 95.64}, {"w": " like", "s": 95.64, "e": 96.16}, {"w": " a", "s": 96.16, "e": 96.32}, {"w": " pizza", "s": 96.32, "e": 96.68}, {"w": " but", "s": 96.68, "e": 97.36}, {"w": " not", "s": 97.36, "e": 97.94}, {"w": " for", "s": 97.94, "e": 98.22}, {"w": " eating.", "s": 98.22, "e": 98.52}, {"w": " Definitely", "s": 98.7, "e": 99.24}, {"w": " alien", "s": 99.24, "e": 100.04}, {"w": " tech.", "s": 100.04, "e": 100.36}]}, {"start": 100.58, "end": 102.26, "text": "If a little spongy.", "words": [{"w": " If", "s": 100.58, "e": 101.04}, {"w": " a", "s": 101.04, "e": 101.58}, {"w": " little", "s": 101.58, "e": 101.78}, {"w": " spongy.", "s": 101.78, "e": 102.26}]}, {"start": 105.52, "end": 111.36, "text": "Silicon paste life form. The remains of one. A knuckle perhaps?", "words": [{"w": " Silicon", "s": 105.52, "e": 106.28}, {"w": " paste", "s": 106.28, "e": 106.86}, {"w": " life", "s": 106.86, "e": 107.44}, {"w": " form.", "s": 107.44, "e": 108.0}, {"w": " The", "s": 108.26, "e": 108.9}, {"w": " remains", "s": 108.9, "e": 109.28}, {"w": " of", "s": 109.28, "e": 109.6}, {"w": " one.", "s": 109.6, "e": 109.88}, {"w": " A", "s": 110.06, "e": 110.78}, {"w": " knuckle", "s": 110.78, "e": 111.06}, {"w": " perhaps?", "s": 111.06, "e": 111.36}]}, {"start": 111.88, "end": 113.88, "text": "Who is Eldrad?", "words": [{"w": " Who", "s": 111.88, "e": 112.4}, {"w": " is", "s": 112.4, "e": 112.64}, {"w": " Eldrad?", "s": 112.64, "e": 113.88}]}, {"start": 115.26, "end": 119.48, "text": "I've been down here for too long. Eldrad must live.", "words": [{"w": " I've", "s": 115.26, "e": 116.02}, {"w": " been", "s": 116.02, "e": 116.12}, {"w": " down", "s": 116.12, "e": 116.28}, {"w": " here", "s": 116.28, "e": 116.46}, {"w": " for", "s": 116.46, "e": 116.66}, {"w": " too", "s": 116.66, "e": 116.86}, {"w": " long.", "s": 116.86, "e": 117.06}, {"w": " Eldrad", "s": 117.6, "e": 118.36}, {"w": " must", "s": 118.36, "e": 118.78}, {"w": " live.", "s": 118.78, "e": 119.48}]}, {"start": 120.38, "end": 125.72, "text": "Now you could be from a cactus. An alien cactus.", "words": [{"w": " Now", "s": 120.38, "e": 121.14}, {"w": " you", "s": 121.14, "e": 121.68}, {"w": " could", "s": 121.68, "e": 122.16}, {"w": " be", "s": 122.16, "e": 122.42}, {"w": " from", "s": 122.42, "e": 122.8}, {"w": " a", "s": 122.8, "e": 123.76}, {"w": " cactus.", "s": 123.76, "e": 124.18}, {"w": " An", "s": 124.38, "e": 125.0}, {"w": " alien", "s": 125.0, "e": 125.34}, {"w": " cactus.", "s": 125.34, "e": 125.72}]}, {"start": 125.72, "end": 130.24, "text": "Oh, close. That was almost a Meglos.", "words": [{"w": " Oh,", "s": 125.72, "e": 126.4}, {"w": " close.", "s": 126.52, "e": 127.44}, {"w": " That", "s": 128.34, "e": 129.06}, {"w": " was", "s": 129.06, "e": 129.24}, {"w": " almost", "s": 129.24, "e": 129.6}, {"w": " a", "s": 129.6, "e": 129.82}, {"w": " Meglos.", "s": 129.82, "e": 130.24}]}, {"start": 132.88, "end": 142.72, "text": "Hello. What have we here? Gelatinous mass. Tiny organism. What extraterrestrial life is this?", "words": [{"w": " Hello.", "s": 132.88, "e": 133.6}, {"w": " What", "s": 133.88, "e": 134.56}, {"w": " have", "s": 134.56, "e": 134.76}, {"w": " we", "s": 134.76, "e": 134.98}, {"w": " here?", "s": 134.98, "e": 135.3}, {"w": " Gelatinous", "s": 136.36, "e": 137.08}, {"w": " mass.", "s": 137.08, "e": 137.38}, {"w": " Tiny", "s": 137.78, "e": 138.5}, {"w": " organism.", "s": 138.5, "e": 139.12}, {"w": " What", "s": 139.62, "e": 140.2}, {"w": " extraterrestrial", "s": 140.2, "e": 141.44}, {"w": " life", "s": 141.44, "e": 141.92}, {"w": " is", "s": 141.92, "e": 142.36}, {"w": " this?", "s": 142.36, "e": 142.72}]}, {"start": 144.34, "end": 146.4, "text": "Oh, and it's a green one.", "words": [{"w": " Oh,", "s": 144.34, "e": 145.06}, {"w": " and", "s": 145.06, "e": 145.78}, {"w": " it's", "s": 145.78, "e": 146.02}, {"w": " a", "s": 146.02, "e": 146.02}, {"w": " green", "s": 146.02, "e": 146.16}, {"w": " one.", "s": 146.16, "e": 146.4}]}, {"start": 147.68, "end": 151.58, "text": "Right, that's it. More artefacts for the museum.", "words": [{"w": " Right,", "s": 147.68, "e": 148.4}, {"w": " that's", "s": 148.4, "e": 149.12}, {"w": " it.", "s": 149.12, "e": 149.28}, {"w": " More", "s": 149.38, "e": 149.78}, {"w": " artefacts", "s": 149.78, "e": 150.78}, {"w": " for", "s": 150.78, "e": 151.06}, {"w": " the", "s": 151.06, "e": 151.28}, {"w": " museum.", "s": 151.28, "e": 151.58}]}, {"start": 151.8, "end": 155.7, "text": "I've got to tidy up. Van Statten's got a new specimen arriving today.", "words": [{"w": " I've", "s": 151.8, "e": 152.14}, {"w": " got", "s": 152.14, "e": 152.2}, {"w": " to", "s": 152.2, "e": 152.34}, {"w": " tidy", "s": 152.34, "e": 152.68}, {"w": " up.", "s": 152.68, "e": 152.96}, {"w": " Van", "s": 153.18, "e": 153.56}, {"w": " Statten's", "s": 153.56, "e": 154.1}, {"w": " got", "s": 154.1, "e": 154.3}, {"w": " a", "s": 154.3, "e": 154.46}, {"w": " new", "s": 154.46, "e": 154.58}, {"w": " specimen", "s": 154.58, "e": 154.96}, {"w": " arriving", "s": 154.96, "e": 155.34}, {"w": " today.", "s": 155.34, "e": 155.7}]}, {"start": 156.22, "end": 157.4, "text": "Something metal.", "words": [{"w": " Something", "s": 156.22, "e": 156.94}, {"w": " metal.", "s": 156.94, "e": 157.4}]}, {"start": 157.7, "end": 159.34, "text": "Something alive.", "words": [{"w": " Something", "s": 157.7, "e": 158.32}, {"w": " alive.", "s": 158.32, "e": 159.34}]}, {"start": 159.66, "end": 164.38, "text": "And something tells me that this one's no jelly baby.", "words": [{"w": " And", "s": 159.66, "e": 160.48}, {"w": " something", "s": 160.48, "e": 160.92}, {"w": " tells", "s": 160.92, "e": 161.62}, {"w": " me", "s": 161.62, "e": 161.9}, {"w": " that", "s": 161.9, "e": 162.18}, {"w": " this", "s": 162.18, "e": 162.48}, {"w": " one's", "s": 162.48, "e": 162.94}, {"w": " no", "s": 162.94, "e": 163.28}, {"w": " jelly", "s": 163.28, "e": 164.08}, {"w": " baby.", "s": 164.08, "e": 164.38}]}, {"start": 171.49, "end": 173.43, "text": "Eldrad must live.", "words": [{"w": " Eldrad", "s": 171.49, "e": 172.31}, {"w": " must", "s": 172.31, "e": 172.73}, {"w": " live.", "s": 172.73, "e": 173.43}]}]