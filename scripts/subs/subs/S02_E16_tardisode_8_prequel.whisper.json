[{"start": 6.06, "end": 7.7, "text": "K-37, January 5.", "words": [{"w": " K", "s": 6.06, "e": 6.26}, {"w": "-37,", "s": 6.26, "e": 6.74}, {"w": " January", "s": 7.06, "e": 7.42}, {"w": " 5.", "s": 7.42, "e": 7.7}]}, {"start": 8.14, "end": 9.2, "text": "Flying through a black hole.", "words": [{"w": " Flying", "s": 8.14, "e": 8.64}, {"w": " through", "s": 8.64, "e": 8.76}, {"w": " a", "s": 8.76, "e": 8.86}, {"w": " black", "s": 8.86, "e": 9.02}, {"w": " hole.", "s": 9.02, "e": 9.2}]}, {"start": 9.36, "end": 12.36, "text": "Some power source keeps that planet hanging in there.", "words": [{"w": " Some", "s": 9.36, "e": 9.7}, {"w": " power", "s": 9.7, "e": 10.16}, {"w": " source", "s": 10.16, "e": 10.52}, {"w": " keeps", "s": 10.52, "e": 11.0}, {"w": " that", "s": 11.0, "e": 11.28}, {"w": " planet", "s": 11.28, "e": 11.66}, {"w": " hanging", "s": 11.66, "e": 11.96}, {"w": " in", "s": 11.96, "e": 12.2}, {"w": " there.", "s": 12.2, "e": 12.36}]}, {"start": 13.28, "end": 15.24, "text": "Bring it back, Captain Walker.", "words": [{"w": " Bring", "s": 13.28, "e": 13.82}, {"w": " it", "s": 13.82, "e": 13.96}, {"w": " back,", "s": 13.96, "e": 14.3}, {"w": " Captain", "s": 14.52, "e": 14.88}, {"w": " Walker.", "s": 14.88, "e": 15.24}]}, {"start": 15.9, "end": 17.8, "text": "You'd be the man who saved the Empire.", "words": [{"w": " You'd", "s": 15.9, "e": 16.44}, {"w": " be", "s": 16.44, "e": 16.52}, {"w": " the", "s": 16.52, "e": 16.62}, {"w": " man", "s": 16.62, "e": 16.84}, {"w": " who", "s": 16.84, "e": 17.06}, {"w": " saved", "s": 17.06, "e": 17.34}, {"w": " the", "s": 17.34, "e": 17.54}, {"w": " Empire.", "s": 17.54, "e": 17.8}]}, {"start": 19.0, "end": 20.22, "text": "How'd you find out about it?", "words": [{"w": " How'd", "s": 19.0, "e": 19.54}, {"w": " you", "s": 19.54, "e": 19.56}, {"w": " find", "s": 19.56, "e": 19.76}, {"w": " out", "s": 19.76, "e": 19.9}, {"w": " about", "s": 19.9, "e": 20.06}, {"w": " it?", "s": 20.06, "e": 20.22}]}, {"start": 21.6, "end": 24.44, "text": "This turned up in the effects of the Gethys expedition.", "words": [{"w": " This", "s": 21.6, "e": 22.14}, {"w": " turned", "s": 22.14, "e": 22.68}, {"w": " up", "s": 22.68, "e": 22.96}, {"w": " in", "s": 22.96, "e": 23.1}, {"w": " the", "s": 23.1, "e": 23.2}, {"w": " effects", "s": 23.2, "e": 23.44}, {"w": " of", "s": 23.44, "e": 23.68}, {"w": " the", "s": 23.68, "e": 23.78}, {"w": " Gethys", "s": 23.78, "e": 24.06}, {"w": " expedition.", "s": 24.06, "e": 24.44}]}, {"start": 24.9, "end": 26.0, "text": "The other side of the galaxy.", "words": [{"w": " The", "s": 24.9, "e": 25.36}, {"w": " other", "s": 25.36, "e": 25.46}, {"w": " side", "s": 25.46, "e": 25.62}, {"w": " of", "s": 25.62, "e": 25.72}, {"w": " the", "s": 25.72, "e": 25.76}, {"w": " galaxy.", "s": 25.76, "e": 26.0}]}, {"start": 26.56, "end": 29.54, "text": "All we have is the map and local myths.", "words": [{"w": " All", "s": 26.56, "e": 27.1}, {"w": " we", "s": 27.1, "e": 27.32}, {"w": " have", "s": 27.32, "e": 27.62}, {"w": " is", "s": 27.62, "e": 27.84}, {"w": " the", "s": 27.84, "e": 28.0}, {"w": " map", "s": 28.0, "e": 28.2}, {"w": " and", "s": 28.2, "e": 28.64}, {"w": " local", "s": 28.64, "e": 29.04}, {"w": " myths.", "s": 29.04, "e": 29.54}]}, {"start": 30.08, "end": 30.62, "text": "Myths?", "words": [{"w": " Myths?", "s": 30.08, "e": 30.62}]}, {"start": 30.64, "end": 31.92, "text": "It's superstition.", "words": [{"w": " It's", "s": 30.64, "e": 31.1}, {"w": " superstition.", "s": 31.1, "e": 31.92}]}, {"start": 31.92, "end": 36.78, "text": "And you are a big strong bloke flying a top ship with a top crew.", "words": [{"w": " And", "s": 31.92, "e": 32.92}, {"w": " you", "s": 32.92, "e": 33.3}, {"w": " are", "s": 33.3, "e": 33.56}, {"w": " a", "s": 33.56, "e": 33.74}, {"w": " big", "s": 33.74, "e": 33.9}, {"w": " strong", "s": 33.9, "e": 34.2}, {"w": " bloke", "s": 34.2, "e": 34.62}, {"w": " flying", "s": 34.62, "e": 34.86}, {"w": " a", "s": 34.86, "e": 35.02}, {"w": " top", "s": 35.02, "e": 35.2}, {"w": " ship", "s": 35.2, "e": 35.48}, {"w": " with", "s": 35.48, "e": 36.14}, {"w": " a", "s": 36.14, "e": 36.2}, {"w": " top", "s": 36.2, "e": 36.42}, {"w": " crew.", "s": 36.42, "e": 36.78}]}, {"start": 38.48, "end": 39.86, "text": "Good luck, Captain Walker.", "words": [{"w": " Good", "s": 38.48, "e": 39.0}, {"w": " luck,", "s": 39.0, "e": 39.24}, {"w": " Captain", "s": 39.26, "e": 39.56}, {"w": " Walker.", "s": 39.56, "e": 39.86}]}, {"start": 40.8, "end": 41.92, "text": "Get yourself ready.", "words": [{"w": " Get", "s": 40.8, "e": 41.32}, {"w": " yourself", "s": 41.32, "e": 41.56}, {"w": " ready.", "s": 41.56, "e": 41.92}]}, {"start": 42.36, "end": 44.68, "text": "The hearts of the Empire go with you.", "words": [{"w": " The", "s": 42.36, "e": 42.88}, {"w": " hearts", "s": 42.88, "e": 43.24}, {"w": " of", "s": 43.24, "e": 43.52}, {"w": " the", "s": 43.52, "e": 43.64}, {"w": " Empire", "s": 43.64, "e": 43.9}, {"w": " go", "s": 43.9, "e": 44.22}, {"w": " with", "s": 44.22, "e": 44.46}, {"w": " you.", "s": 44.46, "e": 44.68}]}, {"start": 44.9, "end": 49.49, "text": "And the beasts shall rise from the pit.", "words": [{"w": " And", "s": 44.9, "e": 45.26}, {"w": " the", "s": 47.79, "e": 47.87}, {"w": " beasts", "s": 47.87, "e": 48.15}, {"w": " shall", "s": 48.15, "e": 48.51}, {"w": " rise", "s": 48.51, "e": 48.81}, {"w": " from", "s": 48.81, "e": 49.09}, {"w": " the", "s": 49.09, "e": 49.27}, {"w": " pit.", "s": 49.27, "e": 49.49}]}, {"start": 49.69, "end": 50.15, "text": "Woo!", "words": [{"w": " Woo!", "s": 49.69, "e": 50.15}]}]