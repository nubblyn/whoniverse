[{"start": 15.95, "end": 17.93, "text": "Come on, Mickey, there's got to be something more than this.", "words": [{"w": " Come", "s": 15.95, "e": 16.29}, {"w": " on,", "s": 16.29, "e": 16.51}, {"w": " Mickey,", "s": 16.51, "e": 16.63}, {"w": " there's", "s": 16.77, "e": 16.91}, {"w": " got", "s": 16.91, "e": 16.97}, {"w": " to", "s": 16.97, "e": 17.07}, {"w": " be", "s": 17.07, "e": 17.13}, {"w": " something", "s": 17.13, "e": 17.33}, {"w": " more", "s": 17.33, "e": 17.57}, {"w": " than", "s": 17.57, "e": 17.69}, {"w": " this.", "s": 17.69, "e": 17.93}]}, {"start": 23.37, "end": 24.55, "text": "Which means I'm onto something.", "words": [{"w": " Which", "s": 23.37, "e": 23.77}, {"w": " means", "s": 23.77, "e": 23.95}, {"w": " I'm", "s": 23.95, "e": 24.15}, {"w": " onto", "s": 24.15, "e": 24.29}, {"w": " something.", "s": 24.29, "e": 24.55}]}, {"start": 27.59, "end": 27.99, "text": "Rose?", "words": [{"w": " Rose?", "s": 27.59, "e": 27.99}]}, {"start": 28.27, "end": 28.93, "text": "Rose, listen.", "words": [{"w": " Rose,", "s": 28.27, "e": 28.67}, {"w": " listen.", "s": 28.71, "e": 28.93}]}, {"start": 29.87, "end": 32.65, "text": "There's this school. Strange lights in the sky over it.", "words": [{"w": " There's", "s": 29.87, "e": 30.27}, {"w": " this", "s": 30.27, "e": 30.33}, {"w": " school.", "s": 30.33, "e": 30.59}, {"w": " Strange", "s": 31.15, "e": 31.55}, {"w": " lights", "s": 31.55, "e": 31.87}, {"w": " in", "s": 31.87, "e": 32.03}, {"w": " the", "s": 32.03, "e": 32.07}, {"w": " sky", "s": 32.07, "e": 32.29}, {"w": " over", "s": 32.29, "e": 32.51}, {"w": " it.", "s": 32.51, "e": 32.65}]}, {"start": 32.83, "end": 35.21, "text": "Anyway, there's some weird things going on, and you and the Doctor, well...", "words": [{"w": " Anyway,", "s": 32.83, "e": 33.23}, {"w": " there's", "s": 33.29, "e": 33.45}, {"w": " some", "s": 33.45, "e": 33.49}, {"w": " weird", "s": 33.49, "e": 33.69}, {"w": " things", "s": 33.69, "e": 33.85}, {"w": " going", "s": 33.85, "e": 34.05}