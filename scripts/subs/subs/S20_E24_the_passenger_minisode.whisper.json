[{"start": 10.16, "end": 135.95, "text": "It's impossible.", "words": [{"w": " It's", "s": 10.16, "e": 10.82}, {"w": " impossible.", "s": 135.65, "e": 135.95}]}, {"start": 140.08, "end": 141.2, "text": "Hello, Tegan.", "words": [{"w": " Hello,", "s": 140.08, "e": 140.74}, {"w": " Tegan.", "s": 140.82, "e": 141.2}]}, {"start": 145.08, "end": 145.74, "text": "Nyssa?", "words": [{"w": " Nyssa?", "s": 145.08, "e": 145.74}]}, {"start": 147.48, "end": 149.38, "text": "It's been a long time.", "words": [{"w": " It's", "s": 147.48, "e": 148.14}, {"w": " been", "s": 148.14, "e": 148.36}, {"w": " a", "s": 148.36, "e": 148.5}, {"w": " long", "s": 148.5, "e": 148.84}, {"w": " time.", "s": 148.84, "e": 149.38}]}, {"start": 152.11, "end": 152.77, "text": "Turlough.", "words": [{"w": " Turlough.", "s": 152.11, "e": 152.77}]}, {"start": 154.85, "end": 158.34, "text": "Oh, my God.", "words": [{"w": " Oh,", "s": 154.85, "e": 155.51}, {"w": " my", "s": 158.02, "e": 158.08}, {"w": " God.", "s": 158.08, "e": 158.34}]}, {"start": 158.5, "end": 159.46, "text": "Are you OK?", "words": [{"w": " Are", "s": 158.5, "e": 158.94}, {"w": " you", "s": 158.94, "e": 159.14}, {"w": " OK?", "s": 159.14, "e": 159.46}]}, {"start": 159.86, "end": 160.9, "text": "A little older.", "words": [{"w": " A", "s": 159.86, "e": 160.18}, {"w": " little", "s": 160.18, "e": 160.42}, {"w": " older.", "s": 160.42, "e": 160.9}]}, {"start": 162.06, "end": 163.3, "text": "Don't start me.", "words": [{"w": " Don't", "s": 162.06, "e": 162.72}, {"w": " start", "s": 162.72, "e": 162.86}, {"w": " me.", "s": 162.86, "e": 163.3}]}, {"start": 164.38, "end": 166.24, "text": "How did you contact me?", "words": [{"w": " How", "s": 164.38, "e": 165.04}, {"w": " did", "s": 165.04, "e": 165.24}, {"w": " you", "s": 165.24, "e": 165.42}, {"w": " contact", "s": 165.42, "e": 165.88}, {"w": " me?", "s": 165.88, "e": 166.24}]}, {"start": 167.26, "end": 168.92, "text": "What are you even doing here?", "words": [{"w": " What", "s": 167.26, "e": 167.78}, {"w": " are", "s": 167.78, "e": 167.96}, {"w": " you", "s": 167.96, "e": 168.06}, {"w": " even", "s": 168.06, "e": 168.3}, {"w": " doing", "s": 168.3, "e": 168.6}, {"w": " here?", "s": 168.6, "e": 168.92}]}, {"start": 169.18, "end": 170.64, "text": "Looking for you, of course.", "words": [{"w": " Looking", "s": 169.18, "e": 169.6}, {"w": " for", "s": 169.6, "e": 169.86}, {"w": " you,", "s": 169.86, "e": 170.14}, {"w": " of", "s": 170.18, "e": 170.36}, {"w": " course.", "s": 170.36, "e": 170.64}]}, {"start": 170.94, "end": 174.22, "text": "But we left you on Terminus.", "words": [{"w": " But", "s": 170.94, "e": 171.2}, {"w": " we", "s": 171.2, "e": 172.6}, {"w": " left", "s": 172.6, "e": 173.02}, {"w": " you", "s": 173.02, "e": 173.28}, {"w": " on", "s": 173.28, "e": 173.42}, {"w": " Terminus.", "s": 173.42, "e": 174.22}]}, {"start": 174.42, "end": 175.66, "text": "I hitched a ride.", "words": [{"w": " I", "s": 174.42, "e": 174.82}, {"w": " hitched", "s": 174.82, "e": 175.28}, {"w": " a", "s": 175.28, "e": 175.3}, {"w": " ride.", "s": 175.3, "e": 175.66}]}, {"start": 176.84, "end": 183.89, "text": "I've got so much to tell you.", "words": [{"w": " I've", "s": 176.84, "e": 177.36}, {"w": " got", "s": 182.55, "e": 182.67}, {"w": " so", "s": 182.67, "e": 182.95}, {"w": " much", "s": 182.95, "e": 183.21}, {"w": " to", "s": 183.21, "e": 183.45}, {"w": " tell", "s": 183.45, "e": 183.67}, {"w": " you.", "s": 183.67, "e": 183.89}]}, {"start": 184.27, "end": 186.23, "text": "The Doctor wants to see you too.", "words": [{"w": " The", "s": 184.27, "e": 184.79}, {"w": " Doctor", "s": 184.79, "e": 185.05}, {"w": " wants", "s": 185.05, "e": 185.27}, {"w": " to", "s": 185.27, "e": 185.53}, {"w": " see", "s": 185.53, "e": 185.73}, {"w": " you", "s": 185.73, "e": 185.93}, {"w": " too.", "s": 185.93, "e": 186.23}]}, {"start": 186.71, "end": 187.45, "text": "Which one?", "words": [{"w": " Which", "s": 186.71, "e": 187.23}, {"w": " one?", "s": 187.23, "e": 187.45}]}, {"start": 188.71, "end": 190.71, "text": "Scarf or celery or woman?", "words": [{"w": " Scarf", "s": 188.71, "e": 189.23}, {"w": " or", "s": 189.23, "e": 189.25}, {"w": " celery", "s": 189.25, "e": 189.65}, {"w": " or", "s": 189.65, "e": 190.29}, {"w": " woman?", "s": 190.29, "e": 190.71}]}, {"start": 191.35, "end": 192.33, "text": "Which do you think?", "words": [{"w": " Which", "s": 191.35, "e": 191.87}, {"w": " do", "s": 191.87, "e": 192.01}, {"w": " you", "s": 192.01, "e": 192.11}, {"w": " think?", "s": 192.11, "e": 192.33}]}, {"start": 193.57, "end": 195.91, "text": "Has he learned to fly that thing yet?", "words": [{"w": " Has", "s": 193.57, "e": 194.09}, {"w": " he", "s": 194.09, "e": 194.21}, {"w": " learned", "s": 194.21, "e": 194.47}, {"w": " to", "s": 194.47, "e": 194.65}, {"w": " fly", "s": 194.65, "e": 194.91}, {"w": " that", "s": 194.91, "e": 195.25}, {"w": " thing", "s": 195.25, "e": 195.57}, {"w": " yet?", "s": 195.57, "e": 195.91}]}, {"start": 197.07, "end": 199.63, "text": "I got my pilot's licence back in 93.", "words": [{"w": " I", "s": 197.07, "e": 197.59}, {"w": " got", "s": 197.59, "e": 197.81}, {"w": " my", "s": 197.81, "e": 197.97}, {"w": " pilot's", "s": 197.97, "e": 198.45}, {"w": " licence", "s": 198.45, "e": 198.63}, {"w": " back", "s": 198.63, "e": 199.07}, {"w": " in", "s": 199.07, "e": 199.27}, {"w": " 93.", "s": 199.27, "e": 199.63}]}, {"start": 199.85, "end": 201.21, "text": "I could teach him a thing or two.", "words": [{"w": " I", "s": 199.85, "e": 200.03}, {"w": " could", "s": 200.03, "e": 200.17}, {"w": " teach", "s": 200.17, "e": 200.39}, {"w": " him", "s": 200.39, "e": 200.59}, {"w": " a", "s": 200.59, "e": 200.67}, {"w": " thing", "s": 200.67, "e": 200.85}, {"w": " or", "s": 200.85, "e": 200.97}, {"w": " two.", "s": 200.97, "e": 201.21}]}, {"start": 202.55, "end": 203.93, "text": "I've missed this.", "words": [{"w": " I've", "s": 202.55, "e": 203.19}, {"w": " missed", "s": 203.19, "e": 203.51}, {"w": " this.", "s": 203.51, "e": 203.93}]}, {"start": 205.33, "end": 206.75, "text": "Those were the days.", "words": [{"w": " Those", "s": 205.33, "e": 205.97}, {"w": " were", "s": 205.97, "e": 206.19}, {"w": " the", "s": 206.19, "e": 206.35}, {"w": " days.", "s": 206.35, "e": 206.75}]}, {"start": 206.99, "end": 213.2, "text": "I kind of wish I'd realised how lucky I was.", "words": [{"w": " I", "s": 206.99, "e": 207.53}, {"w": " kind", "s": 210.66, "e": 210.92}, {"w": " of", "s": 210.92, "e": 211.1}, {"w": " wish", "s": 211.1, "e": 211.3}, {"w": " I'd", "s": 211.3, "e": 211.58}, {"w": " realised", "s": 211.58, "e": 211.98}, {"w": " how", "s": 211.98, "e": 212.32}, {"w": " lucky", "s": 212.32, "e": 212.68}, {"w": " I", "s": 212.68, "e": 212.9}, {"w": " was.", "s": 212.9, "e": 213.2}]}, {"start": 215.5, "end": 218.04, "text": "Well, now we've got a second chance.", "words": [{"w": " Well,", "s": 215.5, "e": 216.14}, {"w": " now", "s": 216.14, "e": 216.78}, {"w": " we've", "s": 216.78, "e": 217.06}, {"w": " got", "s": 217.06, "e": 217.18}, {"w": " a", "s": 217.18, "e": 217.32}, {"w": " second", "s": 217.32, "e": 217.56}, {"w": " chance.", "s": 217.56, "e": 218.04}]}, {"start": 219.3, "end": 220.52, "text": "If you're interested.", "words": [{"w": " If", "s": 219.3, "e": 219.94}, {"w": " you're", "s": 219.94, "e": 220.14}, {"w": " interested.", "s": 220.14, "e": 220.52}]}, {"start": 224.37, "end": 225.95, "text": "You bet I am.", "words": [{"w": " You", "s": 224.37, "e": 225.01}, {"w": " bet", "s": 225.01, "e": 225.33}, {"w": " I", "s": 225.33, "e": 225.59}, {"w": " am.", "s": 225.59, "e": 225.95}]}, {"start": 226.09, "end": 291.0, "text": "The trick.", "words": [{"w": " The", "s": 226.09, "e": 226.65}, {"w": " trick.", "s": 290.62, "e": 291.0}]}, {"start": 291.22, "end": 295.02, "text": "I wait in the darkest corners of your mind.", "words": [{"w": " I", "s": 291.22, "e": 291.7}, {"w": " wait", "s": 291.7, "e": 292.1}, {"w": " in", "s": 292.1, "e": 292.42}, {"w": " the", "s": 292.42, "e": 292.56}, {"w": " darkest", "s": 292.56, "e": 293.16}, {"w": " corners", "s": 293.16, "e": 293.8}, {"w": " of", "s": 293.8, "e": 294.18}, {"w": " your", "s": 294.18, "e": 294.4}, {"w": " mind.", "s": 294.4, "e": 295.02}]}, {"start": 296.26, "end": 298.32, "text": "Your greatest secret.", "words": [{"w": " Your", "s": 296.26, "e": 296.9}, {"w": " greatest", "s": 296.9, "e": 297.54}, {"w": " secret.", "s": 297.54, "e": 298.32}]}, {"start": 299.62, "end": 301.56, "text": "Even from The Doctor.", "words": [{"w": " Even", "s": 299.62, "e": 300.26}, {"w": " from", "s": 300.26, "e": 300.74}, {"w": " The", "s": 300.74, "e": 300.96}, {"w": " Doctor.", "s": 300.96, "e": 301.56}]}, {"start": 301.64, "end": 301.72, "text": "I'm sure you'll never forget.", "words": [{"w": " I'm", "s": 301.64, "e": 301.72}, {"w": " sure", "s": 301.72, "e": 301.72}, {"w": " you'll", "s": 301.72, "e": 301.72}, {"w": " never", "s": 301.72, "e": 301.72}, {"w": " forget.", "s": 301.72, "e": 301.72}]}, {"start": 302.68, "end": 306.04, "text": "You're one true companion.", "words": [{"w": " You're", "s": 302.68, "e": 303.16}, {"w": " one", "s": 303.16, "e": 303.5}, {"w": " true", "s": 303.5, "e": 304.76}, {"w": " companion.", "s": 304.76, "e": 306.04}]}, {"start": 307.42, "end": 308.48, "text": "That was cruel.", "words": [{"w": " That", "s": 307.42, "e": 307.9}, {"w": " was", "s": 307.9, "e": 308.16}, {"w": " cruel.", "s": 308.16, "e": 308.48}]}, {"start": 308.8, "end": 314.52, "text": "A tempting scenario in a universe of possibilities.", "words": [{"w": " A", "s": 308.8, "e": 309.32}, {"w": " tempting", "s": 309.32, "e": 309.86}, {"w": " scenario", "s": 309.86, "e": 310.74}, {"w": " in", "s": 310.74, "e": 312.16}, {"w": " a", "s": 312.16, "e": 312.26}, {"w": " universe", "s": 312.26, "e": 312.98}, {"w": " of", "s": 312.98, "e": 313.62}, {"w": " possibilities.", "s": 313.62, "e": 314.52}]}, {"start": 317.52, "end": 317.92, "text": "Ed.", "words": [{"w": " Ed.", "s": 317.52, "e": 317.92}]}, {"start": 318.96, "end": 322.08, "text": "Waking or dreaming, you cannot escape me.", "words": [{"w": " Waking", "s": 318.96, "e": 319.44}, {"w": " or", "s": 319.44, "e": 319.76}, {"w": " dreaming,", "s": 319.76, "e": 320.34}, {"w": " you", "s": 320.36, "e": 320.68}, {"w": " cannot", "s": 320.68, "e": 321.0}, {"w": " escape", "s": 321.0, "e": 321.52}, {"w": " me.", "s": 321.52, "e": 322.08}]}, {"start": 323.4, "end": 324.36, "text": "Submit.", "words": [{"w": " Submit.", "s": 323.4, "e": 324.36}]}, {"start": 324.96, "end": 329.16, "text": "And I will grant you the reunion you crave.", "words": [{"w": " And", "s": 324.96, "e": 325.44}, {"w": " I", "s": 325.44, "e": 325.88}, {"w": " will", "s": 325.88, "e": 326.3}, {"w": " grant", "s": 326.3, "e": 326.78}, {"w": " you", "s": 326.78, "e": 327.24}, {"w": " the", "s": 327.24, "e": 327.58}, {"w": " reunion", "s": 327.58, "e": 328.16}, {"w": " you", "s": 328.16, "e": 328.64}, {"w": " crave.", "s": 328.64, "e": 329.16}]}, {"start": 333.1, "end": 334.04, "text": "Join me.", "words": [{"w": " Join", "s": 333.1, "e": 333.74}, {"w": " me.", "s": 333.74, "e": 334.04}]}, {"start": 336.69, "end": 338.07, "text": "Take my hand.", "words": [{"w": " Take", "s": 336.69, "e": 337.17}, {"w": " my", "s": 337.17, "e": 337.55}, {"w": " hand.", "s": 337.55, "e": 338.07}]}, {"start": 338.07, "end": 341.99, "text": "And manifest your deepest desires.", "words": [{"w": " And", "s": 338.07, "e": 339.21}, {"w": " manifest", "s": 339.21, "e": 339.93}, {"w": " your", "s": 339.93, "e": 340.65}, {"w": " deepest", "s": 340.65, "e": 341.09}, {"w": " desires.", "s": 341.09, "e": 341.99}]}, {"start": 342.69, "end": 346.89, "text": "In another universe, we are together.", "words": [{"w": " In", "s": 342.69, "e": 343.57}, {"w": " another", "s": 344.95, "e": 345.29}, {"w": " universe,", "s": 345.29, "e": 345.87}, {"w": " we", "s": 345.95, "e": 346.29}, {"w": " are", "s": 346.29, "e": 346.39}, {"w": " together.", "s": 346.39, "e": 346.89}]}, {"start": 347.09, "end": 347.49, "text": "Tegan.", "words": [{"w": " Tegan.", "s": 347.09, "e": 347.49}]}, {"start": 348.03, "end": 349.67, "text": "Find me, Tegan.", "words": [{"w": " Find", "s": 348.03, "e": 348.91}, {"w": " me,", "s": 348.91, "e": 349.27}, {"w": " Tegan.", "s": 349.29, "e": 349.67}]}, {"start": 349.81, "end": 350.65, "text": "Tegan.", "words": [{"w": " Tegan.", "s": 349.81, "e": 350.65}]}, {"start": 350.89, "end": 351.95, "text": "Please find me.", "words": [{"w": " Please", "s": 350.89, "e": 351.35}, {"w": " find", "s": 351.35, "e": 351.71}, {"w": " me.", "s": 351.71, "e": 351.95}]}, {"start": 352.63, "end": 353.51, "text": "Tegan.", "words": [{"w": " Tegan.", "s": 352.63, "e": 353.51}]}, {"start": 353.81, "end": 354.69, "text": "Never.", "words": [{"w": " Never.", "s": 353.81, "e": 354.69}]}, {"start": 356.27, "end": 359.43, "text": "Then I will consume you.", "words": [{"w": " Then", "s": 356.27, "e": 356.71}, {"w": " I", "s": 356.71, "e": 357.33}, {"w": " will", "s": 357.33, "e": 357.97}, {"w": " consume", "s": 357.97, "e": 358.87}, {"w": " you.", "s": 358.87, "e": 359.43}]}]